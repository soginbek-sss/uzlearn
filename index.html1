["I live in Tashkent.","Men Toshkentda yashayman."],
["I get up at seven o'clock.","Men soat yettida turaman."],
["She works in a bank.","U bankda ishlaydi."],
["He doesn't like coffee.","U qahvani yoqtirmaydi."],
["Do you speak English?","Siz inglizcha gapirasizmi?"],
["I speak a little English.","Men ozgina inglizcha gapiraman."],
["There is a bank near here.","Yaqin atrofda bank bor."],
["There are three rooms in my flat.","Mening kvartiramda uchta xona bor."],
["The book is on the table.","Kitob stol ustida."],
["I am watching TV now.","Men hozir televizor ko'ryapman."],
["What are you doing?","Nima qilyapsiz?"],
["I can swim very well.","Men juda yaxshi suzaman."],
["I can't find my keys.","Men kalitlarimni topa olmayapman."],
["I bought a new phone.","Men yangi telefon sotib oldim."],
["Did you enjoy the film?","Film sizga yoqdimi?"],
["This city is bigger than my town.","Bu shahar mening shaharchamdan kattaroq."],
["You must wear a seat belt.","Siz xavfsizlik kamarini taqishingiz shart."],
["You should drink more water.","Ko'proq suv ichishingiz kerak."],
["I have lived here for five years.","Men bu yerda besh yildan beri yashayman."],
["I'm going to visit my grandmother.","Men buvimnikiga bormoqchiman."],
["I will help you with the bags.","Men sizga sumkalar bilan yordam beraman."],
["If it rains, we will stay at home.","Yomg'ir yog'sa, uyda qolamiz."],
["The room is cleaned every day.","Xona har kuni tozalanadi."],
["I have some questions.","Menda bir nechta savol bor."],
["I don't have any money.","Menda pul yo'q."],
["Can you call me later?","Menga keyinroq qo'ng'iroq qila olasizmi?"],
["I always drink tea in the morning.","Men ertalab doim choy ichaman."],
["I never eat fast food.","Men hech qachon fast-food yemayman."],
["My brother's room is very small.","Akamning xonasi juda kichik."],
["I used to play chess.","Men ilgari shaxmat o'ynardim."],
["I like reading books.","Men kitob o'qishni yaxshi ko'raman."],
["I want to learn English.","Men ingliz tilini o'rganmoqchiman."],
["She is too tired to work.","U ishlash uchun juda charchagan."],
["You are Ali, aren't you?","Siz Alisiz, shunday emasmi?"],
["I wish I had more time.","Qani endi vaqtim ko'proq bo'lsa."],
["If I were you, I would study more.","Sizning o'rningizda bo'lsam, ko'proq o'qirdim."],
["He must be at home now.","U hozir uyda bo'lsa kerak."],
["How do I get to the bus stop?","Avtobus bekatiga qanday boraman?"],
["Do you accept credit cards?","Kredit kartalarni qabul qilasizmi?"],
["I would like a cup of tea, please.","Menga bir piyola choy bering, iltimos."],
["Wait a moment, please.","Bir lahza kuting, iltimos."],
["I am looking for a hotel.","Men mehmonxona qidiryapman."],
["Where can I buy a ticket?","Chiptani qayerdan sotib olsam bo'ladi?"],
["It is very hot today.","Bugun juda issiq."],
["Happy birthday!","Tug'ilgan kuningiz bilan!"],
["Good luck with your exam!","Imtihoningizda omad!"],
["Thank you for your help.","Yordamingiz uchun rahmat."],
["See you later.", "Ko'rishguncha."],
["Have a nice day.", "Yaxshi kun tilayman."],
["How are you doing?", "Ishlaringiz qalay?"],
["Take care.", "Ehtiyot bo'ling."],
["Good luck!", "Omad!"],
["No problem.", "Muammo yo'q."],
["Help yourself.", "Marhamat, o'zingiz oling."],
["Excuse me.", "Kechirasiz."],
["It's raining cats and dogs.", "Qattiq yomg'ir yog'yapti."],
["I'm looking forward to it.", "Intiqlik bilan kutaman."],
["Let me think about it.", "O'ylab ko'raman."],
["That's a piece of cake.", "Bu juda oson ekan."],
["I have a lot on my plate.", "Ishim juda ko'p."],
["Can you give me a hand?", "Menga yordam bera olasizmi?"],
["I'm running out of time.", "Vaqtim kam qolyapti."],
["Make yourself at home.", "O'zingizni uyda his qiling."],
["I'm not sure, but I'll give it a try.", "Ishonchim komil emas, lekin urinib ko'raman."],
["It's not worth the trouble.", "Bunga arzimaydi."],
["Hang in there.", "Chidang, tushkunlikka tushmang."],
["Let's call it a day.", "Bugunga yetarli, ishni to'xtatamiz."],
["I'm up to my ears in work.", "Ishga botib ketganman."],
["It slipped my mind.", "Esimdan chiqib ketdi."],
["She got cold feet.", "U jur'at qila olmadi."],
["Break a leg!", "Omad tilayman! (sahnadan oldin)"],
["To get the ball rolling, we need a plan.", "Ishni boshlash uchun reja kerak."],
["He's a fish out of water here.", "U bu yerda o'zini notanish his qiladi."],
["Let's cut to the chase.", "Gapning lubi-yu, asosiga o'tamiz."],
["It's a blessing in disguise.", "Bu yashirin baxt ekan."],
["We need to think outside the box.", "An'anaviy doiradan tashqariga chiqishimiz kerak."],
["Don't count your chickens before they hatch.", "Hali bo'lmagan ishga tayanib qolmang."],
["He spilled the beans.", "U sirni oshkor qilib yubordi."],
["It was the last straw.", "Bu chidab bo'lmas narsa bo'ldi."]
];

/* O'yin iboralari qaysi grammatika mavzusiga tegishli (inglizcha matn bo'yicha) */
const IBORA_MAVZU={
"Hello, my name is Ali.":6,"Where are you from?":12,"I am from Uzbekistan.":1,"How old are you?":12,"I am twenty years old.":1,
"What do you do?":12,"I am a student.":1,"How much is this?":5,"It is too expensive.":32,"Do you have a smaller size?":13,
"I will take it.":17,"Can I pay by card?":10,"Can I see the menu, please?":10,"This is delicious.":5,
"Excuse me, where is the station?":12,"Turn left at the corner.":8,"Is it far from here?":1,"How can I get to the airport?":12,
"Can you help me, please?":10,"I don't understand.":2,"Speak more slowly, please.":13,"What time is it?":12,"I am sorry, I am late.":1,
"Good morning! How are you?":1,"I am fine, thank you.":1,"What is your phone number?":12,"I live in Tashkent.":2,"I get up at seven o'clock.":24,"She works in a bank.":2,"He doesn't like coffee.":2,"Do you speak English?":12,"I speak a little English.":2,"There is a bank near here.":7,"There are three rooms in my flat.":7,"The book is on the table.":8,"I am watching TV now.":9,"What are you doing?":9,"I can swim very well.":10,"I can't find my keys.":10,"I bought a new phone.":11,"Did you enjoy the film?":12,"This city is bigger than my town.":13,"You must wear a seat belt.":15,"You should drink more water.":15,"I have lived here for five years.":16,"I'm going to visit my grandmother.":17,"I will help you with the bags.":17,"If it rains, we will stay at home.":18,"The room is cleaned every day.":19,"I have some questions.":21,"I don't have any money.":21,"Can you call me later?":22,"I always drink tea in the morning.":23,"I never eat fast food.":23,"My brother's room is very small.":26,"I used to play chess.":27,"I like reading books.":25,"I want to learn English.":25,"She is too tired to work.":32,"You are Ali, aren't you?":33,"I wish I had more time.":35,"If I were you, I would study more.":30,"He must be at home now.":36,"How do I get to the bus stop?":12,"Do you accept credit cards?":12,"I am looking for a hotel.":9,"Where can I buy a ticket?":12,"It is very hot today.":1
};
function oyinMavzuHTML(raqam){
  if(!raqam){return '<div class="test-teg" style="margin:8px 0 0;">💬 Tayyor ibora — yodlab oling</div>';}
  const g=grammatikaBul(raqam);if(!g)return '';
  return '<div class="test-teg" style="margin:8px 0 0;">📘 Grammatika · '+grammatikaTartib(g)+'-mavzu: '+g.sarlavha+' <button class="reset-tugma" style="margin-left:6px;padding:2px 8px;" onclick="testdanMavzu('+g.raqam+')">Ochish →</button></div>';
}
let O={};
function oyinOvoz(t){try{window.speechSynthesis.cancel();gapirtir(t);}catch(e){}}
function oyinSarlavha(nom,i,jami){return `<div class="sahifa-sarlavha"><div class="qator"><h2>${nom}</h2><span class="belgi">${Math.min(i+1,jami)}/${jami}</span><button class="reset-tugma" onclick="oyinlarKo_rsatish()">← Menyu</button></div></div><div class="test-progress"><div class="progress-chiziq"><div class="progress-toʻlgan" style="width:${i/jami*100}%"></div></div><div class="test-ball">⭐ ${O.xp}</div></div>`;}
function oyinlarKo_rsatish(){
  tezkorToxtat();
  const kartalar=[['gap','🧩',"Gap tuzish","Aralashgan so'zlardan gap yig'ing"],['tinglash','🎧',"Tinglab top","Eshiting va ma'nosini toping"],['gapirish','🎙️',"Gapirib ko'r","Iborani ovoz chiqarib ayting"],['juftlik','🧠',"Juftlikni top","So'z va tarjimasini juftlang"],['harf','🔠',"Harf terish","Harflardan so'z yig'ing"],['tezkor','⚡',"Tezkor so'z","30 soniyada to'g'ri / noto'g'ri"]];
  document.getElementById('kontent-joy').innerHTML=`<div class="sahifa-sarlavha"><h2>O'yinlar 🎮</h2><p>O'ynab o'rganing: har o'yin 2–3 daqiqa. Maqsad — kundalik suhbatda gapira olish. Har to'g'ri javob +5 XP.</p></div><div class="stsenariy-grid">${kartalar.map(([k,i,n,t])=>`<div class="stsenariy-karta" onclick="oyinBoshlash('${k}')"><div class="stsenariy-icon">${i}</div><div class="stsenariy-nomi">${n}</div><div class="stsenariy-uz">${t}</div></div>`).join('')}</div><div class="manba-eslatma">🎙️ "Gapirib ko'r" mikrofon ruxsatini talab qiladi va Chrome brauzerida eng yaxshi ishlaydi. Ishlamasa, "Aytdim" tugmasi bilan o'zingiz belgilaysiz.</div>`;
}
function oyinBoshlash(k){
  if(k==='juftlik'){juftBoshlash();return;}
  if(k==='harf'){harfBoshlash();return;}
  if(k==='tezkor'){tezkorBoshlash();return;}
  O={tur:k,royxat:aralashtir(IBORALAR).slice(0,8),i:0,togri:0,xp:0};O.jami=O.royxat.length;
  if(k==='gap')gapRaund();else if(k==='tinglash')tingRaund();else gapirRaund();
}
function oyinTugadi(){
  streakYangilash();
  const foiz=O.jami?Math.round(O.togri/O.jami*100):0;
  document.getElementById('kontent-joy').innerHTML=`<div class="sahifa-sarlavha"><h2>O'yin tugadi! 🎉</h2></div><div class="test-karta" style="text-align:center;"><div style="font-size:52px;margin-bottom:12px;">${foiz>=80?'🏆':foiz>=50?'👍':'💪'}</div><div style="font-size:22px;font-weight:700;margin-bottom:6px;">${O.togri} / ${O.jami}</div><div style="color:var(--sariq);margin-bottom:18px;">⭐ +${O.xp} XP</div><button class="test-keyingi" onclick="${O.tur==='dialog'?'dialogTanlash()':`oyinBoshlash('${O.tur}')`}">🔄 Yana o'ynash</button> <button class="reset-tugma" onclick="oyinlarKo_rsatish()" style="margin-left:8px;">Menyu</button></div>`;
}
function oyinJavobTugmalari(idPrefix,n,togriIdx,tanlanganIdx){
  for(let k=0;k<n;k++){const b=document.getElementById(idPrefix+k);if(!b)continue;b.disabled=true;if(k===togriIdx)b.classList.add('togri');else if(k===tanlanganIdx)b.classList.add('noto-gri');}
}
/* 2) Gap tuzish */
function gapRaund(){
  if(O.i>=O.jami){oyinTugadi();return;}
  const [en,uz]=O.royxat[O.i];O.en=en;O.uz=uz;O.sozlar=en.split(' ');
  let b=aralashtir(O.sozlar.map((s,k)=>k));
  for(let t=0;t<5&&O.sozlar.length>2&&b.every((v,k)=>v===k);t++)b=aralashtir(b);
  O.bank=b;O.tanlangan=[];O.javoblandi=false;O.natija=null;gapChiz();
}
function gapChiz(){
  const tolgan=O.tanlangan.length===O.sozlar.length;
  const qolgan=O.bank.filter(k=>!O.tanlangan.includes(k));
  let pastki='';
  if(O.javoblandi){pastki=`<div class="test-fikr ${O.natija?'yaxshi':'yomon'}">${O.natija?"✅ To'g'ri! +5 XP":"❌ To'g'ri gap:"} <strong>${O.en}</strong></div>${oyinMavzuHTML(IBORA_MAVZU[O.en])}<button class="test-keyingi" onclick="O.i++;gapRaund()">Keyingisi →</button>`;}
  else pastki=`<button class="test-keyingi" ${tolgan?'':'disabled style="opacity:.4;"'} onclick="gapTekshir()">Tekshirish</button>`;
  document.getElementById('kontent-joy').innerHTML=oyinSarlavha('🧩 Gap tuzish',O.i,O.jami)+`<div class="test-karta"><div style="font-size:13px;color:var(--kulrang);margin-bottom:6px;">Inglizchaga o'giring:</div><div style="font-size:18px;font-weight:600;margin-bottom:16px;">🇺🇿 ${O.uz}</div><div class="javob-joy">${O.tanlangan.map((k,p)=>`<button class="chip" ${O.javoblandi?'disabled':''} onclick="gapOlib(${p})">${O.sozlar[k]}</button>`).join('')||'<span style="color:var(--kulrang);font-size:13px;">So\'zlarni shu yerga yig\'ing...</span>'}</div><div class="chip-qator">${qolgan.map(k=>`<button class="chip" ${O.javoblandi?'disabled':''} onclick="gapQosh(${k})">${O.sozlar[k]}</button>`).join('')}</div>${pastki}</div>`;
}
function gapQosh(k){if(O.javoblandi)return;O.tanlangan.push(k);gapChiz();}
function gapOlib(p){if(O.javoblandi)return;O.tanlangan.splice(p,1);gapChiz();}
function gapTekshir(){
  if(O.javoblandi||O.tanlangan.length!==O.sozlar.length)return;
  O.natija=O.tanlangan.map(k=>O.sozlar[k]).join(' ')===O.en;O.javoblandi=true;
  if(O.natija){O.togri++;O.xp+=5;xpQoshish(5);oyinOvoz(O.en);}
  gapChiz();
}
/* 3) Tinglab top */
function tingRaund(){
  if(O.i>=O.jami){oyinTugadi();return;}
  const [en,uz]=O.royxat[O.i];
  const notogri=aralashtir(IBORALAR.filter(p=>p[1]!==uz)).slice(0,3).map(p=>p[1]);
  O.en=en;O.uz=uz;O.vs=aralashtir([uz,...notogri]);O.javoblandi=false;tingChiz();
  setTimeout(()=>oyinOvoz(en),300);
}
function tingChiz(){
  document.getElementById('kontent-joy').innerHTML=oyinSarlavha('🎧 Tinglab top',O.i,O.jami)+`<div class="test-karta"><div style="text-align:center;margin-bottom:18px;"><button class="katta-ovoz" onclick="oyinOvoz(O.en)">🔊</button><div style="font-size:12.5px;color:var(--kulrang);margin-top:8px;">Eshiting va ma'nosini toping (qayta bosing — yana eshitasiz)</div></div><div class="test-variantlar">${O.vs.map((v,k)=>`<button class="test-variant" id="tv_${k}" onclick="tingJavob(${k})">${v}</button>`).join('')}</div><div id="oyinIzoh"></div></div>`;
}
function tingJavob(k){
  if(O.javoblandi)return;O.javoblandi=true;
  const ok=O.vs[k]===O.uz;oyinJavobTugmalari('tv_',O.vs.length,O.vs.indexOf(O.uz),k);
  if(ok){O.togri++;O.xp+=5;xpQoshish(5);}
  document.getElementById('oyinIzoh').innerHTML=`<div class="test-fikr ${ok?'yaxshi':'yomon'}">${ok?"✅ To'g'ri! +5 XP":"❌ Noto'g'ri."} 🇬🇧 <strong>${O.en}</strong> — ${O.uz}</div>${oyinMavzuHTML(IBORA_MAVZU[O.en])}<button class="test-keyingi" onclick="O.i++;tingRaund()">Keyingisi →</button>`;
}
/* 4) Gapirib ko'r */
function gapirRaund(){
  if(O.i>=O.jami){oyinTugadi();return;}
  const [en,uz]=O.royxat[O.i];O.en=en;O.uz=uz;O.javoblandi=false;O.holat='';O.eshitildi='';O.foiz=null;gapirChiz();
}
function gapirChiz(){
  let pastki='';
  if(O.javoblandi){
    const matn=O.foiz===null?`✅ Yaxshi! (o'zingiz belgilagansiz) +2 XP`:(O.foiz>=70?`✅ Ajoyib! ${O.foiz}% mos keldi. +5 XP`:`❌ ${O.foiz}% mos keldi. Yana urinib ko'ring yoki keyingisiga o'ting.`);
    pastki=`<div class="test-fikr ${O.foiz===null||O.foiz>=70?'yaxshi':'yomon'}">${matn}${O.eshitildi?`<div style="font-size:12.5px;font-weight:400;margin-top:6px;">Siz aytdingiz: "${O.eshitildi}"</div>`:''}</div>${oyinMavzuHTML(IBORA_MAVZU[O.en])}<button class="test-keyingi" onclick="O.i++;gapirRaund()">Keyingisi →</button>`;
    if(O.foiz!==null&&O.foiz<70)pastki+=` <button class="reset-tugma" onclick="O.javoblandi=false;O.holat='';gapirChiz()">🔁 Qayta urinish</button>`;
  } else if(O.holat==='tinglanyapti'){pastki=`<div class="test-fikr yaxshi">🎙️ Eshitilmoqda... ayting!</div>`;}
  else {
    const xabar=O.holat==='qollamaydi'?"Brauzeringiz ovozni tanishni qo'llamaydi (Chrome'da sinab ko'ring).":O.holat==='xato'?"Mikrofon ishlamadi yoki ruxsat berilmadi.":O.holat==='jim'?"Hech narsa eshitilmadi, qayta urining.":'';
    pastki=`${xabar?`<div class="test-fikr yomon" style="margin-bottom:12px;">${xabar}</div>`:''}<button class="test-keyingi" onclick="mikBoshla()">🎙️ Gapirish</button> <button class="reset-tugma" onclick="gapirMenAyttim()">✋ Aytdim</button>`;
  }
  document.getElementById('kontent-joy').innerHTML=oyinSarlavha('🎙️ Gapirib ko\'r',O.i,O.jami)+`<div class="test-karta" style="text-align:center;"><div style="font-size:12.5px;color:var(--kulrang);margin-bottom:8px;">Ovoz chiqarib ayting:</div><div style="font-size:24px;font-weight:700;margin-bottom:6px;">🇬🇧 ${O.en}</div><div style="color:var(--osmon);font-size:14px;margin-bottom:16px;">🇺🇿 ${O.uz}</div><button class="reset-tugma" onclick="oyinOvoz(O.en)" style="margin-bottom:16px;">🔊 Namunani tinglash</button><div>${pastki}</div></div>`;
}
function mikBoshla(){
  const R=window.SpeechRecognition||window.webkitSpeechRecognition;
  if(!R){O.holat='qollamaydi';gapirChiz();return;}
  let r;try{r=new R();}catch(e){O.holat='qollamaydi';gapirChiz();return;}
  r.lang='en-US';r.interimResults=false;r.maxAlternatives=1;O.holat='tinglanyapti';gapirChiz();
  r.onresult=e=>{gapirBaho(e.results[0][0].transcript);};
  r.onerror=()=>{if(O.holat==='tinglanyapti'){O.holat='xato';gapirChiz();}};
  r.onend=()=>{if(O.holat==='tinglanyapti'){O.holat='jim';gapirChiz();}};
  try{r.start();}catch(e){O.holat='xato';gapirChiz();}
}
function sozlarTozala(s){return s.toLowerCase().replace(/[^a-z0-9' ]/g,' ').split(/\s+/).filter(Boolean);}
function gapirBaho(t){
  const h=sozlarTozala(O.en),a=sozlarTozala(t);
  O.foiz=Math.round(h.filter(w=>a.includes(w)).length/h.length*100);O.eshitildi=t;O.holat='';O.javoblandi=true;
  if(O.foiz>=70){O.togri++;O.xp+=5;xpQoshish(5);}
  gapirChiz();
}
function gapirMenAyttim(){if(O.javoblandi)return;O.javoblandi=true;O.foiz=null;O.togri++;O.xp+=2;xpQoshish(2);gapirChiz();}

/* 5) Juftlikni top — so'z va tarjimasini juftlang */
function juftBoshlash(){O={tur:'juftlik',i:0,togri:0,xp:0,jami:3};juftRaund();}
function juftRaund(){
  if(O.i>=O.jami){oyinTugadi();return;}
  const tanlangan=[];
  ochiqSozlar(24).forEach(w=>{
    if(tanlangan.length>=6) return;
    if(tanlangan.some(x=>x[0]===w[0]||uzOxshash(x[1],w[1]))) return;
    tanlangan.push(w);
  });
  O.sozlar=tanlangan;O.n=tanlangan.length;
  const tiles=[];
  tanlangan.forEach((w,k)=>{tiles.push({k,yon:'en',t:w[0]});tiles.push({k,yon:'uz',t:w[1]});});
  O.tiles=aralashtir(tiles).map((t,id)=>({...t,id,topildi:false,xato:false}));
  O.tanl=null;O.topilgan=0;O.xato=0;O.qulf=false;O.tugadi=false;
  juftChiz();
}
function juftChiz(){
  const katak=O.tiles.map(t=>`<button class="test-variant juft-katak ${t.topildi?'togri':''} ${t.xato?'noto-gri':''} ${O.tanl===t.id?'tanlangan-katak':''}" style="text-align:center;min-height:58px;${t.yon==='en'?'font-weight:700;':''}" ${t.topildi?'disabled':''} onclick="juftBos(${t.id})">${t.t}</button>`).join('');
  const past=O.tugadi?`<div class="test-fikr yaxshi">✅ Raund tugadi! Xatolar: ${O.xato}</div><button class="test-keyingi" onclick="O.i++;juftRaund()">${O.i+1>=O.jami?'Yakunlash':'Keyingi raund'} →</button>`:`<div style="font-size:12.5px;color:var(--kulrang);margin-top:12px;">Juftlangan: ${O.topilgan}/${O.n} · Xato: ${O.xato}</div>`;
  document.getElementById('kontent-joy').innerHTML=oyinSarlavha('🧠 Juftlikni top',O.i,O.jami)+`<div class="test-karta"><div style="font-size:13px;color:var(--kulrang);margin-bottom:12px;">Inglizcha so'zni va uning o'zbekcha ma'nosini ketma-ket bosing.</div><div id="juft-grid" style="display:grid;grid-template-columns:repeat(2,1fr);gap:10px;">${katak}</div>${past}</div>`;
}
function juftBos(id){
  if(O.qulf||O.tugadi) return;
  const t=O.tiles[id];if(!t||t.topildi) return;
  if(O.tanl===null){O.tanl=id;if(t.yon==='en')oyinOvoz(t.t);juftChiz();return;}
  if(O.tanl===id){O.tanl=null;juftChiz();return;}
  const a=O.tiles[O.tanl];
  if(a.yon===t.yon){O.tanl=id;juftChiz();return;}
  if(a.k===t.k){
    a.topildi=t.topildi=true;O.tanl=null;O.topilgan++;O.xp+=3;xpQoshish(3);
    const w=O.sozlar[t.k];oyinOvoz(w[0]);zaifBelgila('soz',sozKaliti(w[2],w[0]),true);
    if(O.topilgan===O.n){O.tugadi=true;O.togri++;streakYangilash();}
    juftChiz();
  }else{
    O.xato++;O.qulf=true;a.xato=t.xato=true;
    [O.sozlar[a.k],O.sozlar[t.k]].forEach(w=>zaifBelgila('soz',sozKaliti(w[2],w[0]),false));
    juftChiz();
    const raund=O.i;
    setTimeout(()=>{
      if(O.tur!=='juftlik'||O.i!==raund||!document.getElementById('juft-grid')) return;
      a.xato=t.xato=false;O.tanl=null;O.qulf=false;juftChiz();
    },700);
  }
}

/* 6) Harf terish — harflardan so'z yig'ing */
function harfBoshlash(){
  const kand=ochiqSozlar(60).filter(w=>/^[a-z]{4,9}$/.test(w[0]));
  O={tur:'harf',royxat:kand.slice(0,8),i:0,togri:0,xp:0};O.jami=O.royxat.length;
  if(!O.jami){oyinlarKo_rsatish();return;}
  harfRaund();
}
function harfRaund(){
  if(O.i>=O.jami){oyinTugadi();return;}
  const [en,uz,d]=O.royxat[O.i];O.en=en;O.uz=uz;O.d=d;
  let b=aralashtir(en.split('').map((h,k)=>k));
  for(let t=0;t<8&&b.map(k=>en[k]).join('')===en;t++)b=aralashtir(b);
  O.bank=b;O.tanlangan=[];O.javoblandi=false;O.natija=null;O.ishora=false;harfChiz();
}
function harfChiz(){
  const tolgan=O.tanlangan.length===O.en.length;
  const qolgan=O.bank.filter(k=>!O.tanlangan.includes(k));
  let slotlar='';
  for(let p=0;p<O.en.length;p++){
    const k=O.tanlangan[p];
    slotlar+=k===undefined?`<span class="chip" style="min-width:34px;text-align:center;opacity:.35;">_</span>`:`<button class="chip" style="min-width:34px;text-align:center;font-weight:700;" onclick="harfOlib(${p})">${O.en[k]}</button>`;
  }
  const bank=qolgan.map(k=>`<button class="chip" style="min-width:42px;min-height:42px;text-align:center;font-weight:700;font-size:16px;" onclick="harfQosh(${k})">${O.en[k]}</button>`).join('');
  let past;
  if(O.javoblandi) past=`<div class="test-fikr ${O.natija?'yaxshi':'yomon'}">${O.natija?"✅ To'g'ri!"+(O.ishora?' +3 XP':' +5 XP'):"❌ To'g'ri yozilishi:"} <strong>${O.en}</strong></div><button class="test-keyingi" onclick="O.i++;harfRaund()">Keyingisi →</button>`;
  else past=`<button class="test-keyingi" ${tolgan?'':'disabled style="opacity:.4;"'} onclick="harfTekshir()">Tekshirish</button> <button class="reset-tugma" onclick="harfIshora()">💡 Ishora</button>`;
  document.getElementById('kontent-joy').innerHTML=oyinSarlavha('🔠 Harf terish',O.i,O.jami)+`<div class="test-karta"><div style="font-size:13px;color:var(--kulrang);margin-bottom:6px;">Inglizchasini yig'ing:</div><div style="font-size:20px;font-weight:700;margin-bottom:6px;">🇺🇿 ${O.uz}</div>${O.ishora?`<div style="font-size:13px;color:var(--sariq);margin-bottom:8px;">Birinchi harf: <strong>${O.en[0]}</strong> · ${O.en.length} ta harf</div>`:''}<div class="javob-joy">${slotlar}</div><div class="chip-qator">${bank}</div>${past}</div>`;
}
function harfQosh(k){if(O.javoblandi)return;O.tanlangan.push(k);harfChiz();}
function harfOlib(p){if(O.javoblandi)return;O.tanlangan.splice(p,1);harfChiz();}
function harfIshora(){if(O.javoblandi)return;O.ishora=true;oyinOvoz(O.en);harfChiz();}
function harfTekshir(){
  if(O.javoblandi||O.tanlangan.length!==O.en.length) return;
  O.natija=O.tanlangan.map(k=>O.en[k]).join('')===O.en;O.javoblandi=true;
  zaifBelgila('soz',sozKaliti(O.d,O.en),O.natija);
  if(O.natija){O.togri++;const x=O.ishora?3:5;O.xp+=x;xpQoshish(x);oyinOvoz(O.en);}
  harfChiz();
}

/* 7) Tezkor so'z — 30 soniyada to'g'ri/noto'g'ri */
function tezkorBoshlash(){
  tezkorToxtat();
  O={tur:'tezkor',pool:ochiqSozlar(80),togri:0,jami:0,xp:0,t:30,oxirgi:''};

  tezkorKarta();tezkorChiz();
  O.timer=setInterval(tezkorTik,1000);
}
function tezkorKarta(){
  const p=O.pool;const w=p[Math.floor(Math.random()*p.length)];
  let uz=w[1],togri=true;
  if(Math.random()<0.5){
    const boshqa=aralashtir(p.filter(x=>x[0]!==w[0]&&!uzOxshash(x[1],w[1])));
    if(boshqa.length){uz=boshqa[0][1];togri=false;}
  }
  O.karta={w,uz,togri};
}
function tezkorChiz(){
  const k=O.karta;
  document.getElementById('kontent-joy').innerHTML=`<div class="sahifa-sarlavha"><div class="qator"><h2>⚡ Tezkor so'z</h2><button class="reset-tugma" onclick="tezkorToxtat();oyinlarKo_rsatish()">← Menyu</button></div></div><div class="test-karta" style="text-align:center;"><div class="qator" style="justify-content:space-between;margin-bottom:14px;"><span class="belgi" id="tezkor-vaqt">⏱ ${O.t} s</span><span class="belgi">✅ ${O.togri} / ${O.jami}</span><span class="belgi">⭐ ${O.xp}</span></div><div style="font-size:30px;font-weight:800;margin:18px 0 6px;">${k.w[0]}</div><div style="font-size:20px;color:var(--osmon);margin-bottom:22px;">= ${k.uz}</div><div class="qator" style="justify-content:center;gap:14px;"><button class="test-keyingi" style="margin:0;min-width:130px;background:linear-gradient(135deg,#047857,#065f46);" onclick="tezkorJavob(true)">✅ To'g'ri</button><button class="test-keyingi" style="margin:0;min-width:130px;background:linear-gradient(135deg,#b91c1c,#7f1d1d);" onclick="tezkorJavob(false)">❌ Noto'g'ri</button></div><div style="min-height:40px;margin-top:16px;font-size:13px;color:var(--kulrang);">${O.oxirgi}</div></div>`;
}
function tezkorJavob(b){
  if(O.tur!=='tezkor'||O.t<=0) return;
  const k=O.karta;const ok=b===k.togri;O.jami++;
  if(ok){O.togri++;O.xp+=2;xpQoshish(2);O.oxirgi=`✅ To'g'ri`;}
  else{O.oxirgi=`❌ To'g'risi: <strong>${k.w[0]}</strong> = ${k.w[1]}`;zaifBelgila('soz',sozKaliti(k.w[2],k.w[0]),false);}
  tezkorKarta();tezkorChiz();
}
function tezkorTik(){
  const el=document.getElementById('tezkor-vaqt');
  if(!el||!O||O.tur!=='tezkor'){tezkorToxtat();return;}
  O.t--;el.textContent=`⏱ ${Math.max(O.t,0)} s`;
  if(O.t<=0){tezkorToxtat();oyinTugadi();}
}
function tezkorToxtat(){if(O&&O.timer){clearInterval(O.timer);O.timer=null;}}

