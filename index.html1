["The results were ___: sometimes excellent, sometimes very poor.", "erratic", ["paramount", "resolute", "meager"], "erratic", "Natijalar beqaror edi: ba'zan a'lo, ba'zan juda yomon."],
["The thief was ___; the police could not find him for months.", "elusive", ["obstinate", "precarious", "tedious"], "elusive", "O'g'ri ushlab bo'lmas edi; politsiya uni oylab topa olmadi."],
["The writer's true motive remains ___, and critics still argue about it.", "enigmatic", ["lucrative", "benign", "transient"], "enigmatic", "Yozuvchining haqiqiy maqsadi sirli bo'lib qolmoqda, tanqidchilar hanuz bahslashmoqda."],
["The contract is very ___: one small mistake could cost the company millions.", "precarious", ["paramount", "complacent", "wary"], "precarious", "Shartnoma juda xavfli: bitta kichik xato kompaniyaga millionlarga tushishi mumkin."],
["Your health is ___; nothing is more important than that.", "paramount", ["spurious", "tedious", "meager"], "paramount", "Sog'lig'ingiz eng muhim; undan muhimroq narsa yo'q."],
["The report was ___: its numbers were false and its sources were unreliable.", "spurious", ["benign", "adamant", "resolute"], "spurious", "Hisobot soxta edi: raqamlari yolg'on, manbalari ishonchsiz edi."],
["He was ___ in his decision and would not change his mind, whatever people said.", "adamant", ["sedentary", "reticent", "wary"], "adamant", "U qarorida qat'iy edi va odamlar nima desa ham fikrini o'zgartirmadi."],
["The scientist was ___ and checked every measurement twice.", "scrupulous", ["erratic", "benign", "complacent"], "scrupulous", "Olim puxta edi va har bir o'lchovni ikki marta tekshirdi."],
["The dry summer ___ the water reserves of the village.", "depleted", ["derived", "dispelled", "undermined"], "deplete", "Quruq yoz qishloqning suv zaxiralarini kamaytirib yubordi."],
["The idea seemed ___ at first, but later it proved to be true.", "dubious", ["benign", "lucrative", "complacent"], "dubious", "Bu g'oya dastlab shubhali tuyulgan, lekin keyinroq to'g'ri chiqdi."],
["The company's profits ___ a lot from month to month.","fluctuate",["eradicate","disseminate","reconcile"],"fluctuate","Kompaniya foydasi oyma-oy keskin o'zgarib turadi."],["Experts say the new law will ___ the impact of the crisis.","mitigate",["oscillate","forge","abstain"],"mitigate","Mutaxassislarning aytishicha, yangi qonun inqiroz ta'sirini yumshatadi."],["Poor roads ___ economic growth in the region.","impede",["elicit","comprise","substantiate"],"impede","Yomon yo'llar mintaqada iqtisodiy o'sishga to'sqinlik qiladi."],["The plan is ___: we have enough time, money and people to do it.","feasible",["precarious","obsolete","superficial"],"feasible","Reja amalga oshirish mumkin: bizda buning uchun yetarli vaqt, pul va odam bor."],["The old system is now ___. Nobody uses it any more.","obsolete",["prevalent","indispensable","tangible"],"obsolete","Eski tizim endi eskirgan. Uni hech kim ishlatmaydi."],["You need a degree as a ___ for this job.","prerequisite",["paradox","catalyst","premise"],"prerequisite","Bu ish uchun oldindan shart sifatida diplom kerak."],["Her argument was very ___, and everyone agreed with her.","compelling",["marginal","volatile","peripheral"],"compelling","Uning dalili juda ishonarli edi va hamma u bilan kelishdi."],["There is a ___ between the two reports. The numbers do not match.","discrepancy",["paradigm","rhetoric","scrutiny"],"discrepancy","Ikki hisobot orasida nomuvofiqlik bor. Raqamlar mos kelmayapti."],["The company is under public ___ after the accident.","scrutiny",["synthesis","premise","convergence"],"scrutiny","Avariyadan keyin kompaniya jamoatchilikning sinchkov nazoratida."],["Please be ___ about what you want. Do not hide it.","explicit",["implicit","arbitrary","plausible"],"explicit","Nimani xohlayotganingizni aniq ayting. Yashirmang."],["He is a strong ___ of free education.","proponent",["anomaly","premise","parameter"],"proponent","U bepul ta'limning kuchli tarafdori."],["The scientist wants to ___ a new theory about climate.","formulate",["eradicate","fluctuate","oscillate"],"formulate","Olim iqlim haqida yangi nazariya shakllantirmoqchi."],["We try to ___ different opinions to reach a decision both sides accept.","reconcile",["eradicate","oscillate","impede"],"reconcile","Ikkala tomon qabul qiladigan qarorga kelish uchun turli fikrlarni yarashtirishga harakat qilamiz."],["This is a ___ complaint, so we must investigate it.","legitimate",["obsolete","ubiquitous","precarious"],"legitimate","Bu asosli shikoyat, shuning uchun uni tekshirishimiz kerak."],["Smartphones are ___. You can see them everywhere.","ubiquitous",["precarious","redundant","meticulous"],"ubiquitous","Smartfonlar hamma joyda uchraydi. Ularni har yerda ko'rish mumkin."],["She is very ___ and checks every detail twice.","meticulous",["ambivalent","volatile","superficial"],"meticulous","U juda sinchkov va har bir tafsilotni ikki marta tekshiradi."],["I feel ___ about moving abroad: I want to go, but I'm also afraid.","ambivalent",["pragmatic","rigorous","empirical"],"ambivalent","Chet elga ko'chish haqida ikkilanayapman: bormoqchiman ham, qo'rqaman ham."],["The teacher asked the students to ___ their ideas clearly in English.","articulate",["fluctuate","eradicate","oscillate"],"articulate","O'qituvchi o'quvchilardan fikrlarini inglizchada aniq ifodalashni so'radi."],["Doctors work to ___ diseases such as polio completely.","eradicate",["articulate","formulate","mediate"],"eradicate","Shifokorlar poliomielit kabi kasalliklarni butunlay yo'q qilish uchun ishlaydi."],["Over the years, the company managed to ___ a lot of wealth.","accumulate",["abstain","impede","negate"],"accumulate","Yillar davomida kompaniya katta boylik to'plashga muvaffaq bo'ldi."],["Oil prices are ___ and can change in a single day.","volatile",["tangible","prevalent","explicit"],"volatile","Neft narxi beqaror va bir kunda o'zgarishi mumkin."],["He is ___ about the plan; he is not sure it will work.","skeptical",["explicit","holistic","integral"],"skeptical","U rejaga shubha bilan qaraydi; uning ishlashiga ishonchi komil emas."],["A ___ economy can recover quickly after a crisis.","resilient",["tangible","superficial","redundant"],"resilient","Chidamli iqtisodiyot inqirozdan keyin tez tiklanishi mumkin."],["We need ___ evidence, not just opinions.","empirical",["arbitrary","superficial","ambivalent"],"empirical","Bizga shunchaki fikrlar emas, tajribaga asoslangan dalil kerak."],["He couldn't ___ the real reason for her sadness.","discern",["encompass","commemorate","mediate"],"discern","U uning g'amginligining haqiqiy sababini ajrata olmadi."],["The two groups were in conflict, so a neutral person tried to ___.","mediate",["consolidate","articulate","elicit"],"mediate","Ikki guruh nizoda edi, shuning uchun betaraf kishi vositachilik qilishga urindi."],["Water is ___ to life; nothing can live without it.","indispensable",["peripheral","redundant","marginal"],"indispensable","Suv hayot uchun ajralmas; usiz hech narsa yashay olmaydi."],["He was very ___ in his answer and told the truth directly.","candid",["complacent","convoluted","cursory"],"candid","U javobida juda ochiq edi va haqiqatni to'g'ridan-to'g'ri aytdi."]]};
function clozeSavollari(daraja,son){
  const royxat=CLOZE_BANK[daraja]||[];
  zaifTayyorla();
  const baho=it=>{const k=sozKaliti(daraja,it[3]);const h=PROGRESS.sozlar[k];return (PROGRESS.zaif[k]?0:(h&&h.keyingi<=Date.now()&&h.level<5)?1:2)+Math.random();};
  return royxat.slice().sort((a,b)=>baho(a)-baho(b)).slice(0,son).map(([gap,togri,notogri,kalit,uz])=>{
    const variantlar=aralashtir([togri,...notogri]);
    const lug=(SOZLAR_DB[daraja]||[]).find(w=>w[0]===kalit);
    const korinish=gap.replace('___','<span style="color:var(--sariq);font-weight:800;">______</span>');
    return {savol:`Gapga mos so'zni tanlang:<br><span style="color:var(--osmon);font-weight:500;">${korinish}</span>`,variantlar,togri:variantlar.indexOf(togri),izoh:`🇬🇧 ${gap.replace('___','<strong>'+togri+'</strong>')}<br>🇺🇿 ${uz}${lug?`<br>🔤 ${kalit} — ${lug[1]}`:''}`,teg:{tur:'soz',daraja,en:kalit,kont:true}};
  });
}
function boshliqSavollari(daraja,son){
  return aralashtir((FILL_BANK[daraja]||[]).map((x,i)=>[...x,(FILL_MAVZU[daraja]||[])[i]||null])).slice(0,son).map(([gap,togri,notogri,izoh,mavzu])=>{
    const variantlar=aralashtir([togri,...notogri]);
    const korinish=gap.replace('___','<span style="color:var(--sariq);font-weight:800;">______</span>');
    return {savol:`Bo'shliqni to'ldiring:<br><span style="color:var(--osmon);font-weight:500;">${korinish}</span>`,variantlar,togri:variantlar.indexOf(togri),izoh,teg:{tur:'gram',raqam:mavzu}};
  });
}
function zamonSavollari(daraja,son){
  const pool=TENSE_POOL[daraja];
  return aralashtir(TENSE_BANK[daraja]||[]).slice(0,son).map(([gap,zamon])=>{
    const notogri=aralashtir(pool.filter(z=>z!==zamon)).slice(0,3);
    const variantlar=aralashtir([zamon,...notogri]);
    return {savol:`Quyidagi gap qaysi zamonda tuzilgan?<br><span style="color:var(--osmon);font-weight:500;">"${gap}"</span>`,variantlar,togri:variantlar.indexOf(zamon),izoh:TENSE_IZOH[zamon]||'',teg:{tur:'zamon',nom:zamon,raqam:TENSE_MAVZU[zamon]||null}};
  });
}
function gramMashqlari(daraja,birliklar){
  const r=[];
  GRAMMATIKA_20.forEach((g,gi)=>{
    if(!g.tayyor) return;
    if(daraja&&g.daraja!==daraja) return;
    if(birliklar&&!birliklar.includes(g.raqam)) return;
    g.mashqlar.forEach((m,qi)=>r.push({g,gi,m,qi}));
  });
  return r;
}
function gramSavolYasash(x){
  const {g,m,qi}=x;
  const togriMatn=m.variantlar[m.togri];
  const variantlar=aralashtir(m.variantlar.slice());
  const korinish=m.savol.replace('___','<span style="color:var(--sariq);font-weight:800;">______</span>');
  const savol=m.savol.includes('___')?`Bo'shliqni to'ldiring:<br><span style="color:var(--osmon);font-weight:500;">${korinish}</span>`:`<span style="color:var(--osmon);font-weight:500;">${m.savol}</span>`;
  return {savol,variantlar,togri:variantlar.indexOf(togriMatn),izoh:m.izoh,teg:{tur:'gram',raqam:g.raqam,qi}};
}
function gramSavollari(daraja,son){return aralashtir(gramMashqlari(daraja)).slice(0,son).map(gramSavolYasash);}
function xatoYangiSavol(k){
  const [p,d,en]=k.split('::');
  if(p==='sin'){const e=(SINONIMLAR[d]||[]).find(x=>x[0]===en);return e?sinSavolOne(d,e):null;}
  if(p==='ant'){const e=(ANTONIMLAR[d]||[]).find(x=>x[0]===en);return e?antSavolOne(d,e):null;}
  if(p==='om'){const e=(OMONIMLAR[d]||[]).find(x=>x[0]===en);return e?omSavolOne(d,e):null;}
  return null;
}
function xatoSavollari(){
  zaifTayyorla();
  const yangiKalit=k=>/^(sin|ant|om)::/.test(k);
  const soz=Object.keys(PROGRESS.zaif).filter(k=>!yangiKalit(k)).map(k=>{const [d,en]=k.split('::');const w=(SOZLAR_DB[d]||[]).find(x=>x[0]===en);return w?{d,w}:null;}).filter(Boolean);
  const sq=aralashtir(soz).slice(0,6).map((x,i)=>{
    const pool=SOZLAR_DB[x.d];
    if(i%2===0){const v=aralashtir([x.w[1],...chalgitgichlar(pool,x.w,1)]);return {savol:`'${x.w[0]}' so'zining o'zbekcha ma'nosi qaysi?`,variantlar:v,togri:v.indexOf(x.w[1]),izoh:'',teg:{tur:'soz',daraja:x.d,en:x.w[0]}};}
    const v=aralashtir([x.w[0],...chalgitgichlar(pool,x.w,0)]);return {savol:`"${x.w[1]}" — inglizchasi qaysi?`,variantlar:v,togri:v.indexOf(x.w[0]),izoh:'',teg:{tur:'soz',daraja:x.d,en:x.w[0]}};
  });
  const yangi=aralashtir(Object.keys(PROGRESS.zaif).filter(yangiKalit)).map(xatoYangiSavol).filter(Boolean).slice(0,4);
  const birliklar=Object.keys(PROGRESS.zaifGram).map(Number);
  const gq=birliklar.length?aralashtir(gramMashqlari(null,birliklar)).slice(0,4).map(gramSavolYasash):[];
  return aralashtir([...sq,...yangi,...gq]);
}function savolBirlashtir(...guruhlar){
  const korilgan=new Set();const r=[];
  guruhlar.flat().forEach(q=>{
    const k=q.teg&&q.teg.tur==='soz'?'soz:'+q.teg.en:q.savol;
    if(korilgan.has(k)||korilgan.has(q.savol)) return;
    korilgan.add(k);korilgan.add(q.savol);r.push(q);
  });
  return r;
}
function testGenerats(daraja,rejim){
  if(rejim==='soz'){const sh=sharhSavollari(daraja,3);return aralashtir([...sozSavollari(daraja,10-sh.length),...sh]);}
  if(rejim==='sinonim') return sinonimSavollari(daraja,10);
  if(rejim==='omonim') return omonimSavollari(daraja,10);
  if(rejim==='antonim') return antonimSavollari(daraja,10);
  if(rejim==='teskari') return teskariSavollari(daraja,10);
  if(rejim==='tingla') return tinglaSavollari(daraja,8);
  if(rejim==='gapda') return clozeSavollari(daraja,10);
  if(rejim==='gram') return gramSavollari(daraja,10);
  if(rejim==='zamon') return zamonSavollari(daraja,6);
  if(rejim==='xato') return xatoSavollari();
  if(rejim==='boshliq'){
    const g=gramSavollari(daraja,99).filter(q=>q.savol.startsWith("Bo'shliqni"));
    return savolBirlashtir(aralashtir([...boshliqSavollari(daraja,99),...g])).slice(0,10);
  }
  // aralash: 5 ta so'z (2 ta en→uz, 1 ta uz→en, 2 ta gapda), 2 bo'shliq, 2 grammatika, 1 zamon
  const sh=sharhSavollari(daraja,1), bo=1-sh.length; // A1 da takrorlash yo'q: o'rnini joriy daraja savollari bosadi
  const sozlar=savolBirlashtir(sh,sozSavollari(daraja,3+bo),teskariSavollari(daraja,2),clozeSavollari(daraja,4+bo)).slice(0,5);
  const boshqa=savolBirlashtir(boshliqSavollari(daraja,2),gramSavollari(daraja,3).slice(0,2),zamonSavollari(daraja,1));
  let natija=aralashtir(savolBirlashtir(sozlar,boshqa));
  if(natija.length<10) natija=natija.concat(sozSavollari(daraja,10-natija.length)); // kafolat: doim 10 savol
  return natija;
}
function testRejimTanlash(r){testRejim=r;testYangiBoshlash();}
const TEST_GURUHLAR=[
  ['🎯 Asosiy',['aralash','soz','teskari','xato']],
  ['🛠 Amaliy',['tingla','gapda','boshliq','gram','zamon']],
  ["📚 Lug'at bog'liqligi",['sinonim','omonim','antonim']]
];
function testRejimlarHTML(){
  return TEST_GURUHLAR.map(([sarl,kalitlar])=>`
    <div class="rejim-guruh">
      <div class="rejim-sarlavha">${sarl}</div>
      <div class="daraja-filter rejim-qator">
        ${kalitlar.map(r=>{const nom=(TEST_REJIMLAR.find(x=>x[0]===r)||[])[1]||r;return `<button class="daraja-tugma ${testRejim===r?'tanlangan':''}" onclick="testRejimTanlash('${r}')">${nom}</button>`;}).join('')}
      </div>
    </div>`).join('');
}
function testYangiBoshlash(){
  if(!darajaOchiqmi(testDaraja)) testDaraja='A1';
  testSavollari=testGenerats(testDaraja,testRejim);
  testIndeksi=0;testBall=0;testJavoblandi=false;testJonlar=TEST_JONLAR_BOSHLANGICH;testXatolar=[];
  if(!testSavollari.length){
    document.getElementById('kontent-joy').innerHTML=`<div class="sahifa-sarlavha"><h2>Test</h2></div>${testRejimlarHTML()}<div class="test-karta" style="text-align:center;"><div style="font-size:48px;margin-bottom:12px;">🎉</div><div style="font-size:17px;font-weight:700;margin-bottom:6px;">Hozircha takrorlash kerak bo'lgan narsa yo'q!</div><div style="color:var(--kulrang);font-size:13px;">Testlarda xato qilingan so'z va mavzular shu yerda yig'iladi.</div></div>`;
    return;
  }
  testKo_rsatish();
}
function jonlarHTML(){
  let h='<div class="jon-qatori">';
  for(let i=0;i<TEST_JONLAR_BOSHLANGICH;i++){
    h+=`<span class="jon ${i>=testJonlar?'ochirilgan':''}">❤️</span>`;
  }
  h+='</div>';
  return h;
}
function testKo_rsatish(){
  if(testJonlar<=0){
    document.getElementById('kontent-joy').innerHTML=`
      <div class="sahifa-sarlavha"><h2>Jonlar tugadi 💔</h2></div>
      <div class="test-karta jon-tugadi-karta">
        <div style="font-size:52px;margin-bottom:16px;">😅</div>
        <div style="font-size:20px;font-weight:700;margin-bottom:8px;">Barcha jonlaringiz tugadi!</div>
        <div style="color:var(--kulrang);margin-bottom:8px;">Natija: ${testBall} / ${testIndeksi} to'g'ri</div>
        <div style="color:var(--kulrang);font-size:13px;margin-bottom:24px;">Xavotir olmang — grammatika yoki so'zlikni qayta ko'rib chiqib, keyin qayta urining</div>
        <button class="test-keyingi" onclick="testYangiBoshlash()">🔄 Qayta boshlash (5 jon bilan)</button>
      </div>`;
    return;
  }
  if(testIndeksi>=testSavollari.length){
    const foiz=Math.round(testBall/testSavollari.length*100);
    xpQoshish(testBall*10 + (foiz>=80?20:0));
    kunlikQayd(0,testSavollari.length,testBall);
    let ochildiXabar='';
    if(foiz>=OCHISH_CHEGARASI){
      const keyingi = keyingiDaraja(testDaraja);
      if(keyingi && darajaniOchish(keyingi)){
        ochildiXabar = `<div style="margin-top:18px;padding:14px;background:#052e1d;border:1px solid var(--yashil);border-radius:10px;color:var(--yashil);font-weight:600;">🔓 Tabriklaymiz! <strong>${keyingi}</strong> darajasi ochildi!</div>`;
      }
    }
    document.getElementById('kontent-joy').innerHTML=`
      <div class="sahifa-sarlavha"><h2>Test tugadi! 🎉</h2></div>
      <div class="test-karta" style="text-align:center;">
        <div style="font-size:52px;margin-bottom:16px;">${foiz>=80?'🏆':foiz>=50?'👍':'📚'}</div>
        <div style="font-size:22px;font-weight:700;margin-bottom:8px;">${testBall} / ${testSavollari.length} ta to'g'ri</div>
        <div style="font-size:32px;font-weight:800;color:var(--osmon);margin-bottom:8px;">${foiz}%</div>
        <div style="font-size:13px;color:var(--sariq);margin-bottom:8px;">⭐ +${testBall*10 + (foiz>=80?20:0)} XP olindi</div>
        <div style="font-size:14px;color:var(--kulrang);margin-bottom:8px;">${foiz>=80?"Ajoyib natija! Siz juda zo'r! 🌟":foiz>=50?"Yaxshi! Yana mashq qiling! 💪":"Qo'rqmang! Davom eting 📚"}</div>
        ${foiz<OCHISH_CHEGARASI?`<div style="font-size:12px;color:var(--kulrang);margin-bottom:16px;">Keyingi darajani ochish uchun kamida ${OCHISH_CHEGARASI}% kerak</div>`:''}
        ${ochildiXabar}${testXatolarHTML()}
        <button class="test-keyingi" onclick="testYangiBoshlash()" style="margin-top:16px;">🔄 Yangi test (tasodifiy)</button>
      </div>`;
    return;
  }
  const q=testSavollari[testIndeksi];
  const foiz=testIndeksi/testSavollari.length*100;
  document.getElementById('kontent-joy').innerHTML=`
    <div class="sahifa-sarlavha">
      <div class="qator"><h2>Test</h2><span class="belgi">Savol ${testIndeksi+1}/${testSavollari.length}</span></div>
    </div>
    ${jonlarHTML()}
    ${testRejimlarHTML()}
    <div class="daraja-filter">
      ${DARAJA_TARTIBI.map(d=>{
        const ochiq=darajaOchiqmi(d);
        return `<button class="daraja-tugma ${testDaraja===d?'tanlangan':''} ${ochiq?'':'qulflangan'}" onclick="${ochiq?`testDarajaTanlash('${d}')`:`darajaQulfXabari('${d}')`}">${ochiq?d:'🔒 '+d}</button>`;
      }).join('')}
    </div>
    <div class="test-progress">
      <div class="progress-chiziq"><div class="progress-toʻlgan" style="width:${foiz}%"></div></div>
      <div class="test-ball">✅ ${testBall}</div>
    </div>
    <div class="test-karta">
      <div id="test-teg">${tegHTML(q,false)}</div>
      <div class="test-savol">${q.savol}</div>
      <div class="test-variantlar">${q.variantlar.map((v,i)=>`<button class="test-variant" onclick="testJavob(${i})" ${testJavoblandi?'disabled':''}>${v}</button>`).join('')}</div>
      <div id="test-izoh"></div><div id="test-davom"></div>
    </div>`;
  if(q.avto) setTimeout(()=>oyinOvoz(q.avto),350);
}
function tegHTML(q,javob){
  const t=q.teg;if(!t) return '';
  if(t.tur==='soz') return `<div class="test-teg">${t.takror?'🔁 Takror':(t.kont?"📝 Gapda so'z":"🔤 So'z")} · ${t.daraja}</div>`;
  if(t.tur==='antonim') return `<div class="test-teg">↔️ Antonim · ${t.daraja}</div>`;
  if(t.tur==='omonim') return `<div class="test-teg">🔀 Omonim · ${t.daraja}</div>`;
  if(t.tur==='sinonim') return `<div class="test-teg">🔁 Sinonim · ${t.daraja}</div>`;
  if(t.tur==='gram'){
    if(!t.raqam) return `<div class="test-teg">📘 Grammatika · mustahkam birikma</div>`;
    const g=grammatikaBul(t.raqam);
    return `<div class="test-teg">📘 Grammatika · ${grammatikaTartib(g)}-mavzu: ${g.sarlavha}</div>`;
  }
  if(t.tur==='zamon'){
    if(!javob) return `<div class="test-teg">⏱ Zamonni aniqlash</div>`;
    const g=t.raqam?grammatikaBul(t.raqam):null;
    return `<div class="test-teg">⏱ Zamon: ${t.nom}${g?` · ${grammatikaTartib(g)}-mavzu`:''}</div>`;
  }
  return '';
}
function qoidaEslatmaHTML(q,togri){
  const t=q.teg;if(!t||!t.raqam||(t.tur!=='gram'&&t.tur!=='zamon')) return '';
  const g=grammatikaBul(t.raqam);if(!g||!g.tayyor) return '';
  return `<details class="qoida-eslatma" ${togri?'':'open'}><summary>📖 ${grammatikaTartib(g)}-mavzu qoidasi: ${g.sarlavha}</summary><div style="margin-top:8px;">${g.qoida.replace(/\n/g,'<br>')}</div><button class="reset-tugma" style="margin-top:10px;" onclick="testdanMavzu(${g.raqam})">Mavzuni to'liq ochish →</button></details>`;
}
function testdanMavzu(raqam){
  const idx=GRAMMATIKA_20.findIndex(g=>g.raqam===raqam);
  grammatikaOchiq=idx;modulAlmashtir('grammatika');
  setTimeout(()=>{const e=document.querySelectorAll('.grammatika-element')[idx];if(e&&e.scrollIntoView)e.scrollIntoView({block:'start'});},60);
}
function javobniYozish(q,togri){
  const t=q.teg;if(!t) return;
  if(t.tur==='soz'){zaifBelgila('soz',sozKaliti(t.daraja,t.en),togri);if(!togri)sozYangilash(t.daraja,t.en,false);}
  else if((t.tur==='gram'||t.tur==='zamon')&&t.raqam){zaifBelgila('gram',String(t.raqam),togri);}
  else if(t.tur==='sinonim'||t.tur==='antonim'||t.tur==='omonim'){const p={sinonim:'sin',antonim:'ant',omonim:'om'}[t.tur];zaifBelgila('soz',p+'::'+t.daraja+'::'+t.en,togri);}
}
function testXatolarHTML(){
  if(!testXatolar.length) return '';
  const birliklar=[...new Set(testXatolar.filter(t=>t&&t.raqam).map(t=>t.raqam))].slice(0,6);
  const sozlar=new Set(testXatolar.filter(t=>t&&['soz','sinonim','antonim','omonim'].includes(t.tur)).map(t=>t.tur+':'+t.en)).size;
  if(!birliklar.length&&!sozlar) return '';
  return `<div style="margin-top:18px;text-align:left;padding:14px;background:#071220;border:1px solid var(--chegara);border-radius:10px;"><div style="font-weight:700;font-size:13.5px;margin-bottom:8px;">♻️ Takrorlash uchun</div>${sozlar?`<div style="font-size:13px;color:var(--kulrang);margin-bottom:8px;">🔤 ${sozlar} ta so'z — Kartochkalar va "Xatolar" rejimida qaytadi</div>`:''}${birliklar.map(r=>`<button class="daraja-tugma" style="margin:0 6px 6px 0;" onclick="testdanMavzu(${r})">📘 ${r}-mavzu: ${grammatikaBul(r).sarlavha.split(' — ')[0]}</button>`).join('')}</div>`;
}
function darajaQulfXabari(d){
  const idx=DARAJA_TARTIBI.indexOf(d);
  const oldingi=DARAJA_TARTIBI[idx-1];
  alert(`🔒 ${d} darajasi hali qulflangan!\n\nOchish uchun: ${oldingi} darajasidan kamida ${OCHISH_CHEGARASI}% natija bilan test topshiring.`);
}
function testDarajaTanlash(d){if(!darajaOchiqmi(d)){darajaQulfXabari(d);return;}testDaraja=d;testYangiBoshlash();}
function testJavob(i){
  if(testJavoblandi) return;
  testJavoblandi=true;
  const q=testSavollari[testIndeksi];
  const togri=i===q.togri;
  if(togri) testBall++;
  else{testJonlar--;testXatolar.push(q.teg||null);}
  javobniYozish(q,togri);
  document.querySelectorAll('.test-variant').forEach((b,idx)=>{
    b.disabled=true;
    if(idx===q.togri) b.classList.add('togri');
    if(idx===i&&!togri) b.classList.add('noto-gri');
  });
  document.getElementById('test-izoh').innerHTML=`<div class="test-fikr ${togri?'yaxshi':'yomon'}">${togri?"✅ To'g'ri!":"❌ Noto'g'ri."} To'g'ri javob: <strong>${q.variantlar[q.togri]}</strong>${q.izoh?`<div style="font-size:12.5px;font-weight:400;margin-top:8px;opacity:.9;">💡 ${q.izoh}</div>`:''}</div>`;
  {const iz=document.getElementById('test-izoh');if(iz)iz.innerHTML+=qoidaEslatmaHTML(q,togri);const tg=document.getElementById('test-teg');if(tg)tg.innerHTML=tegHTML(q,true);}
  document.getElementById('test-davom').innerHTML=`<button class="test-keyingi" onclick="testKeyingi()">Keyingi savol →</button>`;
}
function testKeyingi(){testJavoblandi=false;testIndeksi++;testKo_rsatish();}

/* ── KARTOCHKALAR: SPACED REPETITION (SRS) — unutish egri chizig'iga asoslangan ── */
const SRS_KUNLIK_YANGI=10; // bir kunda nechta yangi so'z qo'shiladi

function kartochaYangiBoshlash(){
  const {due,yangi} = sozlarDueRoyxati(kartochaDaraja);
  const yangiQism = yangi.slice(0,SRS_KUNLIK_YANGI);
  kartochaRoyxat = aralashtir([...due,...yangiQism]);
  kartochaIndeksi=0;kartochaBildim=0;kartochaAylangan=false;kartochaSessiyaSoni=kartochaRoyxat.length;
  kartochkalarKo_rsatish();
}
function kartochkalarKo_rsatish(){
  if(kartochaRoyxat.length===0){
    document.getElementById('kontent-joy').innerHTML=`
      <div class="sahifa-sarlavha"><h2>Kartochkalar — SRS</h2><p>Aqlli takrorlash tizimi — unutish egri chizig'iga asoslangan</p></div>
      <div class="daraja-filter">
        ${DARAJA_TARTIBI.map(d=>{const ochiq=darajaOchiqmi(d);return `<button class="daraja-tugma ${kartochaDaraja===d?'tanlangan':''} ${ochiq?'':'qulflangan'}" onclick="${ochiq?`kartochaDarajaTanlash('${d}')`:`darajaQulfXabari('${d}')`}">${ochiq?d:'🔒 '+d}</button>`;}).join('')}
      </div>
      <div style="text-align:center;padding:50px;">
        <div style="font-size:48px;margin-bottom:14px;">🎉</div>
        <div style="font-size:18px;font-weight:700;margin-bottom:8px;">Bugun uchun takrorlash yo'q!</div>
        <div style="color:var(--kulrang);">Barcha so'zlar o'z vaqtida takrorlangan. Ertaga yangi so'zlar chiqadi.</div>
      </div>`;
    return;
  }
  if(kartochaIndeksi>=kartochaRoyxat.length){
    streakYangilash();
    xpQoshish(kartochaBildim*3);
    document.getElementById('kontent-joy').innerHTML=`
      <div class="sahifa-sarlavha"><h2>Sessiya tugadi! 🎉</h2></div>
      <div style="text-align:center;padding:50px;">
        <div style="font-size:48px;margin-bottom:14px;">🏆</div>
        <div style="font-size:20px;font-weight:700;margin-bottom:8px;">Bugungi takrorlash tugadi!</div>
        <div style="color:var(--kulrang);margin-bottom:8px;">Bilgan so'zlar: <strong style="color:var(--yashil)">${kartochaBildim}</strong> / ${kartochaSessiyaSoni}</div>
        <div style="color:var(--sariq);font-size:13px;margin-bottom:12px;">⭐ +${kartochaBildim*3} XP olindi</div>
        <div style="color:var(--osmon);font-size:13px;margin-bottom:20px;">🔥 Joriy seriya: <strong>${PROGRESS.streak.joriy}</strong> kun</div>
        <button class="k-tugma bildim" style="padding:12px 30px;" onclick="kartochaYangiBoshlash()">🔄 Qayta tekshirish</button>
      </div>`;
    return;
  }
  const [en,uz]=kartochaRoyxat[kartochaIndeksi];
  const holat = sozHolati(kartochaDaraja,en);
  const belgi = holat.level===0?'<span class="srs-daraja-belgi srs-yangi">YANGI</span>':holat.level<3?'<span class="srs-daraja-belgi srs-takror">TAKRORLASH</span>':'<span class="srs-daraja-belgi srs-mustahkam">MUSTAHKAM</span>';
  document.getElementById('kontent-joy').innerHTML=`
    <div class="sahifa-sarlavha">
      <div class="qator"><h2>Kartochkalar — SRS</h2><span class="belgi">${kartochaIndeksi+1}/${kartochaRoyxat.length}</span></div>
      <p>Aqlli takrorlash: bilgan so'zingiz kamroq, bilmagan so'zingiz ko'proq qaytariladi</p>
    </div>
    <div class="daraja-filter">
      ${DARAJA_TARTIBI.map(d=>{const ochiq=darajaOchiqmi(d);return `<button class="daraja-tugma ${kartochaDaraja===d?'tanlangan':''} ${ochiq?'':'qulflangan'}" onclick="${ochiq?`kartochaDarajaTanlash('${d}')`:`darajaQulfXabari('${d}')`}">${ochiq?d:'🔒 '+d}</button>`;}).join('')}
    </div>
    <div class="kartochka-qobiq">
      <div style="margin-bottom:-4px;">${belgi}</div>
      <div class="kartochka-ust ${kartochaAylangan?'aylangan':''}" id="kartochaEl" onclick="kartochaAylantir()">
        <div class="kartochka-ichki">
          <div class="kartochka-yuz old-yuz"><div class="kartochka-soz">🇬🇧 ${en}</div><div class="kartochka-maslahat">Bosing — tarjimani ko'ring</div></div>
          <div class="kartochka-yuz orqa-yuz"><div class="kartochka-tarjima">🇺🇿 ${uz}</div></div>
        </div>
      </div>
      <div class="kartochka-hisoblagich">Bilgan so'zlar: <strong style="color:var(--yashil)">${kartochaBildim}</strong></div>
      <div class="kartochka-tugmalar">
        <button class="k-tugma otkazish" onclick="kartochaBilmadim()">❌ Bilmadim</button>
        <button class="k-tugma bildim" onclick="kartochaBildimni()">✅ Bildim!</button>
      </div>
    </div>`;
}
function kartochaDarajaTanlash(d){if(!darajaOchiqmi(d)){darajaQulfXabari(d);return;}kartochaDaraja=d;kartochaYangiBoshlash();}
function kartochaAylantir(){kartochaAylangan=!kartochaAylangan;const el=document.getElementById('kartochaEl');if(el)el.classList.toggle('aylangan');}
function kartochaBildimni(){
  const [en]=kartochaRoyxat[kartochaIndeksi];
  sozYangilash(kartochaDaraja,en,true);
  kartochaBildim++;kartochaIndeksi++;kartochaAylangan=false;kartochkalarKo_rsatish();
}
function kartochaBilmadim(){
  const [en]=kartochaRoyxat[kartochaIndeksi];
  sozYangilash(kartochaDaraja,en,false);
  kartochaIndeksi++;kartochaAylangan=false;kartochkalarKo_rsatish();
}

/* ── OVOZ (so'zlikdagi 🔊 tugmalari uchun) ── */
function gapirtir(soz){const u=new SpeechSynthesisUtterance(soz);u.lang='en-US';u.rate=0.8;window.speechSynthesis.speak(u);}

/* ================= O'YINLAR (suhbatga yo'naltirilgan, backend kerak emas) ================= */
