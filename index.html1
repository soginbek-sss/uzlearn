  ["sole", [["yagona", "He is the sole owner of the company."], ["tovon (poyabzal)", "The sole of my shoe has come off."]]],
  ["temper", [["jahl", "He lost his temper in the meeting."], ["xarakter", "She has a calm and gentle temper."]]],
  ["square", [["maydon", "We met in the town square at noon."], ["kvadrat", "The table is square, not round."]]],
  ["spell", [["imlo qilmoq", "Can you spell your last name for me?"], ["sehr, afsun", "The witch cast a spell on the prince."]]],
  ["tip", [["maslahat", "Give me a tip for passing the exam."], ["choychaqa (chaevoy)", "Leave a tip for the waiter, please."]]],
  ["suit", [["kostyum", "He wore a black suit to the wedding."], ["mos kelmoq", "This dress will suit you perfectly."]]],
  ["grave", [["qabr", "The old grave is near the church."], ["jiddiy", "The situation is grave and needs urgent action."]]],
  ["trunk", [["daraxt tanasi", "The trunk of this tree is very thick."], ["bagaj (mashina)", "Put the suitcases in the car trunk."]]]
],
"C1":[
  ["compound", [["birikma", "Water is a compound of hydrogen and oxygen."], ["qo'rg'onli hovli", "They live in a compound with high walls."]]],
  ["mole", [["xol (teridagi)", "She has a small mole on her cheek."], ["ko'r kalamush", "A mole dug a long tunnel in the garden."]]],
  ["bolt", [["to'siq (qulf)", "Lock the door with the bolt before you sleep."], ["qochmoq", "The horse may bolt if it gets scared."]]],
  ["mould", [["qolip", "Pour the hot metal into the mould."], ["zamburug'", "There is mould on the old bread."]]],
  ["refuse", [["rad etmoq", "Never refuse help from your good friends."], ["chiqindi", "The refuse is collected every Monday."]]],
  ["conduct", [["xulq-atvor", "His conduct at the meeting was improper."], ["boshqarmoq", "Who will conduct the orchestra tonight?"]]],
  ["project", [["loyiha", "The new project will finish next year."], ["proyeksiyalamoq", "The screen can project images onto the wall."]]],
  ["digest", [["hazm qilmoq", "Your stomach needs time to digest food."], ["qisqa mazmun", "This is a short digest of the report."]]],
  ["console", [["ko'ngil ko'tarmoq", "She tried to console her crying friend."], ["boshqaruv paneli", "The game console is on the table."]]],
  ["tender", [["mayin", "The meat is very tender and easy to cut."], ["taklif (tender)", "The company issued a tender for the new road."]]],
  ["pitch", [["sport maydoni", "The pitch is wet after the heavy rain."], ["ohang", "She has a perfect pitch when she sings."]]],
  ["sow", [["ekmoq", "Farmers sow wheat in the autumn."], ["urg'ochi cho'chqa", "The sow has eight little piglets."]]],
  ["wound", [["yara", "The wound on his hand is healing well."], ["o'ramoq", "She wound the wool around her hand."]]],
  ["dove", [["kaptar", "A dove flew over the roof of the house."], ["sakradi", "He dove into the cold water."]]],
  ["palm", [["kaft", "She rubbed cream into her palm."], ["palma (daraxt)", "A tall palm grows near the beach."]]],
  ["bracket", [["qavs", "Put the number in a bracket."], ["kronshteyn", "Attach the shelf to the wall bracket."]]],
  ["cell", [["hujayra", "The cell is the basic unit of life."], ["uyali telefon", "He called me on his cell."]]],
  ["fit", [["mos kelmoq", "The shoes fit me perfectly."], ["sog'lom", "She is fit and very active."]]],
  ["court", [["sud", "The case went to court last week."], ["ko'ngil olmoq", "He tried to court her with flowers."]]],
  ["organ", [["a'zo", "The heart is a vital organ."], ["organ (musiqa asbobi)", "She played the organ at church."]]],
  ["current", [["oqim", "The current in the river is very strong."], ["hozirgi", "The current situation is difficult."]]],
  ["string", [["ip", "Tie the parcel with a string."], ["torli asbob simi", "She broke a string on her violin."]]],
  ["volume", [["ovoz balandligi", "Turn down the volume, please."], ["jild (kitob)", "This is the first volume of the series."]]],
  ["bond", [["aloqa", "The two friends have a strong bond."], ["obligatsiya", "He bought a government bond last year."]]],
  ["stake", [["ulush", "He has a big stake in the company."], ["tavakkal", "They have a lot at stake in this deal."]]]
]
};
let joriyOmonimDaraja='B1';

/* ── ANTONIMLAR: [so'z, antonim, ma'no, misol] (A1–C1) ── */
const ANTONIMLAR = {
"B2":[
  ["ancient","modern","qadimiy","The ancient castle is more than 500 years old."],
