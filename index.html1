/* bir xil so'z ikki darajada takrorlanmasin (past darajada qoladi) */
[[A2,['neighbor']],[B1,['mistake','deadline']],[C1,['attain','expedite','contemplate','differentiate']]].forEach(([arr,ws])=>{
  for(let i=arr.length-1;i>=0;i--) if(ws.includes(arr[i][0].toLowerCase())) arr.splice(i,1);
});
const SOZLAR_DB = {A1,A2,B1,B2,C1};
const DARAJA_NOMLARI = {A1:"A1 — Boshlang'ich",A2:"A2 — Elementar",B1:"B1 — O'rta",B2:"B2 — Yuqori-o'rta",C1:"C1 — Ilg'or"};
const JAMI_SOZLAR = Object.values(SOZLAR_DB).reduce((s,a)=>s+a.length,0);

/* ================= GRAMMATIKA: MYORFI (MURPHY) USLUBIDAGI 16 UNIT =================
   Eslatma: bu bo'lim mashhur "English Grammar in Use" (Raymond Murphy) kitobining
   unit-ma-unit tuzilishidan ilhomlanib, original misollar bilan yozilgan. */
const GRAMMATIKA_20 = [{"raqam":1,"sarlavha":"To be fe'li — am / is / are","daraja":"A1","tayyor":true,"qoida":"Ingliz tilida 'bo'lmoq' fe'li uch xil shaklda keladi:\nI + am\nHe / She / It + is\nYou / We / They + are\n\nInkor: am not, isn't, aren't. Savol: Am I...? Is he...? Are you...?","ogatish":"Qadam-baqadam: avval kim haqida gapirayotganingizni aniqlang (I, You, He...), so'ng mos shaklni tanlang. Masalan 'U shifokor' — 'U' = She → She IS a doctor. 'Ular talaba' — 'Ular' = They → They ARE students.","misollar":[{"ingliz":"I am from Uzbekistan.","uzbek":"Men O'zbekistondanman."},{"ingliz":"She is a doctor.","uzbek":"U shifokor."},{"ingliz":"We are ready.","uzbek":"Biz tayyormiz."},{"ingliz":"Is he your brother?","uzbek":"U sizning akangizmi?"}],"xato":"Ko'pchilik o'zbeklar 'I student' deb aytadi, chunki o'zbekchada 'talabaman' deyilganda alohida fe'l kerak emas. Inglizchada gapda doim fe'l bo'lishi shart: I AM a student. Shuningdek, 'She are' yoki 'I is' ham noto'g'ri.","mashqlar":[{"savol":"My parents ___ teachers.","variantlar":["is","am","are","be"],"togri":2,"izoh":"My parents = They → are."},{"savol":"___ you tired?","variantlar":["Is","Are","Am","Do"],"togri":1,"izoh":"You bilan 'Are' ishlatiladi."},{"savol":"This ___ my favourite book.","variantlar":["are","am","is","be"],"togri":2,"izoh":"This = It → is."},{"savol":"I ___ not hungry now.","variantlar":["is","are","am","do"],"togri":2,"izoh":"I bilan 'am' ishlatiladi, inkor: am not."}]},{"raqam":2,"sarlavha":"Hozirgi oddiy zamon — Present Simple","daraja":"A1","tayyor":true,"qoida":"Har kuni takrorlanadigan yoki doimiy haqiqat bo'lgan harakatlar uchun ishlatiladi.\nI/You/We/They + fe'l (oddiy shakl)\nHe/She/It + fe'l + s/es\n\nInkor: don't / doesn't + fe'l. Savol: Do/Does + shaxs + fe'l?","ogatish":"Avval tartibni eslang: inglizchada fe'l egadan KEYIN keladi (o'zbekchada esa gap oxirida): 'Men kitob o'qiyman' → I read a book. Keyin shaxsga qarang: He/She/It bo'lsa, fe'lga -s qo'shing (works), qolganlarida fe'l o'zgarmaydi (I work, they work).","misollar":[{"ingliz":"He works in a bank.","uzbek":"U bankda ishlaydi."},{"ingliz":"I don't like coffee.","uzbek":"Men qahvani yoqtirmayman."},{"ingliz":"Does she speak English?","uzbek":"U inglizcha gapiradimi?"},{"ingliz":"Water boils at 100 degrees.","uzbek":"Suv 100 darajada qaynaydi (doimiy haqiqat)."}],"xato":"'She work' emas, 'She works'. Savol ham farq qiladi: o'zbekchada '-mi' qo'shiladi, inglizchada esa gap Do/Does bilan boshlanadi: 'Do you speak English?'","mashqlar":[{"savol":"My sister ___ in a hospital.","variantlar":["work","works","working","to work"],"togri":1,"izoh":"She → fe'lga -s qo'shiladi: works."},{"savol":"___ they live in Tashkent?","variantlar":["Do","Does","Is","Are"],"togri":0,"izoh":"They bilan savolda 'Do' ishlatiladi."},{"savol":"I ___ understand this question.","variantlar":["doesn't","don't","not","isn't"],"togri":1,"izoh":"I bilan inkorda 'don't' ishlatiladi."},{"savol":"The sun ___ in the east.","variantlar":["rise","rises","rising","rose"],"togri":1,"izoh":"The sun = It → fe'lga -s qo'shiladi: rises."}]},{"raqam":3,"sarlavha":"Artikllar — a / an / the","daraja":"A1","tayyor":true,"qoida":"'a' — undosh tovush bilan boshlangan so'z oldida, noaniq narsa uchun.\n'an' — unli TOVUSH bilan boshlangan so'z oldida (harf emas, tovush muhim: an hour, an honest man, lekin a university).\n'the' — ikkala tomonga ham ma'lum, aniq narsa uchun.","ogatish":"Avval so'z noaniqmi yoki aniqmi, shuni hal qiling. Agar birinchi marta aytilayotgan bo'lsa — a/an. Agar ikkinchi marta yoki hammaga ma'lum bo'lsa — the. Keyin so'z qaysi tovush bilan boshlanishini tekshiring: unlimi (an) yoki undoshmi (a).","misollar":[{"ingliz":"I bought a book yesterday.","uzbek":"Men kecha bir kitob sotib oldim."},{"ingliz":"The book was very interesting.","uzbek":"O'sha kitob juda qiziqarli edi."},{"ingliz":"She is an engineer.","uzbek":"U muhandis."},{"ingliz":"The sun rises in the east.","uzbek":"Quyosh sharqdan chiqadi (yagona narsa)."}],"xato":"'a apple' — noto'g'ri, 'apple' unli 'a' bilan boshlanadi, shuning uchun 'an apple' bo'lishi kerak.","mashqlar":[{"savol":"She wants to be ___ doctor.","variantlar":["a","an","the","—"],"togri":0,"izoh":"'Doctor' undosh 'd' bilan boshlanadi → a doctor."},{"savol":"Can you close ___ door, please?","variantlar":["a","an","the","—"],"togri":2,"izoh":"Aniq, ma'lum eshik nazarda tutilyapti → the door."},{"savol":"Ali is ___ honest man. (birinchi marta tilga olinyapti)","variantlar":["a","an","the","—"],"togri":1,"izoh":"'Honest' so'zida 'h' o'qilmaydi, tovush unli 'o' dan boshlanadi → an honest."},{"savol":"___ moon goes around the Earth.","variantlar":["A","An","The","—"],"togri":2,"izoh":"Oy — yagona, hammaga ma'lum narsa → the moon."}]},{"raqam":4,"sarlavha":"Ko'plik son — Plural nouns","daraja":"A1","tayyor":true,"qoida":"Oddiy holatda otga -s qo'shiladi: book→books.\ns, sh, ch, x, z bilan tugasa: -es qo'shiladi: bus→buses.\nUndosh+y bilan tugasa: y→ies: city→cities.\nBa'zi so'zlar tartibsiz: man→men, child→children, woman→women.","ogatish":"Avval so'z qanday tovush bilan tugashiga qarang. Agar s/sh/ch bilan tugasa — es qo'shing. Agar undosh+y bilan tugasa — y ni olib tashlab ies qo'shing. Qolgan holatlarda oddiy -s yetarli.","misollar":[{"ingliz":"I have two brothers.","uzbek":"Mening ikkita akam bor."},{"ingliz":"There are five buses here.","uzbek":"Bu yerda beshta avtobus bor."},{"ingliz":"She visited three cities.","uzbek":"U uchta shaharga tashrif buyurdi."},{"ingliz":"The children are playing.","uzbek":"Bolalar o'ynashyapti (tartibsiz ko'plik)."}],"xato":"O'zbekchada son bilan ko'plik qo'shilmaydi ('uch kitob'), shuning uchun ko'pchilik 'three book' deydi. Inglizchada son bilan ham ko'plik shart: three books. Yana: 'citys' emas, 'cities' (undosh+y → ies).","mashqlar":[{"savol":"How many ___ do you have?","variantlar":["childs","child","children","childrens"],"togri":2,"izoh":"'Child' — tartibsiz, ko'pligi 'children'."},{"savol":"There are many ___ in the box.","variantlar":["boxs","boxes","boxies","box"],"togri":1,"izoh":"'Box' 'x' bilan tugaydi → boxes."},{"savol":"I saw two ___ in the park.","variantlar":["ladys","ladies","ladyes","lady"],"togri":1,"izoh":"Undosh+y → ladies."},{"savol":"These ___ are expensive.","variantlar":["watchs","watches","watchies","watch"],"togri":1,"izoh":"'Watch' 'ch' bilan tugaydi → watches."}]},{"raqam":5,"sarlavha":"Ko'rsatish olmoshlari — this / that / these / those","daraja":"A1","tayyor":true,"qoida":"this (bu) — yaqindagi bitta narsa.\nthat (u / o'sha) — uzoqdagi bitta narsa.\nthese (bular) — yaqindagi ko'p narsa.\nthose (ular / o'shalar) — uzoqdagi ko'p narsa.","ogatish":"Ikkita savolga javob bering: (1) narsa nechta — bittami, ko'pmi? (2) narsa yaqinmi, uzoqmi? Yaqin+bitta=this, Uzoq+bitta=that, Yaqin+ko'p=these, Uzoq+ko'p=those.","misollar":[{"ingliz":"This is my phone.","uzbek":"Bu mening telefonim."},{"ingliz":"That is your house over there.","uzbek":"Ana u yerdagi sizning uyingiz."},{"ingliz":"These are my keys.","uzbek":"Bular mening kalitlarim."},{"ingliz":"Those shoes are nice.","uzbek":"O'sha (narida turgan) poyabzallar chiroyli."}],"xato":"'This books' — noto'g'ri, 'this' faqat birlik bilan keladi. Ko'plik uchun 'these books' bo'lishi kerak.","mashqlar":[{"savol":"___ apples on the table are fresh. (yaqin, ko'p)","variantlar":["This","That","These","Those"],"togri":2,"izoh":"Yaqin + ko'p = these."},{"savol":"Look at ___ mountains far away! (uzoq, ko'p)","variantlar":["this","that","these","those"],"togri":3,"izoh":"Uzoq + ko'p = those."},{"savol":"___ is my new bag. (yaqin, bitta)","variantlar":["This","That","These","Those"],"togri":0,"izoh":"Yaqin + bitta = this."},{"savol":"Who is ___ man standing near the door? (uzoq, bitta)","variantlar":["this","that","these","those"],"togri":1,"izoh":"Uzoq + bitta = that."}]},{"raqam":6,"sarlavha":"Egalik olmoshlari — my / your / his / her / our / their","daraja":"A1","tayyor":true,"qoida":"my — mening, your — sening/sizning, his — uning (erkak), her — uning (ayol), its — uning (narsa/hayvon), our — bizning, their — ularning.\nBular otdan OLDIN keladi: my book, her car.","ogatish":"Avval kimga tegishli ekanligini toping (kim egasi?), keyin o'sha shaxsga mos egalik olmoshini otning oldiga qo'ying. 'Ali kitobi' → his book (chunki Ali = erkak = his).","misollar":[{"ingliz":"This is my sister.","uzbek":"Bu mening opam/singlim."},{"ingliz":"Is this your car?","uzbek":"Bu sizning mashinangizmi?"},{"ingliz":"He lost his phone.","uzbek":"U telefonini yo'qotdi."},{"ingliz":"They love their country.","uzbek":"Ular o'z vatanlarini sevishadi."}],"xato":"'her' va 'his' ni almashtirib yubormang: 'her' — ayolga tegishli narsa, 'his' — erkakka tegishli narsa (egasining jinsiga qarab, narsaning jinsiga emas!).","mashqlar":[{"savol":"Maria lost ___ umbrella.","variantlar":["his","her","their","its"],"togri":1,"izoh":"Maria — ayol → her."},{"savol":"The company changed ___ name last year.","variantlar":["his","her","its","their"],"togri":2,"izoh":"Kompaniya — narsa, shuning uchun its ishlatiladi."},{"savol":"We finished ___ homework early.","variantlar":["my","our","their","your"],"togri":1,"izoh":"We → our."},{"savol":"John and Ali brought ___ books.","variantlar":["his","her","their","our"],"togri":2,"izoh":"John and Ali = they → their."}]},{"raqam":7,"sarlavha":"There is / There are","daraja":"A1","tayyor":true,"qoida":"Biror narsaning mavjudligini aytish uchun ishlatiladi.\nThere is + birlik/sanalmaydigan ot.\nThere are + ko'plik ot.\nInkor: There isn't / There aren't. Savol: Is there...? Are there...?","ogatish":"Avval keyingi ot birlikmi yoki ko'plikmi, shuni aniqlang. Bitta/sanalmaydigan bo'lsa — 'There is', ko'p bo'lsa — 'There are'.","misollar":[{"ingliz":"There is a cat in the garden.","uzbek":"Bog'da bitta mushuk bor."},{"ingliz":"There are three students in the room.","uzbek":"Xonada uchta talaba bor."},{"ingliz":"Is there any milk left?","uzbek":"Sut qolganmi?"},{"ingliz":"There aren't any tickets.","uzbek":"Hech qanday chipta yo'q."}],"xato":"'There is many books' — noto'g'ri, ko'plik bilan 'There ARE' bo'lishi kerak: There are many books.","mashqlar":[{"savol":"___ a bank near here?","variantlar":["Is there","Are there","There is","There are"],"togri":0,"izoh":"Birlik savol: Is there...?"},{"savol":"___ many people at the party.","variantlar":["There is","There are","Is there","Are there"],"togri":1,"izoh":"Ko'plik (many people) → There are."},{"savol":"There ___ any sugar in the jar.","variantlar":["isn't","aren't","don't","not"],"togri":0,"izoh":"'Sugar' sanalmaydigan ot, birlik kabi: isn't."},{"savol":"___ two windows in this room.","variantlar":["There is","There are","Is there","Has"],"togri":1,"izoh":"Ko'plik (two windows) → There are."}]},{"raqam":8,"sarlavha":"O'rin predloglari — in / on / at","daraja":"A1","tayyor":true,"qoida":"in — katta joy ichida (shahar, mamlakat, xona): in Tashkent, in the room.\non — sirtida, yuzasida: on the table, on the wall.\nat — aniq nuqta: at home, at the door, at school.","ogatish":"O'zingizdan so'rang: bu narsa qandaydir joyning ICHIDAmi (in), USTIDAmi (on), yoki bu aniq bir NUQTAmi (at)? Shaharlar va mamlakatlar deyarli doim 'in' bilan keladi.","misollar":[{"ingliz":"I live in Samarkand.","uzbek":"Men Samarqandda yashayman."},{"ingliz":"The book is on the table.","uzbek":"Kitob stol ustida."},{"ingliz":"She is at the bus stop.","uzbek":"U avtobus bekatida."},{"ingliz":"We arrived at the airport.","uzbek":"Biz aeroportga yetib keldik."}],"xato":"'in the bus stop' emas — aniq nuqtalar uchun 'at' ishlatiladi: at the bus stop.","mashqlar":[{"savol":"My keys are ___ my bag. (sumkaning ichida)","variantlar":["in","on","at","to"],"togri":0,"izoh":"Sumka ichida → in."},{"savol":"There is a picture ___ the wall.","variantlar":["in","on","at","under"],"togri":1,"izoh":"Devor yuzasida → on."},{"savol":"I will meet you ___ the entrance.","variantlar":["in","on","at","to"],"togri":2,"izoh":"Aniq nuqta (kirish joyi) → at."},{"savol":"He was born ___ Bukhara.","variantlar":["in","on","at","from"],"togri":0,"izoh":"Shahar nomi bilan → in."}]},{"raqam":9,"sarlavha":"Hozirgi davomli zamon — Present Continuous","daraja":"A2","tayyor":true,"qoida":"am/is/are + fe'l+ing. Hozir, gapirilayotgan paytda sodir bo'layotgan harakat uchun ishlatiladi. Ba'zan yaqin kelajakdagi rejalar uchun ham ishlatiladi.","ogatish":"Avval to be (am/is/are) ni shaxsga mos tanlang, keyin fe'lga -ing qo'shing. 'U yozyapti' → She (is) + write+ing = She is writing.","misollar":[{"ingliz":"I am reading a book now.","uzbek":"Men hozir kitob o'qiyapman."},{"ingliz":"They are playing football.","uzbek":"Ular futbol o'ynashyapti."},{"ingliz":"She is coming tomorrow.","uzbek":"U ertaga kelyapti (reja)."},{"ingliz":"Why are you crying?","uzbek":"Nega yig'layapsiz?"}],"xato":"'like', 'know', 'want' kabi his-tuyg'u fe'llari odatda -ing bilan ishlatilmaydi: 'I am liking' emas, 'I like' to'g'ri.","mashqlar":[{"savol":"Look! It ___ outside.","variantlar":["rains","is raining","rained","rain"],"togri":1,"izoh":"'Look!' — hozir sodir bo'lyapti → is raining."},{"savol":"We ___ dinner right now.","variantlar":["have","are having","has","had"],"togri":1,"izoh":"We → are + having."},{"savol":"She ___ to music at the moment.","variantlar":["listen","listens","is listening","listened"],"togri":2,"izoh":"'At the moment' — hozir → is listening."},{"savol":"I ___ you. I can see you clearly.","variantlar":["am understanding","understand","understood","will understand"],"togri":1,"izoh":"'Understand' his-tuyg'u fe'li, -ing olmaydi: I understand."}]},{"raqam":10,"sarlavha":"Can / Can't — qobiliyat va ruxsat","daraja":"A2","tayyor":true,"qoida":"can — biror narsani qila olish (qobiliyat) yoki ruxsat berish uchun ishlatiladi. Inkor: cannot / can't. Barcha shaxslar uchun bir xil shaklda ishlatiladi, keyingi fe'l 'to'siz keladi.","ogatish":"Can dan keyin doim fe'lning oddiy shakli keladi (to yo'q!). 'U suza oladi' → She can swim (can swims yoki can to swim emas).","misollar":[{"ingliz":"I can speak three languages.","uzbek":"Men uch tilda gapira olaman."},{"ingliz":"She can't drive a car.","uzbek":"U mashina hayday olmaydi."},{"ingliz":"Can I open the window?","uzbek":"Derazani ocha olamanmi? (ruxsat so'rash)"},{"ingliz":"Can you help me, please?","uzbek":"Menga yordam bera olasizmi?"}],"xato":"'She can to swim' yoki 'She cans swim' — ikkalasi ham noto'g'ri. To'g'risi: 'She can swim' (to yo'q, -s ham qo'shilmaydi).","mashqlar":[{"savol":"My brother ___ play the piano very well.","variantlar":["cans","can to","can","canning"],"togri":2,"izoh":"Can barcha shaxslar uchun bir xil, -s qo'shilmaydi."},{"savol":"___ you swim?","variantlar":["Do can","Can","Cans","Are can"],"togri":1,"izoh":"Savolda 'Can' shaxsdan oldin keladi."},{"savol":"I ___ understand this word.","variantlar":["can't","don't can","can not to","cann't"],"togri":0,"izoh":"Inkor: can't (yoki cannot)."},{"savol":"Birds ___ fly, but penguins can't.","variantlar":["can to","cans","can","canning"],"togri":2,"izoh":"Can + fe'l (to'siz): can fly."}]},{"raqam":11,"sarlavha":"O'tgan oddiy zamon — Past Simple","daraja":"A2","tayyor":true,"qoida":"O'tgan zamonda boshlanib tugagan harakat uchun ishlatiladi (yesterday, last week, in 2019, two days ago).\nMuntazam fe'llar: fe'l + ed (work → worked, like → liked, study → studied, stop → stopped).\nTartibsiz fe'llar: alohida shakl (go → went, see → saw, have → had, eat → ate, buy → bought, come → came).\nInkor: didn't + fe'lning oddiy shakli. Savol: Did + ega + fe'lning oddiy shakli?","ogatish":"1) Gapda o'tgan vaqt belgisini toping (yesterday, last year, ago). 2) Fe'l muntazammi? Unda -ed qo'shing. Tartibsizmi? Ikkinchi shaklni ro'yxatdan oling. 3) Inkor yoki savol bo'lsa, o'tgan zamonni did o'zi ko'taradi, asosiy fe'l esa oddiy shaklga QAYTADI: She went → Did she go? → She didn't go.","misollar":[{"ingliz":"I visited my grandmother last Sunday.","uzbek":"Men o'tgan yakshanba buvimnikiga bordim."},{"ingliz":"She went to Samarkand two years ago.","uzbek":"U ikki yil oldin Samarqandga bordi."},{"ingliz":"We didn't see the film.","uzbek":"Biz filmni ko'rmadik."},{"ingliz":"Did you buy a new phone?","uzbek":"Yangi telefon sotib oldingizmi?"}],"xato":"O'zbekchada o'tgan zamon har doim fe'lning o'ziga qo'shiladi (bordim, bormadim, bordingmi). Inglizchada esa savol va inkorda o'tgan zamon did ga o'tadi, asosiy fe'l o'zgarmaydi. Xato: 'Did you went?' va 'I didn't saw'. To'g'risi: 'Did you go?' va 'I didn't see'.","mashqlar":[{"savol":"We ___ a great film last night.","variantlar":["watched","watching","watches","watch"],"togri":0,"izoh":"'Last night' — o'tgan vaqt, muntazam fe'l: watch + ed."},{"savol":"She ___ to school yesterday.","variantlar":["went","gone","go","goes"],"togri":0,"izoh":"'Go' tartibsiz fe'l, o'tgan zamoni 'went'."},{"savol":"I didn't ___ the answer.","variantlar":["knows","know","knew","knowed"],"togri":1,"izoh":"Inkorda didn't dan keyin fe'lning oddiy shakli keladi: didn't know."},{"savol":"___ you visit your aunt last week?","variantlar":["Do","Did","Were","Have"],"togri":1,"izoh":"'Last week' — o'tgan zamon savoli: Did + ega + oddiy fe'l."}]},{"raqam":12,"sarlavha":"Savol so'zlari va Do/Does/Did savollari","daraja":"A2","tayyor":true,"qoida":"Savol so'zlari: What (nima), Where (qayerda), When (qachon), Who (kim), Why (nega), How (qanday), Which (qaysi), How much / How many (qancha).\nTuzilishi: savol so'zi + yordamchi fe'l (do / does / did / am / is / are) + ega + asosiy fe'l?\nMisol: Where do you live? What did she buy? Why is he late?\nIstisno: Who yoki What gapning egasi bo'lsa, yordamchi fe'l kerak emas: Who lives here?","ogatish":"Savolni to'rt qadamda quring: 1) savol so'zini boshiga qo'ying; 2) zamonga qarab yordamchi fe'lni tanlang (hozir: do/does, o'tgan: did, to be: am/is/are); 3) egani yozing; 4) asosiy fe'lni oddiy shaklda qo'ying. 'Sen qayerda ishlaysan?' → Where + do + you + work?","misollar":[{"ingliz":"Where do you work?","uzbek":"Siz qayerda ishlaysiz?"},{"ingliz":"What did she say?","uzbek":"U nima dedi?"},{"ingliz":"Why is he late?","uzbek":"U nega kech qoldi?"},{"ingliz":"How much does this bag cost?","uzbek":"Bu sumka necha pul turadi?"}],"xato":"O'zbekchada savol so'zi gap ichida turaveradi ('Sen qayerda yashaysan?'). Inglizchada savol so'zi gap boshida, undan keyin yordamchi fe'l va ega keladi. Xato: 'Where you live?' va 'What you want?'. To'g'risi: 'Where do you live?' va 'What do you want?'.","mashqlar":[{"savol":"___ does she work? — In a bank.","variantlar":["Who","How many","Where","Why"],"togri":2,"izoh":"Javob joyni bildiryapti (in a bank), demak Where."},{"savol":"What time ___ the lesson start every day?","variantlar":["do","did","does","is"],"togri":2,"izoh":"The lesson = it, hozirgi zamon: does + oddiy fe'l (start)."},{"savol":"Why ___ you late yesterday?","variantlar":["do","are","were","did"],"togri":2,"izoh":"'Late' sifat, demak to be kerak; 'yesterday' tufayli o'tgan zamon: were."},{"savol":"How many books ___ she read last month?","variantlar":["did","has","do","does"],"togri":0,"izoh":"'Last month' — o'tgan zamon: did + ega + oddiy fe'l."}]},{"raqam":13,"sarlavha":"Solishtirish darajalari — Comparatives & Superlatives","daraja":"A2","tayyor":true,"qoida":"Ikki narsani solishtirish — qiyosiy daraja + than. Uch va undan ko'p narsa ichida eng — orttirma daraja, oldidan the.\nQisqa sifat (1 bo'g'in): tall → taller → the tallest. Oxiri -e: nice → nicer → the nicest. Undosh+y (2 bo'g'inli ham): happy → happier → the happiest. Bitta unli+undosh: big → bigger → the biggest.\nUzun sifat (-y bilan tugamaydigan 2 va undan ko'p bo'g'inli sifatlar): beautiful → more beautiful → the most beautiful.\nTartibsiz: good → better → the best, bad → worse → the worst.","ogatish":"1) Nechta narsa solishtirilyapti? Ikkita bo'lsa — qiyosiy daraja va than; ko'p narsa ichidan eng — the + orttirma daraja. 2) Sifat qisqami? Unda -er/-est. Uzunmi? Unda more/most. 3) Tartibsiz sifatlarni yodlab oling: good-better-best, bad-worse-worst.","misollar":[{"ingliz":"My brother is taller than me.","uzbek":"Akam mendan balandroq."},{"ingliz":"This book is more interesting than that one.","uzbek":"Bu kitob u kitobdan qiziqarliroq."},{"ingliz":"She is the best student in our class.","uzbek":"U sinfimizdagi eng yaxshi o'quvchi."},{"ingliz":"Tashkent is the biggest city in Uzbekistan.","uzbek":"Toshkent O'zbekistondagi eng katta shahar."}],"xato":"O'zbekchada '-roq' (kattaroq) va 'eng' (eng katta) so'zlari bor, inglizchada esa bir sifatga ikki marta belgi qo'yib bo'lmaydi. Xato: 'more taller', 'more better', 'the most tallest'. To'g'risi: 'taller', 'better', 'the tallest'. Solishtirishda than ni ham unutmang: 'taller than me'.","mashqlar":[{"savol":"Mount Everest is ___ mountain in the world.","variantlar":["the highest","most high","higher","high"],"togri":0,"izoh":"Dunyodagi hamma tog'lar ichida eng baland: the + highest."},{"savol":"This test is ___ than the last one.","variantlar":["easy","more easy","easiest","easier"],"togri":3,"izoh":"Ikkita narsa, than bor, qisqa sifat: easy → easier."},{"savol":"Her English is ___ than mine.","variantlar":["best","more good","good","better"],"togri":3,"izoh":"Good tartibsiz sifat: good → better → best."},{"savol":"This is the ___ film I have ever seen.","variantlar":["more boring","most boring","boringest","bored"],"togri":1,"izoh":"'Boring' uzun sifat, eng yuqori daraja: the most boring."}]},{"raqam":14,"sarlavha":"O'tgan davomli zamon — Past Continuous","daraja":"B1","tayyor":true,"qoida":"Shakli: was / were + fe'l-ing. I, he, she, it → was; you, we, they → were.\nIshlatilishi: 1) o'tmishdagi aniq paytda davom etayotgan harakat (At 8 o'clock I was studying); 2) ikki harakat bir vaqtda davom etgan (while); 3) uzoq harakat davomida qisqa harakat sodir bo'ldi: uzoq harakat Past Continuous, qisqasi Past Simple (when).","ogatish":"Gapda ikkita harakat bormi? Uzun, davom etgan harakat → was/were + -ing. Qisqa, uni \"to'xtatgan\" harakat → Past Simple. 'Men ovqat pishirayotgan edim, telefon jiringladi' → I WAS COOKING when the phone RANG.","misollar":[{"ingliz":"At 8 o'clock yesterday, I was studying.","uzbek":"Kecha soat 8 da men dars qilayotgan edim."},{"ingliz":"She was reading while he was watching TV.","uzbek":"U (ayol) kitob o'qiyotgan paytda, u (erkak) televizor ko'rayotgan edi."},{"ingliz":"I was walking home when it started to rain.","uzbek":"Men uyga piyoda ketayotganimda yomg'ir yog'a boshladi."},{"ingliz":"They weren't listening.","uzbek":"Ular tinglamayotgan edi."}],"xato":"O'zbekchada '-ayotgan edi' shakli bor, lekin ko'pchilik inglizchada oddiy o'tgan zamonni ishlatib yuboradi. Davom etgan harakat uchun was/were + -ing kerak. Shuningdek 'We was' xato, to'g'risi 'We were'.","mashqlar":[{"savol":"I ___ TV when the lights went out. (televizor ko'rish davom etayotgan edi)","variantlar":["was watching","watched","am watching","were watching"],"togri":0,"izoh":"Uzoq harakat (televizor ko'rish) Past Continuous, I bilan was."},{"savol":"They ___ football at 5 o'clock yesterday. (o'sha paytda o'yin davom etayotgan edi)","variantlar":["was playing","were playing","played","are playing"],"togri":1,"izoh":"Aniq paytda davom etgan harakat; They bilan were."},{"savol":"What ___ you doing at 9 p.m. last night?","variantlar":["did","do","were","was"],"togri":2,"izoh":"You bilan were ishlatiladi: What were you doing?"},{"savol":"My sister started her letter at 7:30 and finished at 9:00. At 8 o'clock yesterday she ___ a letter.","variantlar":["wrote","were writing","writes","was writing"],"togri":3,"izoh":"Aniq paytda (soat 8) harakat davom etayotgan edi: was writing."}]},{"raqam":15,"sarlavha":"Modal fe'llar — must / should / have to","daraja":"B1","tayyor":true,"qoida":"must — kuchli majburiyat: You must stop at a red light.\nmustn't — TAQIQ: You mustn't smoke here.\nhave to — tashqi majburiyat (qoida, vaziyat): I have to get up early. He has to work. O'tgan zamon: had to.\ndon't have to — SHART EMAS (xohlasangiz qilasiz, xohlamasangiz yo'q): You don't have to pay.\nshould — maslahat: You should drink more water.\nBu fe'llardan keyin to'siz fe'l keladi (must go, should go).","ogatish":"Gapning ma'nosini aniqlang: majburmi (must / have to), taqiqmi (mustn't), shart emasmi (don't have to) yoki shunchaki maslahatmi (should)? Eng ko'p xato: mustn't ≠ don't have to. 'Kelmaslik kerak' va 'kelish shart emas' butunlay boshqa ma'no.","misollar":[{"ingliz":"You must stop at a red light.","uzbek":"Qizil chiroqda to'xtashingiz shart."},{"ingliz":"You mustn't smoke here.","uzbek":"Bu yerda chekish mumkin emas."},{"ingliz":"I have to get up early tomorrow.","uzbek":"Ertaga erta turishim kerak."},{"ingliz":"You don't have to pay. It's free.","uzbek":"To'lashingiz shart emas. Bepul."},{"ingliz":"You should drink more water.","uzbek":"Ko'proq suv ichishingiz kerak (maslahat)."}],"xato":"O'zbekchada 'kerak emas' va 'mumkin emas' ba'zan bir xil eshitiladi. Inglizchada 'mustn't' — taqiq, 'don't have to' — shart emas. Yana: modal fe'ldan keyin 'to' qo'yilmaydi ('must to go' xato) va 'He must goes' ham xato. To'g'risi: 'He must go'; 'He has to go'.","mashqlar":[{"savol":"You ___ park here. It's forbidden.","variantlar":["mustn't","needn't to","not must","don't have to"],"togri":0,"izoh":"Taqiqlangan (forbidden) → mustn't."},{"savol":"Tomorrow is a holiday, so we ___ go to school.","variantlar":["mustn't","can't to","must","don't have to"],"togri":3,"izoh":"Dam olish kuni — borish shart emas: don't have to."},{"savol":"She has a bad cough. She ___ see a doctor.","variantlar":["must to","should","shoulds","have to"],"togri":1,"izoh":"Maslahat → should. 'She have to' ham xato (has to bo'lardi)."},{"savol":"I ___ work on Sundays. My boss makes me.","variantlar":["has to","must to","have to","should to"],"togri":2,"izoh":"Tashqi majburiyat, I bilan have to."}]},{"raqam":16,"sarlavha":"Hozirgi tugallangan zamon — Present Perfect","daraja":"B1","tayyor":true,"qoida":"Shakli: have / has + fe'lning 3-shakli (V3). I/you/we/they have, he/she/it has. Muntazam V3: worked, played. Tartibsiz: been, gone, seen, done, eaten, written, taken.\nIshlatilishi: 1) hayotdagi tajriba (ever, never): I have been to Turkey. 2) hozirga ta'sir qiluvchi natija: I have lost my keys. 3) hozirgacha davom etayotgan holat: I have lived here for five years / since 2020. 4) just, already, yet bilan.\nAniq o'tgan vaqt (yesterday, last year, in 2020, ago) bilan ISHLATILMAYDI — u yerda Past Simple.","ogatish":"Gapda aniq o'tgan vaqt aytilganmi? Ha → Past Simple. Yo'q, yoki harakat hozirgacha davom etayotgan bo'lsa → Present Perfect. For + davr (for 3 years), since + boshlanish nuqtasi (since 2020, since Monday).","misollar":[{"ingliz":"I have never eaten sushi.","uzbek":"Men hech qachon sushi yemaganman."},{"ingliz":"She has lived here since 2018.","uzbek":"U 2018-yildan beri shu yerda yashaydi."},{"ingliz":"They have just arrived.","uzbek":"Ular hozirgina yetib kelishdi."},{"ingliz":"Have you finished your homework yet?","uzbek":"Uy vazifangizni tugatdingizmi?"}],"xato":"O'zbekchada 'borganman' va 'bordim' ikkalasi ham o'tgan zamon, shuning uchun ko'pchilik farqni sezmaydi. Inglizchada farq katta. Xato: 'I have seen him yesterday' — to'g'risi 'I saw him yesterday'. Xato: 'I am living here for five years' — to'g'risi 'I have lived here for five years'.","mashqlar":[{"savol":"I have never ___ to Japan.","variantlar":["being","be","been","was"],"togri":2,"izoh":"Have + V3. Be fe'lining V3 shakli: been."},{"savol":"She ___ here since 2019.","variantlar":["lives","lived","has lived","is living"],"togri":2,"izoh":"'Since' (boshlanish nuqtasi) bilan Present Perfect: has lived."},{"savol":"We ___ him yesterday.","variantlar":["saw","see","has seen","have seen"],"togri":0,"izoh":"'Yesterday' — aniq o'tgan vaqt, demak Past Simple: saw."},{"savol":"___ you finished your homework yet?","variantlar":["Did","Are","Has","Have"],"togri":3,"izoh":"'Yet' bilan savol Present Perfect'da: Have you finished...?"}]},{"raqam":17,"sarlavha":"Kelasi zamon — will vs going to","daraja":"B1","tayyor":true,"qoida":"will + fe'l: 1) gapirayotgan paytda qabul qilingan qaror ('Sut yo'q.' — 'Men olib kelaman.' → I'll get some); 2) fikringizga asoslangan bashorat (I think it will rain); 3) va'da va taklif (I'll help you).\nam/is/are going to + fe'l: 1) oldindan rejalashtirilgan niyat (I'm going to study medicine); 2) hozir ko'rinib turgan belgiga asoslangan bashorat (Look at those clouds! It's going to rain).","ogatish":"O'zingizga ikki savol bering: 1) Qaror hozir, shu daqiqada qabul qilindimi? → will. 2) Reja oldindan tayyor edimi yoki ko'z oldimizda aniq belgi bormi? → going to. Mashqlardagi qavs ichidagi izoh (reja, hozir qaror) sizga yo'l ko'rsatadi.","misollar":[{"ingliz":"'I'm thirsty.' — 'I'll get you some water.'","uzbek":"'Chanqadim.' — 'Men sizga suv olib kelaman.' (hozirgi qaror)"},{"ingliz":"I'm going to study medicine next year.","uzbek":"Men kelasi yil tibbiyotni o'qimoqchiman. (oldindan reja)"},{"ingliz":"Look at the sky! It's going to rain.","uzbek":"Osmonga qarang! Yomg'ir yog'adigan bo'ldi. (belgi bor)"},{"ingliz":"I think she will win.","uzbek":"Menimcha, u g'alaba qozonadi. (fikr)"}],"xato":"O'zbekchada kelasi zamon bitta shaklda ('boraman'), shuning uchun ko'pchilik hamma joyda faqat 'will' ishlatadi. Oldindan rejalashtirilgan ishda 'going to' tabiiyroq. Yana: 'I will to go' va 'I am going to went' xato. To'g'risi: 'I will go'; 'I am going to go'.","mashqlar":[{"savol":"(oldindan reja) We have bought the tickets. We ___ visit Bukhara next month.","variantlar":["are going to","are going","go to","are going visit"],"togri":0,"izoh":"Chiptalar allaqachon olingan, reja bor: are going to."},{"savol":"(hozir qaror qildingiz) 'We have no bread.' — 'OK, I ___ buy some.'","variantlar":["am going","go to","will","going to"],"togri":2,"izoh":"Qaror gapirayotgan paytda qabul qilindi: will. Boshqa variantlarning shakli noto'g'ri."},{"savol":"(ko'z oldingizda belgi bor) Look! That car ___ crash!","variantlar":["goes to","will","is going to","is going"],"togri":2,"izoh":"Ko'rinib turgan belgi asosida bashorat: is going to."},{"savol":"(fikr, bashorat) I think Uzbekistan ___ win the match.","variantlar":["is going","will","going to","wills"],"togri":1,"izoh":"'I think' bilan fikrga asoslangan bashorat: will win."}]},{"raqam":18,"sarlavha":"1-tur shart gaplar — First Conditional","daraja":"B2","tayyor":true,"qoida":"Kelajakda amalga oshishi mumkin bo'lgan shart va uning natijasi.\nTuzilishi: If + Present Simple, will + fe'l. Misol: If it rains, we will stay at home.\nIf gapi oldin kelsa, vergul qo'yiladi; keyin kelsa, vergul shart emas: We will stay at home if it rains.\nMuhim: if dan keyingi qismda odatda will ishlatilmaydi (kelajak ma'nosi bo'lsa ham). Unless = if ... not (Unless you hurry = If you don't hurry).","ogatish":"Gapni ikkiga bo'ling. Shart qismi (If ...) — hozirgi zamon, kelajak ma'nosida bo'lsa ham. Natija qismi — will + fe'l. 'Agar yomg'ir yog'sa, uyda qolamiz' → If it RAINS (hozirgi), we WILL stay (will).","misollar":[{"ingliz":"If it rains, we will stay at home.","uzbek":"Agar yomg'ir yog'sa, uyda qolamiz."},{"ingliz":"If you study hard, you will pass the exam.","uzbek":"Agar qattiq o'qisangiz, imtihondan o'tasiz."},{"ingliz":"She will be angry if you don't call her.","uzbek":"Agar unga qo'ng'iroq qilmasangiz, u g'azablanadi."},{"ingliz":"If I see him, I will tell him.","uzbek":"Agar uni ko'rsam, unga aytaman."}],"xato":"O'zbekchada shart '-sa' qo'shimchasi bilan ifodalanadi ('yog'sa'), kelasi zamon ma'nosi o'zi bilinadi. Inglizchada ham shart qismida kelajak ma'nosi bor, lekin fe'l hozirgi zamonda turadi. Xato: 'If it will rain, we will stay'. To'g'risi: 'If it rains, we will stay'.","mashqlar":[{"savol":"If it ___ tomorrow, we will cancel the picnic.","variantlar":["rains","would rain","will rain","rain"],"togri":0,"izoh":"Shart qismida will yo'q: it + rains."},{"savol":"If you ___ hard, you will pass the exam.","variantlar":["will study","studied","study","would study"],"togri":2,"izoh":"If dan keyin hozirgi zamon: study."},{"savol":"I will call you if I ___ time.","variantlar":["have","would have","had","will have"],"togri":0,"izoh":"If dan keyin will ishlatilmaydi: if I have time."},{"savol":"If you don't hurry, you ___ the last bus tonight.","variantlar":["would miss","missed","miss","will miss"],"togri":3,"izoh":"Natija qismi: will + fe'l."}]},{"raqam":19,"sarlavha":"Majhul nisbat — Passive Voice","daraja":"B2","tayyor":true,"qoida":"Majhul nisbatda harakatni bajaruvchi emas, harakat yo'nalgan narsa muhim bo'ladi.\nShakli: be + fe'lning 3-shakli (V3).\nHozirgi: is / are + V3 (English is spoken here). O'tgan: was / were + V3 (The bridge was built in 1995). Kelasi: will be + V3 (The letter will be sent tomorrow).\nKim qilganini aytish kerak bo'lsa, by qo'shiladi: The window was broken by the boy.","ogatish":"Bajaruvchi noma'lum yoki muhim emasmi? Unda passiv. 1) Narsani gap boshiga qo'ying. 2) be fe'lini zamoniga qarab tanlang. 3) Asosiy fe'lni V3 ga o'zgartiring. 4) Kerak bo'lsa oxiriga by + kim qo'shing.","misollar":[{"ingliz":"This bridge was built in 1995.","uzbek":"Bu ko'prik 1995-yilda qurilgan."},{"ingliz":"English is spoken all over the world.","uzbek":"Ingliz tilida butun dunyoda gaplashiladi."},{"ingliz":"The documents will be sent tomorrow.","uzbek":"Hujjatlar ertaga yuboriladi."},{"ingliz":"The window was broken by the boy.","uzbek":"Deraza bola tomonidan sindirilgan."}],"xato":"O'zbekchada majhul nisbat fe'lga -il / -in qo'shimchasi bilan yasaladi ('qurildi', 'yoziladi'). Inglizchada faqat V3 yetmaydi, oldidan be kerak. Xato: 'The house built in 1990'. To'g'risi: 'The house was built in 1990'. Yana: happen, arrive, die kabi fe'llar passivga o'tmaydi ('was happened' xato).","mashqlar":[{"savol":"This mosque ___ in the 15th century.","variantlar":["is built","has build","was built","built"],"togri":2,"izoh":"O'tgan zamon, majhul nisbat: was + V3."},{"savol":"Many languages ___ in Uzbekistan.","variantlar":["speak","spoke","is spoken","are spoken"],"togri":3,"izoh":"Many languages ko'plik, hozirgi zamon: are + V3."},{"savol":"The report ___ tomorrow.","variantlar":["will be sent","sent","will send","is sending"],"togri":0,"izoh":"Kelasi zamon majhul nisbat: will be + V3."},{"savol":"The thief ___ by the police yesterday.","variantlar":["caught","is caught","was caught","catches"],"togri":2,"izoh":"Yesterday va by the police: was caught."}]},{"raqam":20,"sarlavha":"Ko'chirma gap — Reported Speech","daraja":"B2","tayyor":true,"qoida":"Birovning gapini o'z so'zlarimiz bilan aytib berish. Odatda said (that) / told + shaxs ishlatiladi.\nZamon odatda bir pog'ona ORQAGA suriladi (o'rganish uchun asosiy qoida shu): am/is/are → was/were; do/does → did; will → would; can → could; Past Simple → Past Perfect (had + V3).\nOlmosh va vaqt so'zlari ham o'zgaradi: I → he/she, today → that day, tomorrow → the next day, here → there.\nSavolda: asked + if / whether (ha-yo'q savol) yoki savol so'zi; gap tartibi oddiy bo'ladi (do/does/did ishlatilmaydi).","ogatish":"Qadamlar: 1) Kim aytganini yozing (He said ...). 2) Zamonni bir pog'ona orqaga suring. 3) Olmosh va vaqt so'zlarini moslang. 4) Savol bo'lsa, if yoki savol so'zidan keyin oddiy tartibda yozing. 'Do you like tea?' he asked → He asked if I liked tea.","misollar":[{"ingliz":"'I am tired,' he said. → He said he was tired.","uzbek":"'Charchadim,' dedi u. → U charchaganini aytdi."},{"ingliz":"'I will call you,' she said. → She said she would call me.","uzbek":"'Sizga qo'ng'iroq qilaman,' dedi u. → U menga qo'ng'iroq qilishini aytdi."},{"ingliz":"'Do you like tea?' he asked. → He asked if I liked tea.","uzbek":"'Choy yoqadimi?' deb so'radi u. → U menga choy yoqadimi, deb so'radi."},{"ingliz":"'I bought a car,' Ali said. → Ali said he had bought a car.","uzbek":"'Mashina sotib oldim,' dedi Ali. → Ali mashina sotib olganini aytdi."}],"xato":"O'zbekchada ko'chirma gapni egalik qo'shimchalari bilan oson aytib beramiz va zamon deyarli o'zgarmaydi. Inglizchada zamon orqaga suriladi. Xato: 'He said he is tired' (hozir ham to'g'ri bo'lsa mumkin, lekin o'rganish uchun qoida: was). Savolda ham xato ko'p: 'He asked where do I live' — to'g'risi 'He asked where I lived'.","mashqlar":[{"savol":"(qoida bo'yicha zamonni orqaga suring) 'I am hungry,' she said. → She said she ___ hungry.","variantlar":["was","is","has been","were"],"togri":0,"izoh":"Am → was, olmosh I → she."},{"savol":"(qoida bo'yicha) 'I will help you,' he said. → He said he ___ help me.","variantlar":["can","would","will","shall"],"togri":1,"izoh":"Will → would."},{"savol":"(qoida bo'yicha) 'I bought a car,' Ali said. → Ali said he ___ a car.","variantlar":["has bought","buys","had bought","bought"],"togri":2,"izoh":"Past Simple → Past Perfect: had bought."},{"savol":"'Do you like tea?' he asked me. → He asked me ___ tea.","variantlar":["do I like","that I liked","if did I like","if I liked"],"togri":3,"izoh":"Ha-yo'q savolda if + oddiy tartib, zamon orqaga: if I liked."}]},{"raqam":21,"sarlavha":"Sanaladigan / sanalmaydigan — some / any / much / many","daraja":"A2","tayyor":true,"qoida":"Sanaladigan otlar (countable): book → books, apple → apples, student → students.\nSanalmaydigan otlar (uncountable): water, milk, money, time, rice, advice, information, news.\nsome — darak gapda: I have some friends.   any — inkor va savolda: I don't have any money. Do you have any questions?\nTaklif va iltimosda ham some: Would you like some tea?\nmany — sanaladigan ko'plik bilan: How many books? There aren't many chairs.\nmuch — sanalmaydigan bilan: How much water? We don't have much time.\nDarak gapda ko'pincha a lot of ishlatiladi: She has a lot of money.","ogatish":"Avval otni tekshiring: uni 1, 2, 3 deb sanab bo'ladimi? Ha bo'lsa — many; yo'q bo'lsa — much. Keyin gap turiga qarang: darak — some, inkor yoki savol — any.","misollar":[{"ingliz":"There are some apples on the table.","uzbek":"Stol ustida bir nechta olma bor."},{"ingliz":"I don't have any money.","uzbek":"Mening pulim yo'q."},{"ingliz":"How many students are in your class?","uzbek":"Sinfingizda nechta o'quvchi bor?"},{"ingliz":"How much time do we have?","uzbek":"Qancha vaqtimiz bor?"}],"xato":"O'zbekchada 'ko'p' bitta so'z, inglizchada esa sanaladigan va sanalmaydigan otlar uchun har xil so'z kerak. Xato: 'much students', 'many water'. Yana bir tuzoq: o'zbekchada sanaladigan tuyulgan so'zlar inglizchada sanalmaydi (advice, information, news). Xato: 'an advice', 'informations'. To'g'risi: 'some advice', 'some information'.","mashqlar":[{"savol":"There isn't ___ milk in the fridge.","variantlar":["any","many","a","some"],"togri":0,"izoh":"Inkor gapda any ishlatiladi; milk sanalmaydi, shuning uchun many va a mos kelmaydi."},{"savol":"How ___ people came to the party?","variantlar":["much","any","some","many"],"togri":3,"izoh":"People sanaladi, savolda many ishlatiladi: How many people?"},{"savol":"I need ___ advice.","variantlar":["some","an","a few","many"],"togri":0,"izoh":"Advice sanalmaydigan ot: some advice (an advice yoki many advice emas)."},{"savol":"We don't have ___ time.","variantlar":["some","much","many","a lot"],"togri":1,"izoh":"Time sanalmaydi, inkorda much ishlatiladi: We don't have much time."}]},{"raqam":22,"sarlavha":"To'ldiruvchi olmoshlar — me / him / her / us / them","daraja":"A2","tayyor":true,"qoida":"Ega olmoshlari gapning boshida turadi: I, you, he, she, it, we, they.\nTo'ldiruvchi olmoshlari fe'ldan yoki predlogdan keyin turadi:\nI → me, you → you, he → him, she → her, it → it, we → us, they → them.\nMisol: Can you help me? I like them. Give it to her. Come with us.","ogatish":"Olmosh fe'ldan oldin tursa, bu ega: HE likes tea. Fe'ldan yoki predlogdan keyin tursa, to'ldiruvchi shakli kerak: I like HIM. Talk to HER.","misollar":[{"ingliz":"Can you help me, please?","uzbek":"Iltimos, menga yordam bera olasizmi?"},{"ingliz":"I see him every day.","uzbek":"Men uni har kuni ko'raman."},{"ingliz":"She is talking to us.","uzbek":"U biz bilan gaplashyapti."},{"ingliz":"These books are interesting. I read them often.","uzbek":"Bu kitoblar qiziqarli. Men ularni tez-tez o'qiyman."}],"xato":"O'zbekchada 'meni, menga, men bilan' qo'shimchalar bilan ifodalanadi. Inglizchada esa bu uchun alohida so'z bor. Xato: 'I like she', 'Give I the book', 'He called I'. To'g'risi: 'I like her', 'Give me the book', 'He called me'.","mashqlar":[{"savol":"Where is Ali? I want to talk to ___.","variantlar":["himself","he","him","his"],"togri":2,"izoh":"Predloqdan (to) keyin to'ldiruvchi shakli kerak: him."},{"savol":"My parents are here. I love ___ very much.","variantlar":["they","their","them","theirs"],"togri":2,"izoh":"Fe'ldan (love) keyin: them."},{"savol":"Can you help ___? I don't understand.","variantlar":["my","me","mine","I"],"togri":1,"izoh":"Fe'ldan (help) keyin: me."},{"savol":"Anna is my sister. I often call ___.","variantlar":["she","hers","he","her"],"togri":3,"izoh":"Fe'ldan (call) keyin: her."}]},{"raqam":23,"sarlavha":"Takrorlanish ravishlari — always / usually / often / never","daraja":"A2","tayyor":true,"qoida":"Qanchalik tez-tez bo'lishini bildiradi:\nalways (100%) → usually → often → sometimes → rarely / seldom → never (0%).\nJoyi: to be fe'lidan KEYIN, boshqa fe'ldan OLDIN.\nHe is always late. I usually get up at 7. She never eats meat.\nSometimes gap boshida yoki oxirida ham kelishi mumkin: Sometimes I walk to work.\nSavol: How often do you...? Javob: every day, twice a week, once a month.","ogatish":"Gapda to be fe'li bormi (am/is/are/was/were)? Unda ravish uning orqasida. To be yo'qmi? Unda ravish asosiy fe'ldan oldin.","misollar":[{"ingliz":"I always drink tea in the morning.","uzbek":"Men ertalab doim choy ichaman."},{"ingliz":"She is never late for work.","uzbek":"U ishga hech qachon kech qolmaydi."},{"ingliz":"We sometimes go to the park.","uzbek":"Biz ba'zan bog'ga boramiz."},{"ingliz":"How often do you visit your grandmother?","uzbek":"Buvingizni qanchalik tez-tez ko'rgani borasiz?"}],"xato":"O'zbekchada 'doim', 'ba'zan' gapning istalgan joyiga qo'yiladi. Inglizchada joyi qat'iy. Xato: 'I go always to school', 'She plays usually football'. To'g'risi: 'I always go to school', 'She usually plays football'.","mashqlar":[{"savol":"She ___ late for class.","variantlar":["never is","does never be","never be","is never"],"togri":3,"izoh":"To be fe'li bor, ravish undan keyin turadi: is never."},{"savol":"(0%) I ___ drink coffee in the evening.","variantlar":["usually","often","always","never"],"togri":3,"izoh":"0% — never."},{"savol":"My brother ___ to the gym on Sundays.","variantlar":["goes usually to","goes usually","usually goes","usually go"],"togri":2,"izoh":"Ravish asosiy fe'ldan oldin keladi; he/brother bilan goes."},{"savol":"___ do you visit your grandmother? — Once a week.","variantlar":["How much","How long","How often","How many"],"togri":2,"izoh":"Javob takrorlanishni bildiryapti (once a week): How often."}]},{"raqam":24,"sarlavha":"Vaqt predloglari — in / on / at","daraja":"A2","tayyor":true,"qoida":"at — aniq vaqt va payt: at 7 o'clock, at noon, at midnight, at night, at the weekend.\non — kunlar va sanalar: on Monday, on 5 May, on my birthday, on Sunday morning.\nin — oylar, yillar, fasllar, kunning qismlari: in July, in 2024, in summer, in the morning, in the evening.\nIstisno: odatda at night, lekin in the morning / in the afternoon / in the evening.","ogatish":"Katta-kichikdan o'ylang: eng kichik birlik (soat) — at; o'rtadagi (kun, sana) — on; eng katta (oy, yil, fasl) — in.","misollar":[{"ingliz":"The lesson starts at 9 o'clock.","uzbek":"Dars soat 9 da boshlanadi."},{"ingliz":"My birthday is on 12 March.","uzbek":"Mening tug'ilgan kunim 12-martda."},{"ingliz":"We go on holiday in August.","uzbek":"Biz avgustda ta'tilga chiqamiz."},{"ingliz":"I like to read at night.","uzbek":"Men kechasi kitob o'qishni yaxshi ko'raman."}],"xato":"O'zbekchada vaqt qo'shimchalar bilan ('soat 9 da', 'dushanbada', 'avgustda') beriladi va farq sezilmaydi. Inglizchada esa har birining o'z predlogi bor. Xato: 'in Monday', 'at July', 'on 2024'. To'g'risi: 'on Monday', 'in July', 'in 2024'.","mashqlar":[{"savol":"The lesson starts ___ 9 o'clock.","variantlar":["on","by","at","in"],"togri":2,"izoh":"Aniq soat bilan at ishlatiladi."},{"savol":"My birthday is ___ 12 March.","variantlar":["in","on","at","to"],"togri":1,"izoh":"Sana bilan on ishlatiladi."},{"savol":"We usually go on holiday ___ August.","variantlar":["on","to","at","in"],"togri":3,"izoh":"Oy bilan in ishlatiladi."},{"savol":"I like to read ___ night.","variantlar":["at","by","in","on"],"togri":0,"izoh":"'At night' — istisno, in the night emas."}]},{"raqam":25,"sarlavha":"Fe'l + -ing yoki to + fe'l (like doing / want to do)","daraja":"A2","tayyor":true,"qoida":"Ba'zi fe'llardan keyin fe'l -ing shaklida keladi (enjoy, finish, mind, stop, keep, avoid; stop to do boshqa ma'no beradi, 38-mavzuga qarang): I enjoy swimming. She finished writing.\nBoshqalaridan keyin to + fe'l keladi (want, need, hope, decide, plan, learn, would like): I want to learn English. They decided to leave.\nlike, love, hate, start ikkala shakl bilan ham ishlatiladi: I like swimming = I like to swim.\nModal fe'ldan keyin to qo'yilmaydi: I can swim.","ogatish":"Fe'lni yodlab oling: enjoy, finish, mind → -ing; want, need, hope, decide → to. Modal bo'lmagan fe'llardan keyin ikkinchi fe'lni oddiy shaklda qoldirmang: 'I want go' xato.","misollar":[{"ingliz":"I enjoy learning English.","uzbek":"Men ingliz tilini o'rganishdan zavq olaman."},{"ingliz":"She wants to become a doctor.","uzbek":"U shifokor bo'lmoqchi."},{"ingliz":"He finished doing his homework at eight.","uzbek":"U uy vazifasini soat sakkizda tugatdi."},{"ingliz":"We decided to cancel the trip.","uzbek":"Biz sayohatni bekor qilishga qaror qildik."}],"xato":"O'zbekchada ikkinchi fe'l bitta shaklda ('o'qishni xohlayman', 'o'qishdan zavqlanaman'). Inglizchada esa fe'lga qarab shakl o'zgaradi. Xato: 'I want go', 'I enjoy to read', 'She decided leaving'. To'g'risi: 'I want to go', 'I enjoy reading', 'She decided to leave'.","mashqlar":[{"savol":"I enjoy ___ English.","variantlar":["learn","learned","learning","to learn"],"togri":2,"izoh":"Enjoy dan keyin -ing: enjoy learning."},{"savol":"She wants ___ a doctor.","variantlar":["become","became","becoming","to become"],"togri":3,"izoh":"Want dan keyin to + fe'l: wants to become."},{"savol":"He finished ___ his homework at 8.","variantlar":["doing","does","to do","do"],"togri":0,"izoh":"Finish dan keyin -ing: finished doing."},{"savol":"We decided ___ the trip.","variantlar":["cancel","to cancel","cancelling","cancelled"],"togri":1,"izoh":"Decide dan keyin to + fe'l: decided to cancel."}]},{"raqam":26,"sarlavha":"Egalik kelishigi — 's va whose","daraja":"A2","tayyor":true,"qoida":"Odamga tegishli narsani 's bilan yasaymiz: Ali's book, my sister's room.\nKo'plik -s bilan tugasa, faqat apostrof qo'shamiz: the students' room (bir nechta o'quvchi).\nKo'plik -s bilan tugamasa, 's qo'shamiz: the children's toys, the men's shoes.\nNarsalar uchun ko'pincha of ishlatiladi: the door of the room, the colour of the car.\nSavol: Whose book is this? — It's Ali's.","ogatish":"Egasi odammi? Unda 's. Bitta egami? Unda 's. Ko'plikda -s bilan tugagan so'zdan keyin faqat '. Egasi narsami (xona, mashina)? Unda of.","misollar":[{"ingliz":"This is my brother's car.","uzbek":"Bu mening akamning mashinasi."},{"ingliz":"The children's toys are on the floor.","uzbek":"Bolalarning o'yinchoqlari polda."},{"ingliz":"The door of the room is blue.","uzbek":"Xonaning eshigi ko'k."},{"ingliz":"Whose phone is this? — It's Madina's.","uzbek":"Bu kimning telefoni? — Madinaniki."}],"xato":"O'zbekchada egalik '-ning' va '-i' bilan beriladi ('akamning mashinasi'). Inglizchada tartib teskari: egasi oldin, narsa keyin. Xato: 'the car my brother', 'Alis book'. To'g'risi: 'my brother's car', 'Ali's book', 'the door of the room' (narsalar uchun odatda of).","mashqlar":[{"savol":"___ phone is this? — It's Madina's.","variantlar":["Whose","Who","What","Who's"],"togri":0,"izoh":"Kimning narsasi ekanini so'rash uchun Whose."},{"savol":"The ___ toys are on the floor. (ko'p bola)","variantlar":["childrens'","children's","childs","children"],"togri":1,"izoh":"Children ko'plik, lekin -s bilan tugamaydi, shuning uchun 's: children's."},{"savol":"The colour ___ is blue.","variantlar":["house of","houses","the house's","of the house"],"togri":3,"izoh":"Narsaning rangi uchun of: the colour of the house."},{"savol":"That is my ___ room. (bitta opa)","variantlar":["sisters","sister","sisters'","sister's"],"togri":3,"izoh":"Bitta egasi bor: sister's."}]},{"raqam":27,"sarlavha":"Avvalgi odat — used to","daraja":"B1","tayyor":true,"qoida":"used to + fe'lning oddiy shakli — o'tmishda takrorlanib turgan, lekin endi yo'q odat yoki holat.\nI used to play football. (Endi o'ynamayman.)  She used to live in Samarkand.\nInkor: didn't use to + fe'l. Savol: Did you use to + fe'l?\nChalkashtirmang: be used to + -ing — 'ko'nikkan': I am used to getting up early.","ogatish":"Savol: bu hozir ham shundaymi? Yo'q, avval shunday edi — used to + fe'l. Ko'nikma haqida gap ketyaptimi? Unda am/is/are used to + -ing.","misollar":[{"ingliz":"I used to live in Samarkand.","uzbek":"Men ilgari Samarqandda yashardim."},{"ingliz":"We used to play chess every evening.","uzbek":"Biz ilgari har oqshom shaxmat o'ynardik."},{"ingliz":"Did you use to smoke?","uzbek":"Siz ilgari chekarmidingiz?"},{"ingliz":"I am used to getting up early.","uzbek":"Men erta turishga ko'nikkanman."}],"xato":"O'zbekchada 'o'ynardim' shakli bor, lekin ko'pchilik inglizchada oddiy o'tgan zamonni ishlatadi. Xato: 'I used to going', 'I didn't used to play'. To'g'risi: 'I used to go', 'I didn't use to play'. Savol va inkorda d yo'qoladi.","mashqlar":[{"savol":"I ___ live in Samarkand, but now I live in Tashkent.","variantlar":["used to","am used to","was used","use to"],"togri":0,"izoh":"Avval shunday edi, endi yo'q: used to + fe'l."},{"savol":"Did you ___ play chess as a child?","variantlar":["used to","using to","used","use to"],"togri":3,"izoh":"Savolda did bor, shuning uchun use to (d siz)."},{"savol":"I am used to ___ up early.","variantlar":["getting","get","to get","got"],"togri":0,"izoh":"Be used to dan keyin -ing: getting."},{"savol":"When I was a child, we ___ every summer at my grandparents' house.","variantlar":["use to stay","are used to staying","used to stay","used staying"],"togri":2,"izoh":"O'tmishdagi takrorlangan odat: used to stay."}]},{"raqam":28,"sarlavha":"O'tgan tugallangan zamon — Past Perfect","daraja":"B1","tayyor":true,"qoida":"Shakli: had + fe'lning 3-shakli (V3). Barcha shaxslarda had.\nIshlatilishi: o'tmishdagi ikki voqeadan avval bo'lganini ko'rsatadi.\nWhen I arrived, the film had already started. (Avval film boshlangan, keyin men keldim.)\nInkor: hadn't + V3. Savol: Had + ega + V3?\nBelgilar: before, after, by the time, already, just.","ogatish":"Ikkita o'tgan harakatni toping. Qaysi biri OLDIN bo'lgan? Oldingisi — had + V3, keyingisi — Past Simple. Vaqt chizig'ini ko'z oldingizga keltiring: avval → keyin.","misollar":[{"ingliz":"When we arrived, the film had already started.","uzbek":"Biz yetib kelganimizda film allaqachon boshlangan edi."},{"ingliz":"She had studied English before she moved to London.","uzbek":"U Londonga ko'chishdan oldin ingliz tilini o'rgangan edi."},{"ingliz":"I couldn't get in because I had left my key at home.","uzbek":"Men kira olmadim, chunki kalitni uyda qoldirgan edim."},{"ingliz":"After he had eaten dinner, he watched TV.","uzbek":"Kechki ovqatni yeb bo'lgach, u televizor ko'rdi."}],"xato":"O'zbekchada '-gan edi' shakli bor, lekin ko'pchilik uni ishlatmaydi va ikki voqeani ham oddiy o'tgan zamonda aytadi. Natijada qaysi biri avval bo'lgani yo'qoladi. Xato: 'When I arrived, he already left'. To'g'risi: 'When I arrived, he had already left'.","mashqlar":[{"savol":"(kalit oldin qoldirilgan) I couldn't get in because I ___ my key at home.","variantlar":["was leaving","left","had left","have left"],"togri":2,"izoh":"Qoldirish eshikni ochishga urinishdan oldin bo'lgan: had left."},{"savol":"By the time we arrived, the concert ___.","variantlar":["has finished","had finished","finishes","was finish"],"togri":1,"izoh":"By the time bilan oldin tugagan harakat: had finished."},{"savol":"(ko'chishdan oldin o'qigan) She ___ English before she moved to London.","variantlar":["had studied","has studied","studies","was studying"],"togri":0,"izoh":"O'qish ko'chishdan oldin bo'lgan: had studied."},{"savol":"After he ___ dinner, he watched TV.","variantlar":["had eaten","eats","is eating","has eaten"],"togri":0,"izoh":"Ovqat yeyish televizor ko'rishdan oldin tugagan: had eaten."}]},{"raqam":29,"sarlavha":"Hozirgi tugallanmagan davomli — Present Perfect Continuous","daraja":"B1","tayyor":true,"qoida":"Shakli: have / has + been + fe'l-ing.\nIshlatilishi: 1) hozirgacha davom etayotgan jarayon (for / since bilan): I have been learning English for two years. 2) hozirgina tugagan va izi ko'rinib turgan harakat: Your hands are dirty. — I have been working in the garden.\nHolat fe'llari (know, like, love, understand, have — egalik ma'nosida) davomli shaklda ishlatilmaydi: I have known him for ten years.","ogatish":"Savol: jarayon muhimmi yoki natija? Jarayon va davomiylik (qancha vaqt) — have been -ing. Natija yoki son (3 ta kitob) — oddiy Present Perfect.","misollar":[{"ingliz":"I have been learning English for two years.","uzbek":"Men ikki yildan beri ingliz tilini o'rganyapman."},{"ingliz":"She is tired because she has been working all day.","uzbek":"U charchagan, chunki kun bo'yi ishlagan."},{"ingliz":"We have been waiting for an hour.","uzbek":"Biz bir soatdan beri kutyapmiz."},{"ingliz":"I have known him for ten years.","uzbek":"Men uni o'n yildan beri bilaman."}],"xato":"O'zbekchada 'o'rganyapman' davom etayotgan harakatni bildiradi va 'ikki yildan beri' qo'shilsa ham shakl o'zgarmaydi. Inglizchada esa for/since bilan hozirgi oddiy zamon ishlatilmaydi. Xato: 'I am learning English for two years'. To'g'risi: 'I have been learning English for two years'. Holat fe'llarida: 'I have been knowing' xato.","mashqlar":[{"savol":"I ___ English for two years.","variantlar":["have been learning","learn","was learning","am learning"],"togri":0,"izoh":"For two years bilan hozirgacha davom etgan jarayon: have been learning."},{"savol":"She is tired. She ___ in the garden since morning.","variantlar":["worked","works","has been working","is working"],"togri":2,"izoh":"Since morning — hozirgacha davom etgan jarayon va natija ko'rinib turibdi: has been working."},{"savol":"We ___ waiting for an hour.","variantlar":["had","have been","are","was"],"togri":1,"izoh":"For an hour — davom etgan jarayon: have been waiting."},{"savol":"(hali ham tanishman) I ___ him for ten years.","variantlar":["have been knowing","have known","am knowing","knew"],"togri":1,"izoh":"Know holat fe'li, davomli shaklda ishlatilmaydi: have known."}]},{"raqam":30,"sarlavha":"2-tur shart gaplar — Second Conditional","daraja":"B1","tayyor":true,"qoida":"Hozirgi yoki kelajakdagi xayoliy, real bo'lmagan vaziyat.\nTuzilishi: If + Past Simple, would + fe'l.\nIf I had a million dollars, I would buy a house. (Menda million dollar yo'q.)\nIf I were you, I would study more. (Maslahat berish.)\nTo be fe'li standart tilda barcha shaxslarda were bo'ladi (If I were, if she were); norasmiy nutqda was ham uchraydi.\nIf qismida odatda would ishlatilmaydi.","ogatish":"Vaziyat real emasmi (hozir bunday emas, bo'lishi ham qiyin)? Unda: If + Past Simple, would + fe'l. 'Agar boy bo'lsam' (lekin boy emasman) → If I were rich, I would...","misollar":[{"ingliz":"If I were rich, I would travel the world.","uzbek":"Agar boy bo'lganimda, butun dunyo bo'ylab sayohat qilgan bo'lardim."},{"ingliz":"If she studied more, she would pass the exam.","uzbek":"Agar u ko'proq o'qisa, imtihondan o'tardi."},{"ingliz":"I would buy a big house if I had more money.","uzbek":"Pulim ko'proq bo'lsa, katta uy sotib olardim."},{"ingliz":"If I were you, I wouldn't do that.","uzbek":"Sizning o'rningizda bo'lsam, buni qilmasdim."}],"xato":"O'zbekchada '-sa' va '-ardi' qo'shimchalari bor, lekin 1-tur va 2-tur gaplar bir xil eshitiladi. Inglizchada farq bor: real shart — If + Present, will; xayoliy shart — If + Past, would. Xato: 'If I would have money, I would buy', 'If I will be rich'. To'g'risi: 'If I had money, I would buy'.","mashqlar":[{"savol":"If I ___ rich, I would travel the world.","variantlar":["were","would be","am","will be"],"togri":0,"izoh":"Xayoliy shartda to be — were."},{"savol":"If she studied more, she ___ the exam.","variantlar":["will pass","passes","would pass","passed"],"togri":2,"izoh":"Natija qismida would + fe'l."},{"savol":"I would buy a big house if I ___ more money.","variantlar":["had","would have","will have","have"],"togri":0,"izoh":"If qismida Past Simple: had."},{"savol":"If I ___ you, I wouldn't do that.","variantlar":["be","will be","am","were"],"togri":3,"izoh":"Maslahat berishda If I were you."}]},{"raqam":31,"sarlavha":"Aniqlovchi gaplar — who / which / that / where / whose","daraja":"B1","tayyor":true,"qoida":"Aniqlovchi gap otni tushuntiradi.\nwho — odam uchun: The woman who lives next door is a teacher.\nwhich — narsa uchun: This is the book which I told you about.\nthat — odam va narsa uchun (who / which o'rniga): The book that I bought is interesting.\nwhere — joy uchun: That is the restaurant where we had dinner.\nwhose — egalik uchun: He is the man whose car was stolen.\nAniqlovchi gap otdan KEYIN keladi. Agar who / which gapning egasi bo'lmasa, uni tushirish mumkin: The book (that) I bought.","ogatish":"Ikkita gapni birlashtiring: 'The woman is a teacher. She lives next door.' → 'The woman who lives next door is a teacher.' Savol: ot odammi (who), narsami (which), joymi (where) yoki kimningdir narsasimi (whose)?","misollar":[{"ingliz":"The woman who lives next door is a teacher.","uzbek":"Qo'shni uyda yashaydigan ayol o'qituvchi."},{"ingliz":"This is the book which I told you about.","uzbek":"Bu men sizga aytgan kitob."},{"ingliz":"That is the restaurant where we had dinner.","uzbek":"Bu biz kechki ovqatlangan restoran."},{"ingliz":"He is the man whose car was stolen.","uzbek":"Bu mashinasi o'g'irlangan odam."}],"xato":"O'zbekchada aniqlovchi gap ot OLDIDA keladi ('men yashaydigan shahar'). Inglizchada ot oldin, aniqlovchi gap keyin. Xato: 'The city where I live in' (in ortiqcha). To'g'risi: 'The city where I live'. Yana: 'The man who he lives here' xato, to'g'risi 'The man who lives here'.","mashqlar":[{"savol":"The woman ___ lives next door is a teacher.","variantlar":["where","whose","which","who"],"togri":3,"izoh":"Odam uchun who."},{"savol":"This is the book ___ I told you about.","variantlar":["who","whose","where","which"],"togri":3,"izoh":"Narsa uchun which."},{"savol":"That is the restaurant ___ we had dinner.","variantlar":["which","whom","who","where"],"togri":3,"izoh":"Joy uchun where."},{"savol":"He is the man ___ car was stolen.","variantlar":["who","that","which","whose"],"togri":3,"izoh":"Kimningdir mashinasi — egalik: whose."}]},{"raqam":32,"sarlavha":"Ortiqcha va yetarli — too / enough","daraja":"B1","tayyor":true,"qoida":"too + sifat — kerakdan ortiq (salbiy natija): The tea is too hot. (Ichib bo'lmaydi.)\nsifat + enough — yetarli: He is old enough to drive.\nenough + ot — yetarli miqdor: We have enough money.\nnot + sifat + enough — yetarli emas: She is not tall enough.\ntoo much (sanalmaydigan) / too many (sanaladigan) — haddan ko'p: too much noise, too many people.","ogatish":"Too salbiy ma'no beradi ('ortiqcha', 'bo'lmaydi'). Enough esa 'kifoya': sifatdan KEYIN, otdan OLDIN turadi. Joyini yodlang: tall enough, enough money.","misollar":[{"ingliz":"The tea is too hot. I can't drink it.","uzbek":"Choy juda issiq. Men uni icha olmayman."},{"ingliz":"He is old enough to drive.","uzbek":"U mashina haydash uchun yetarlicha katta."},{"ingliz":"We don't have enough money to buy a car.","uzbek":"Mashina sotib olishga pulimiz yetmaydi."},{"ingliz":"There are too many people here.","uzbek":"Bu yerda odam haddan ziyod ko'p."}],"xato":"O'zbekchada 'juda' ham 'haddan ziyod' ham bo'la oladi. Inglizchada very (shunchaki juda) va too (kerakdan ortiq) boshqa narsa. Xato: 'enough tall', 'too much people'. To'g'risi: 'tall enough', 'too many people'.","mashqlar":[{"savol":"The tea is ___ hot. I can't drink it.","variantlar":["enough","too","more","much"],"togri":1,"izoh":"Ichib bo'lmaydigan darajada issiq: too hot."},{"savol":"He is not tall ___ to play basketball.","variantlar":["very","too","enough","so"],"togri":2,"izoh":"Sifatdan keyin enough: tall enough."},{"savol":"We don't have ___ money to buy a car.","variantlar":["very","so","too","enough"],"togri":3,"izoh":"Otdan oldin enough: enough money."},{"savol":"There are ___ many people here. I can't find a seat.","variantlar":["too","so much","very much","enough"],"togri":0,"izoh":"Sanaladigan ko'plik bilan too many."}]},{"raqam":33,"sarlavha":"Qaytariluvchi savollar — Question Tags","daraja":"B1","tayyor":true,"qoida":"Gap oxiridagi qisqa savol ('shundaymi?', 'to'g'rimi?').\nDarak gap bo'lsa, tag inkor: You are a student, aren't you?\nInkor gap bo'lsa, tag darak: She doesn't like tea, does she?\nTag gapdagi yordamchi fe'l bilan tuziladi: can → can't he, did → didn't they, has → hasn't she.\nYordamchi fe'l yo'q (Present Simple) bo'lsa — do / does: You like tea, don't you?\nMaxsus: I am late, aren't I? Let's go, shall we?","ogatish":"Uch qadam: 1) gapdagi yordamchi fe'lni toping (am/is/are, do/does/did, have, can, will); 2) uni teskari ma'noda qo'ying (darak → inkor, inkor → darak); 3) oxirida egani olmosh bilan yozing (Ali → he).","misollar":[{"ingliz":"You are Ali, aren't you?","uzbek":"Siz Alisiz, shunday emasmi?"},{"ingliz":"She doesn't speak French, does she?","uzbek":"U fransuzcha gapirmaydi, to'g'rimi?"},{"ingliz":"They went to the party, didn't they?","uzbek":"Ular ziyofatga bordi, shunday emasmi?"},{"ingliz":"He can swim, can't he?","uzbek":"U suza oladi, to'g'rimi?"}],"xato":"O'zbekchada 'to'g'rimi?', 'shundaymi?' bitta qolipda hamma gapga qo'shiladi. Inglizchada esa har bir gapning o'z tagi bor. Xato: 'You are Ali, isn't it?', 'She likes tea, isn't she?'. To'g'risi: 'You are Ali, aren't you?', 'She likes tea, doesn't she?'.","mashqlar":[{"savol":"You are Ali, ___?","variantlar":["aren't you","don't you","isn't you","are you"],"togri":0,"izoh":"Darak gap — inkor tag: aren't you."},{"savol":"She doesn't speak French, ___?","variantlar":["does she","is she","do she","doesn't she"],"togri":0,"izoh":"Inkor gap — darak tag: does she."},{"savol":"They went to the party, ___?","variantlar":["did they","didn't they","don't they","weren't they"],"togri":1,"izoh":"Went (Past Simple) darak — didn't they."},{"savol":"He can swim, ___?","variantlar":["isn't he","can't he","can he","doesn't he"],"togri":1,"izoh":"Can darak — can't he."}]},{"raqam":34,"sarlavha":"3-tur shart gaplar — Third Conditional","daraja":"B2","tayyor":true,"qoida":"O'tmishdagi, endi o'zgartirib bo'lmaydigan xayoliy vaziyat va pushaymonlik.\nTuzilishi: If + Past Perfect (had + V3), would have + V3.\nIf I had studied harder, I would have passed the exam. (Lekin yaxshi o'qimadim, o'tolmadim.)\nInkor: If I hadn't missed the bus, I wouldn't have been late.\nIf qismida odatda would have ishlatilmaydi.","ogatish":"O'tmishga qarang: nima bo'lgan, agar boshqacha bo'lsa nima bo'lardi? Shart qismida had + V3, natija qismida would have + V3.","misollar":[{"ingliz":"If I had studied harder, I would have passed the exam.","uzbek":"Agar qattiqroq o'qiganimda, imtihondan o'tgan bo'lardim."},{"ingliz":"If she had left earlier, she would have caught the train.","uzbek":"Agar u erta chiqqanida, poyezdga ulgurgan bo'lardi."},{"ingliz":"We wouldn't have got wet if we had taken an umbrella.","uzbek":"Soyabon olganimizda, ho'l bo'lmagan bo'lardik."},{"ingliz":"If he had asked me, I would have helped him.","uzbek":"Agar u mendan so'raganida, unga yordam bergan bo'lardim."}],"xato":"O'zbekchada o'tmish shartida ham '-sa' va '-ardi' ishlatiladi, farq sezilmaydi. Inglizchada har bir qismda murakkab shakl kerak. Xato: 'If I would have studied', 'If I studied, I would pass' (o'tmish uchun). To'g'risi: 'If I had studied, I would have passed'.","mashqlar":[{"savol":"If I ___ harder, I would have passed the exam.","variantlar":["have studied","studied","had studied","would study"],"togri":2,"izoh":"If qismida had + V3: had studied."},{"savol":"If she had left earlier, she ___ the train.","variantlar":["would catch","would have caught","caught","had caught"],"togri":1,"izoh":"Natija qismida would have + V3."},{"savol":"We wouldn't have got wet if we ___ an umbrella.","variantlar":["had taken","would take","would have taken","took"],"togri":0,"izoh":"If qismida had taken."},{"savol":"If he ___ me, I would have helped him.","variantlar":["asked","had asked","has asked","would ask"],"togri":1,"izoh":"If qismida had asked."}]},{"raqam":35,"sarlavha":"Istak va afsus — wish / if only","daraja":"B2","tayyor":true,"qoida":"wish + Past Simple — hozirgi vaziyatdan norozilik: I wish I had a car. (Mashinam yo'q.)\nwish + were — I wish I were taller. Standart tilda barcha shaxslarda were (norasmiy nutqda was ham uchraydi).\nwish + Past Perfect — o'tmish afsusi: I wish I had studied. (O'qimadim.)\nwish + would — birovning xatti-harakatidan shikoyat: I wish you would stop talking.\nIf only — kuchliroq: If only I had more time!\nIstak yoki afsus ma'nosidagi wish dan keyin hozirgi zamon ishlatilmaydi.","ogatish":"Qaysi vaqt haqida afsuslanyapsiz? Hozir — Past Simple; o'tmish — Past Perfect; kelajakda boshqa birovdan o'zgarishni xohlasangiz — would.","misollar":[{"ingliz":"I wish I had more free time.","uzbek":"Qani endi bo'sh vaqtim ko'proq bo'lsa."},{"ingliz":"I wish I had studied harder last year.","uzbek":"Qani endi o'tgan yili qattiqroq o'qiganimda edi."},{"ingliz":"I wish it would stop raining.","uzbek":"Qani endi yomg'ir to'xtasa."},{"ingliz":"If only I could help you.","uzbek":"Qani endi sizga yordam bera olsam."}],"xato":"O'zbekchada 'qani endi' bilan fe'l shakli o'zgarmay qoladi. Inglizchada wish dan keyin zamon bir pog'ona orqaga suriladi. Xato: 'I wish I have a car', 'I wish I can help'. To'g'risi: 'I wish I had a car', 'I wish I could help'.","mashqlar":[{"savol":"I wish I ___ more free time now.","variantlar":["had","will have","would have","have"],"togri":0,"izoh":"Hozirgi norozilik: wish + Past Simple (had)."},{"savol":"(afsus) I wish I ___ harder last year.","variantlar":["study","would study","studied","had studied"],"togri":3,"izoh":"O'tmish afsusi: wish + Past Perfect (had studied)."},{"savol":"I wish it ___ raining. (shikoyat)","variantlar":["stopping","stops","would stop","has stop"],"togri":2,"izoh":"Shikoyat: wish + would + fe'l."},{"savol":"I wish I ___ you, but I don't know the answer.","variantlar":["can help","could help","will help","helped"],"togri":1,"izoh":"Wish dan keyin can emas, could."}]},{"raqam":36,"sarlavha":"Taxmin qilish — must / might / can't be","daraja":"B2","tayyor":true,"qoida":"Biror narsaga qanchalik ishonchimizni ko'rsatadi:\nmust be — deyarli aniq (~95%): He has been working all day. He must be tired.\nmight / may / could be — ehtimol (~50%): She might be at home.\ncan't be — deyarli mumkin emas: That can't be Ali's car. He doesn't have one.\nO'tmish uchun: must have + V3, might have + V3, can't have + V3. It must have rained last night.","ogatish":"Qanchalik ishonchingiz komil? Dalil bor va aniq xulosa — must; ishonch yo'q, o'ylab ko'ryapsiz — might; dalil boshqa narsani aytyapti — can't.","misollar":[{"ingliz":"He works 12 hours a day. He must be very tired.","uzbek":"U kuniga 12 soat ishlaydi. U juda charchagan bo'lsa kerak."},{"ingliz":"That can't be Ali's car. He doesn't have one.","uzbek":"Bu Alining mashinasi bo'la olmaydi. Uning mashinasi yo'q."},{"ingliz":"I'm not sure where he is. He might be at the library.","uzbek":"U qayerda ekanini bilmayman. Kutubxonada bo'lishi mumkin."},{"ingliz":"The ground is wet. It must have rained last night.","uzbek":"Yer ho'l. Kecha yomg'ir yoqqan bo'lsa kerak."}],"xato":"O'zbekchada 'bo'lsa kerak' va 'bo'lishi mumkin' ko'pincha aralashib ketadi, inglizchada esa must (deyarli aniq), might (ehtimol) va can't (mumkin emas) alohida. Yana: must dan keyin to qo'yilmaydi va o'tmishda must have + V3 kerak. Xato: 'He must to be tired', 'It must rained'. To'g'risi: 'He must be tired', 'It must have rained'.","mashqlar":[{"savol":"He works 12 hours every day. He ___ very tired.","variantlar":["can't be","must to be","must be","might to be"],"togri":2,"izoh":"Dalil bor, xulosa deyarli aniq: must be."},{"savol":"That ___ be Ali's car. Ali doesn't have a car.","variantlar":["must","might","can't","should"],"togri":2,"izoh":"Dalil teskarisini aytyapti: can't be."},{"savol":"I'm not sure where Ali is. He ___ at the library.","variantlar":["can't be","will be","might be","must be"],"togri":2,"izoh":"Ishonch yo'q: might be."},{"savol":"The ground is wet. It ___ last night.","variantlar":["can't have rained","might rains","must have rained","must rain"],"togri":2,"izoh":"O'tmish haqida xulosa: must have + V3."}]},{"raqam":37,"sarlavha":"Boshqa kishiga qildirish — have / get something done","daraja":"B2","tayyor":true,"qoida":"have + narsa + V3 — biz o'zimiz qilmaymiz, boshqa odam bizning uchun qiladi.\nI had my car repaired. (Men o'zim tuzatmadim, boshqa kishiga tuzattirdim.)\nShe is having her hair cut. He has his teeth checked every six months.\nInformalda get ham ishlatiladi: I got my phone fixed.\nFaqat I cut my hair desak, odatda o'zimiz kesganimiz bildiriladi.","ogatish":"Savol: ishni kim qildi? O'zingiz — oddiy zamon. Boshqa kishi (usta, vrach, sartarosh) — have + narsa + V3.","misollar":[{"ingliz":"I had my car repaired yesterday.","uzbek":"Men kecha mashinamni ustaga tuzattirdim."},{"ingliz":"She is going to have her hair cut.","uzbek":"U sochini oldirmoqchi."},{"ingliz":"He has his teeth checked every six months.","uzbek":"U har olti oyda tishlarini tekshirtiradi."},{"ingliz":"We are having the house painted.","uzbek":"Biz uyni bo'yatyapmiz."}],"xato":"O'zbekchada '-dirmoq' qo'shimchasi bor ('tuzattirdim', 'oldirdim'), lekin ko'pchilik inglizchada oddiy fe'l ishlatib, o'zi qilgan ma'nosini beradi. Xato: 'I cut my hair at the barber's' (o'zingiz kesgandek). To'g'risi: 'I had my hair cut at the barber's'.","mashqlar":[{"savol":"I ___ my car repaired yesterday.","variantlar":["made","was","did","had"],"togri":3,"izoh":"Boshqa kishi tuzatgan: had + narsa + V3."},{"savol":"She is going to ___ her hair cut.","variantlar":["have","had","having","has"],"togri":0,"izoh":"Going to dan keyin fe'lning oddiy shakli: have."},{"savol":"He ___ his teeth checked every six months.","variantlar":["is","does","has","makes"],"togri":2,"izoh":"Odat, he bilan has + narsa + V3."},{"savol":"Qaysi gap 'sartarosh kesdi' ma'nosini beradi?","variantlar":["I cut my hair at home.","I cut my hair myself.","I had my hair cut.","I was cutting hair."],"togri":2,"izoh":"Boshqa kishi qilgan ishni have + narsa + V3 bildiradi."}]},{"raqam":38,"sarlavha":"Ma'noni o'zgartiruvchi fe'llar — stop / remember / try","daraja":"B2","tayyor":true,"qoida":"Ba'zi fe'llardan keyin -ing yoki to + fe'l kelsa, ma'no o'zgaradi:\nstop doing — qilishni to'xtatmoq: He stopped smoking. (Tashladi.)\nstop to do — boshqa ish uchun to'xtamoq: He stopped to smoke. (Chekish uchun to'xtadi.)\nremember doing — bajarilganini eslamoq: I remember locking the door.\nremember to do — esda tutib qilmoq: Remember to lock the door.\ntry doing — sinab ko'rmoq: Try drinking warm milk.\ntry to do — urinib ko'rmoq (qiyin): I tried to open the window, but it was stuck.\nforget doing / forget to do — xuddi remember kabi.","ogatish":"-ing — harakat allaqachon bo'lgan yoki sinov; to + fe'l — maqsad yoki hali bajarilmagan ish. Savol bering: harakat bo'lib o'tdimi (-ing) yoki hali qilinishi kerakmi (to)?","misollar":[{"ingliz":"He stopped smoking last year.","uzbek":"U o'tgan yili chekishni tashladi."},{"ingliz":"I must remember to post the letter.","uzbek":"Xatni jo'natishni unutmasligim kerak."},{"ingliz":"I remember locking the door. I'm sure it was locked.","uzbek":"Eshikni qulflaganimni eslayman. Aniq qulflangan."},{"ingliz":"Try drinking a glass of warm milk. It might help you sleep.","uzbek":"Bir stakan iliq sut ichib ko'ring. Uxlashga yordam berishi mumkin."}],"xato":"O'zbekchada 'to'xtadi', 'esladi', 'urinib ko'rdi' ikkala ma'noda ham bir xil shaklda. Inglizchada shakl ma'noni o'zgartiradi. Xato: 'I stopped to smoke' ('chekishni tashladim' ma'nosida). To'g'risi: 'I stopped smoking'.","mashqlar":[{"savol":"He doesn't smoke now. He stopped ___ last year.","variantlar":["smoking","to smoke","smoked","smoke"],"togri":0,"izoh":"Tashlagan: stop + -ing."},{"savol":"I must remember ___ the letter. It's important.","variantlar":["post","to post","posting","to posting"],"togri":1,"izoh":"Hali bajarilmagan ishni unutmaslik: remember + to."},{"savol":"I remember ___ the door. I'm sure it was locked.","variantlar":["lock","locked","locking","to lock"],"togri":2,"izoh":"Bajarilgan ishni eslash: remember + -ing."},{"savol":"Why don't you try ___ a glass of warm milk (tajriba qilib ko'ring)? It might help you sleep.","variantlar":["to drink","drank","drink","drinking"],"togri":3,"izoh":"Sinab ko'rish: try + -ing."}]},{"raqam":39,"sarlavha":"Inversiya — Never have I ... / Not only ... but","daraja":"C1","tayyor":true,"qoida":"Inkor yoki cheklovchi so'z gap boshiga chiqsa, yordamchi fe'l egadan oldin keladi (savoldagi tartib).\nNever have I seen such a beautiful place.\nRarely do we see such honesty.\nNot only did he arrive late, but he also forgot the documents.\nNo sooner had she opened the door than the phone rang.\nHardly had he sat down when the lights went out.\nOnly after / Under no circumstances / Little did they know... ham shunday.\nYordamchi fe'l yo'q bo'lsa do / does / did qo'shiladi.","ogatish":"1) Gap boshiga Never / Rarely / Not only / No sooner qo'ying. 2) Keyin yordamchi fe'lni yozing (have, do, did, had). 3) Undan keyin ega, so'ng asosiy fe'l. Oddiy gap: I have never seen it → Never have I seen it.","misollar":[{"ingliz":"Never have I seen such a beautiful place.","uzbek":"Men hech qachon bunday go'zal joyni ko'rmaganman."},{"ingliz":"Not only did he arrive late, but he also forgot the documents.","uzbek":"U nafaqat kech keldi, balki hujjatlarni ham unutdi."},{"ingliz":"No sooner had she opened the door than the phone rang.","uzbek":"U eshikni ochishi bilan telefon jiringladi."},{"ingliz":"Rarely do we see such honesty in politics.","uzbek":"Siyosatda bunday halollikni juda kam ko'ramiz."}],"xato":"O'zbekchada so'z tartibi erkin va inkor so'z boshiga chiqsa ham tartib o'zgarmaydi. Inglizchada o'zgaradi. Xato: 'Never I have seen', 'Not only he arrived late'. To'g'risi: 'Never have I seen', 'Not only did he arrive late'. Bu asosan yozma va rasmiy nutqda ishlatiladi.","mashqlar":[{"savol":"Never ___ such a beautiful place.","variantlar":["have I seen","I saw","did I seen","I have seen"],"togri":0,"izoh":"Never gap boshida: have + ega + V3."},{"savol":"Not only ___ late, but he also forgot the documents.","variantlar":["he arrived","he did arrive","arrived he","did he arrive"],"togri":3,"izoh":"Not only gap boshida: did + ega + oddiy fe'l."},{"savol":"No sooner had she opened the door ___ the phone rang.","variantlar":["than","when","then","that"],"togri":0,"izoh":"No sooner ... than: no sooner had she opened ... than the phone rang."},{"savol":"Rarely ___ such honesty in politics.","variantlar":["we do see","do we see","we see","see we"],"togri":1,"izoh":"Rarely gap boshida: do + ega + oddiy fe'l."}]},{"raqam":40,"sarlavha":"Aralash shart gaplar — Mixed Conditionals","daraja":"C1","tayyor":true,"qoida":"Shartning zamoni va natijaning zamoni har xil bo'lsa, aralash shart gap bo'ladi.\n1) O'tmishdagi sabab → hozirgi natija: If + Past Perfect, would + fe'l.\nIf I had studied medicine, I would be a doctor now. (O'qimadim, shuning uchun hozir shifokor emasman.)\n2) Hozirgi holat → o'tmishdagi natija: If + Past Simple, would have + V3.\nIf I were more careful, I wouldn't have made that mistake yesterday.\nNow, today, yesterday kabi vaqt so'zlari yordam beradi.","ogatish":"Ikki savol bering: shart qachon (o'tmish yoki hozir)? Natija qachon (o'tmish yoki hozir)? Shart o'tmishda, natija hozirda → had V3 ... would V. Shart hozirda, natija o'tmishda → were / V2 ... would have V3.","misollar":[{"ingliz":"If I had studied medicine, I would be a doctor now.","uzbek":"Agar tibbiyotni o'qiganimda, hozir shifokor bo'lardim."},{"ingliz":"If she had taken the job in Dubai, she would live there now.","uzbek":"Agar u Dubaydagi ishni olganida, hozir o'sha yerda yashardi."},{"ingliz":"If I were more careful, I wouldn't have made that mistake.","uzbek":"Agar ehtiyotkorroq bo'lsam, o'sha xatoni qilmagan bo'lardim."},{"ingliz":"If he hadn't missed the train, he would be at work now.","uzbek":"Agar u poyezdga kech qolmaganida, hozir ishda bo'lardi."}],"xato":"O'zbekchada '-sa' va '-ardi' qo'shimchalari har xil vaqtni bir xilda ifodalaydi, shuning uchun aralash shartni sezmaymiz. Xato: 'If I had studied medicine, I would have been a doctor now' (now bilan would have been emas, would be). To'g'risi: 'I would be a doctor now'.","mashqlar":[{"savol":"If I had studied medicine, I ___ a doctor now.","variantlar":["was","would be","would have been","will be"],"togri":1,"izoh":"Shart o'tmishda, natija hozir: would be."},{"savol":"If she had taken the job in Dubai, she ___ there now.","variantlar":["would live","would have lived","lived","will live"],"togri":0,"izoh":"Natija hozirga tegishli: would live."},{"savol":"If I were more careful, I ___ that mistake yesterday.","variantlar":["wouldn't have made","won't make","didn't make","wouldn't make"],"togri":0,"izoh":"Natija o'tmishda: would not have + V3."},{"savol":"If he ___ the train, he would be at work now.","variantlar":["didn't miss","wouldn't miss","doesn't miss","hadn't missed"],"togri":3,"izoh":"Shart o'tmishda: had not + V3."}]},{"raqam": 41, "sarlavha": "Shartli gap: umumiy haqiqatlar — Zero Conditional", "daraja": "A2", "tayyor": true, "qoida": "Doimiy haqiqat yoki har doim sodir bo'ladigan natija haqida gapirganda ishlatiladi.\nIf + Present Simple, Present Simple.\n\n'Will' ishlatilmaydi.", "ogatish": "Avval savolni o'ylang: bu qoidami yoki bir martalik holatmi? Qoida bo'lsa, ikkala tomonda ham hozirgi oddiy zamon ishlatiladi.", "misollar": [{"ingliz": "If you heat water to 100°C, it boils.", "uzbek": "Suvni 100°C gacha qizdirsangiz, u qaynaydi."}, {"ingliz": "If I am tired, I go to bed early.", "uzbek": "Charchasam, erta yotaman."}, {"ingliz": "Plants die if they don't get water.", "uzbek": "O'simliklar suv olmasa, nobud bo'ladi."}, {"ingliz": "If it rains, the streets get wet.", "uzbek": "Yomg'ir yog'sa, ko'chalar ho'l bo'ladi."}], "xato": "Zero conditionalda 'will' ishlatilmaydi: 'If it will rain' emas, 'If it rains' to'g'ri.", "mashqlar": [{"savol": "If you mix red and blue, you ___ purple.", "variantlar": ["will get", "get", "got", "are getting"], "togri": 1, "izoh": "Umumiy haqiqat: if + present, present."}, {"savol": "Ice ___ when it is warm.", "variantlar": ["melts", "will melt", "melted", "is melting"], "togri": 0, "izoh": "Doimiy haqiqat — hozirgi oddiy zamon."}, {"savol": "If she is late, she always ___ sorry.", "variantlar": ["is", "will be", "was", "be"], "togri": 0, "izoh": "Har doim sodir bo'ladigan natija: 'is sorry' (present)."}, {"savol": "If the sun sets, it ___ dark.", "variantlar": ["gets", "will get", "got", "get"], "togri": 0, "izoh": "Tabiiy qonuniyat — 'gets' (present)."}]},{"raqam": 42, "sarlavha": "Zidlik: Although, Despite, However — ziddiyatli gaplar", "daraja": "B1", "tayyor": true, "qoida": "Although + gap (to'liq gap).\nDespite / In spite of + ot yoki -ing.\nDespite the fact that + gap.\nHowever, — gap boshida, vergul bilan.", "ogatish": "Ikki gap orasida qarama-qarshilik bo'lsa, ularni bog'lash uchun shu so'zlardan birini tanlang. Keyin qo'shimcha so'z tuzilishiga e'tibor bering: gap yoki ot.", "misollar": [{"ingliz": "Although it was raining, we went out.", "uzbek": "Yomg'ir yog'sa ham, biz chiqdik."}, {"ingliz": "Despite the rain, we went out.", "uzbek": "Yomg'irga qaramay, biz chiqdik."}, {"ingliz": "In spite of being tired, she finished the work.", "uzbek": "Charchagan bo'lsa ham, u ishni tugatdi."}, {"ingliz": "The plan was good. However, it was too expensive.", "uzbek": "Reja yaxshi edi. Biroq juda qimmat edi."}], "xato": "'Despite it was raining' — noto'g'ri. Despite dan keyin gap emas, ot yoki -ing keladi: 'Despite the rain' yoki 'Despite the fact that it was raining'.", "mashqlar": [{"savol": "___ the cold weather, they went swimming.", "variantlar": ["Although", "Despite", "However", "But"], "togri": 1, "izoh": "Despite + ot (the cold weather)."}, {"savol": "___ it was late, we continued talking.", "variantlar": ["Despite", "Although", "In spite", "However"], "togri": 1, "izoh": "Although + gap (it was late)."}, {"savol": "She was ill. ___, she went to work.", "variantlar": ["Although", "Despite", "However", "In spite"], "togri": 2, "izoh": "However, gap boshida, vergul bilan."}, {"savol": "___ of his experience, he didn't get the job.", "variantlar": ["Although", "Despite", "However", "Because"], "togri": 1, "izoh": "Despite / in spite of + ot — 'Despite of' emas, shunchaki 'Despite'."}]},{"raqam": 43, "sarlavha": "Maqsad va natija: to, so that, so ... that, such ... that", "daraja": "B1", "tayyor": true, "qoida": "Maqsad: to + fe'l (yoki in order to), so that + gap.\nNatija: so + sifat/ravish + that, such (a/an) + sifat + ot + that.", "ogatish": "'So' sifat yoki ravish oldida keladi. 'Such' esa ot bilan birga keladi. Keyin 'that' bilan natija gapi keladi.", "misollar": [{"ingliz": "I study hard to pass the exam.", "uzbek": "Imtihondan o'tish uchun ko'p o'qiyman."}, {"ingliz": "She saved money in order to buy a car.", "uzbek": "Mashina sotib olish uchun pul jamg'arib qo'ydi."}, {"ingliz": "He spoke slowly so that everyone could understand.", "uzbek": "Hamma tushunishi uchun u sekin gapirdi."}, {"ingliz": "It was such a beautiful day that we went to the park.", "uzbek": "Shunday go'zal kun ediki, biz bog'ga bordik."}], "xato": "'So a beautiful day' emas — 'such a beautiful day'. Ot bo'lsa 'such', sifat yoki ravish bo'lsa 'so' ishlatiladi.", "mashqlar": [{"savol": "I went to the library ___ borrow some books.", "variantlar": ["to", "for", "so", "that"], "togri": 0, "izoh": "Maqsad: to + fe'l."}, {"savol": "She was ___ tired that she fell asleep at once.", "variantlar": ["so", "such", "very", "too"], "togri": 0, "izoh": "'Tired' — sifat, shuning uchun 'so'."}, {"savol": "It was ___ a difficult question that nobody could answer.", "variantlar": ["so", "such", "too", "enough"], "togri": 1, "izoh": "'Question' — ot, shuning uchun 'such a'."}, {"savol": "We left early ___ we would not miss the bus.", "variantlar": ["so that", "so", "such", "in"], "togri": 0, "izoh": "Maqsad: so that + gap."}]},{"raqam": 44, "sarlavha": "Present Perfect yoki Past Simple?", "daraja": "B1", "tayyor": true, "qoida": "Past Simple — aniq o'tgan vaqt (yesterday, in 2019, last week).\nPresent Perfect — vaqt aytilmagan yoki hozirgi natija bilan bog'liq (already, yet, just, ever, never, for, since).", "ogatish": "Savol: vaqt aniq aytilganmi? Ha bo'lsa — Past Simple. Yo'q bo'lsa yoki hozirgi natija muhim bo'lsa — Present Perfect.", "misollar": [{"ingliz": "I have visited London twice.", "uzbek": "London'ga ikki marta borganman (qachon ekani aytilmagan)."}, {"ingliz": "I visited London in 2019.", "uzbek": "2019-yilda London'ga borganman (aniq yil)."}, {"ingliz": "She has lost her keys, so she can't open the door.", "uzbek": "Kalitini yo'qotgan, shuning uchun eshikni ocholmayapti."}, {"ingliz": "Have you finished yet?", "uzbek": "Hali tugatdingizmi?"}], "xato": "'I have seen him yesterday' — noto'g'ri. Aniq vaqt (yesterday) bilan Present Perfect ishlatilmaydi: 'I saw him yesterday'.", "mashqlar": [{"savol": "I ___ my homework yesterday.", "variantlar": ["have finished", "finished", "finish", "was finishing"], "togri": 1, "izoh": "'Yesterday' — aniq vaqt, Past Simple."}, {"savol": "___ you ever ___ sushi?", "variantlar": ["Did / eat", "Have / eaten", "Were / eat", "Do / eat"], "togri": 1, "izoh": "'Ever' — vaqt aytilmagan: Have + V3."}, {"savol": "They ___ to Samarkand last summer.", "variantlar": ["have been", "went", "have gone", "are going"], "togri": 1, "izoh": "'Last summer' — aniq vaqt, Past Simple."}, {"savol": "She ___ her keys, so she can't get in.", "variantlar": ["lost", "has lost", "loses", "was losing"], "togri": 1, "izoh": "Hozirgi natija (kalit yo'q) — Present Perfect."}]},{"raqam": 45, "sarlavha": "Afzallik ifodalash: prefer, would rather, had better", "daraja": "B2", "tayyor": true, "qoida": "would rather + fe'l (to'siz).\nhad better + fe'l (to'siz) — 'maslahat' ma'nosida.\nprefer + -ing yoki to + fe'l; 'prefer X to Y' — X ni Y dan afzal ko'raman.", "ogatish": "Eslab qoling: would rather va had better dan keyin 'to' qo'yilmaydi. Prefer dan keyin esa ikkala shakl ham bo'lishi mumkin.", "misollar": [{"ingliz": "I'd rather stay at home tonight.", "uzbek": "Bugun kechqurun uyda qolganim ma'qul."}, {"ingliz": "You had better take an umbrella.", "uzbek": "Soyabon olganing ma'qul (yomg'ir yog'ishi mumkin)."}, {"ingliz": "I prefer reading books to watching TV.", "uzbek": "Televizor ko'rishdan ko'ra kitob o'qishni afzal ko'raman."}, {"ingliz": "She prefers to travel by train.", "uzbek": "U poezdda sayohat qilishni afzal ko'radi."}], "xato": "'I'd rather to stay' va 'You had better to go' — noto'g'ri. 'To' qo'yilmaydi: 'I'd rather stay', 'You had better go'.", "mashqlar": [{"savol": "I'd rather ___ tea than coffee.", "variantlar": ["drink", "to drink", "drinking", "drank"], "togri": 0, "izoh": "would rather + fe'l (to'siz)."}, {"savol": "You'd better ___ now, or you'll be late.", "variantlar": ["leave", "to leave", "leaving", "left"], "togri": 0, "izoh": "had better + fe'l (to'siz)."}, {"savol": "We'd better ___ the meeting before it's too late.", "variantlar": ["cancel", "to cancel", "cancelling", "cancelled"], "togri": 0, "izoh": "had better + fe'l (to'siz)."}, {"savol": "I'd rather ___ at home than go out.", "variantlar": ["stay", "to stay", "staying", "stayed"], "togri": 0, "izoh": "would rather + fe'l (to'siz)."}]},{"raqam": 46, "sarlavha": "Bog'lovchi so'zlar: however, moreover, therefore, as a result", "daraja": "B2", "tayyor": true, "qoida": "Gap boshida, vergul bilan: However, / Moreover, / Therefore, / As a result, / Nevertheless,\nQarama-qarshilik: however, nevertheless.\nQo'shimcha: moreover, furthermore, in addition.\nNatija: therefore, as a result.", "ogatish": "Bu so'zlar ikki gap orasidagi munosabatni ko'rsatadi. Vergul yoki nuqta bilan ajratib yozing — shunchaki vergul bilan ikki mustaqil gapni bog'lash xato.", "misollar": [{"ingliz": "The test was difficult. However, most students passed.", "uzbek": "Test qiyin edi. Biroq ko'pchilik o'tdi."}, {"ingliz": "The price is high. Moreover, the quality is poor.", "uzbek": "Narx yuqori. Bundan tashqari, sifati past."}, {"ingliz": "It rained all day. As a result, the match was cancelled.", "uzbek": "Kun bo'yi yomg'ir yog'di. Natijada o'yin bekor qilindi."}, {"ingliz": "She studies every day; therefore, she has improved a lot.", "uzbek": "U har kuni o'qiydi, shuning uchun ancha yaxshilangan."}], "xato": "'It was late, however we left' — noto'g'ri (vergul bilan ikki mustaqil gapni bog'lash). To'g'risi: 'It was late. However, we left.'", "mashqlar": [{"savol": "The food was cheap. ___, it was very tasty.", "variantlar": ["Therefore", "Moreover", "Because", "Although"], "togri": 1, "izoh": "Qo'shimcha ma'lumot — moreover."}, {"savol": "The plan sounds good. ___, it is very expensive.", "variantlar": ["However", "Therefore", "Moreover", "Since"], "togri": 0, "izoh": "Qarama-qarshilik — however."}, {"savol": "It snowed heavily. ___, the roads were closed.", "variantlar": ["As a result", "However", "Despite", "Also"], "togri": 0, "izoh": "Natija — as a result."}, {"savol": "She studies every day; ___, she has improved a lot.", "variantlar": ["therefore", "although", "despite", "unless"], "togri": 0, "izoh": "Natija — therefore."}]},{"raqam": 47, "sarlavha": "Qo'shilish: So do I / Neither do I", "daraja": "A2", "tayyor": true, "qoida": "Ikkinchi odam ham shunday deganda:\nIjobiy: So + yordamchi fe'l + ega (So do I, So am I).\nSalbiy: Neither / Nor + yordamchi fe'l + ega (Neither do I, Nor can I).", "ogatish": "Birinchi gapdagi zamon va fe'lga qarang: yordamchi fe'l (do, am, can, have) ana shu fe'l bo'yicha tanlanadi. Ega har doim fe'ldan keyin keladi.", "misollar": [{"ingliz": "I love pizza. — So do I.", "uzbek": "Men ham pitsani yoqtiraman."}, {"ingliz": "I can't swim. — Neither can I.", "uzbek": "Men ham suzolmayman."}, {"ingliz": "I'm hungry. — So am I.", "uzbek": "Men ham ochman."}, {"ingliz": "I haven't seen the film. — Neither have I.", "uzbek": "Men ham filmni ko'rmaganman."}], "xato": "'So I do' yoki 'Neither I don't' noto'g'ri. Yordamchi fe'l ega oldida keladi: 'So do I', 'Neither have I'.", "mashqlar": [{"savol": "I love pizza. — So ___ I.", "variantlar": ["do", "am", "did", "have"], "togri": 0, "izoh": "Birinchi gap hozirgi oddiy zamon: do."}, {"savol": "I didn't finish the book. — Neither ___ I.", "variantlar": ["did", "do", "was", "am"], "togri": 0, "izoh": "O'tgan zamon salbiy: Neither did I."}, {"savol": "I'm hungry. — So ___ I.", "variantlar": ["am", "do", "is", "have"], "togri": 0, "izoh": "'I'm hungry' — am: So am I."}, {"savol": "We haven't seen the film. — Neither ___ we.", "variantlar": ["have", "had", "do", "are"], "togri": 0, "izoh": "Present Perfect salbiy: Neither have we."}]},{"raqam": 48, "sarlavha": "Used to, be used to, get used to", "daraja": "B1", "tayyor": true, "qoida": "used to + fe'l — o'tmishda odat bo'lgan, endi yo'q.\nbe used to + -ing / ot — ko'nikkanman, odatlanganman.\nget used to + -ing / ot — odatlanish jarayoni.", "ogatish": "Farqni shunday eslab qoling: 'used to' — o'tmish odati; 'be used to' — hozir ko'nikkanman. 'Get used to' — ko'nikib borish.", "misollar": [{"ingliz": "I used to live in Andijan.", "uzbek": "Men Andijonda yashardim (endi yashamayman)."}, {"ingliz": "I'm used to waking up early.", "uzbek": "Men erta uyg'onishga ko'nikkanman."}, {"ingliz": "It took me months to get used to the cold.", "uzbek": "Sovuqqa ko'nikish uchun menga bir necha oy kerak bo'ldi."}, {"ingliz": "She is used to working under pressure.", "uzbek": "U bosim ostida ishlashga odatlangan."}], "xato": "'I'm used to wake up' noto'g'ri — be used to dan keyin -ing: 'I'm used to waking up'. 'Use to' (s harfsiz) ham xato.", "mashqlar": [{"savol": "I ___ smoke, but I quit last year.", "variantlar": ["used to", "use to", "am used to", "get used"], "togri": 0, "izoh": "O'tmishdagi odat: used to + fe'l."}, {"savol": "It's hard for me, because I'm not ___ getting up early.", "variantlar": ["used to", "use to", "usually", "used"], "togri": 0, "izoh": "'Not used to' + -ing — odatlanmaganman."}, {"savol": "It took me a while to ___ the cold weather.", "variantlar": ["get used to", "used to", "be used", "use to"], "togri": 0, "izoh": "Jarayon: get used to + ot."}, {"savol": "When I was a child, I ___ play football every day.", "variantlar": ["used to", "am used to", "use to", "was used"], "togri": 0, "izoh": "Bolalikdagi odat: used to + fe'l."}]},{"raqam": 49, "sarlavha": "Need, needn't, don't have to, mustn't", "daraja": "B1", "tayyor": true, "qoida": "need — kerak (ot yoki to + fe'l).\ndon't have to / needn't — kerak emas (zarurat yo'q).\nmustn't — taqiqlanadi (man etilgan).", "ogatish": "Muhim farq: 'mustn't' — man etilgan. 'Don't have to' — majburiy emas. Ikkalasini aralashtirmang.", "misollar": [{"ingliz": "You don't have to come.", "uzbek": "Kelishing shart emas."}, {"ingliz": "You needn't pay now.", "uzbek": "Hozir to'lashingiz shart emas."}, {"ingliz": "You mustn't smoke here.", "uzbek": "Bu yerda chekish man etilgan."}, {"ingliz": "Do we need to bring anything?", "uzbek": "Biz nimadir olib kelishimiz kerakmi?"}], "xato": "'You mustn't come' — taqiq degani: kelmang. Kerak emas degani uchun 'don't have to' yoki 'needn't' ishlating.", "mashqlar": [{"savol": "You ___ pay now; you can pay tomorrow.", "variantlar": ["needn't", "mustn't", "can't", "shouldn't"], "togri": 0, "izoh": "Zarurat yo'q — needn't."}, {"savol": "Passengers ___ use phones in the cockpit.", "variantlar": ["mustn't", "don't have to", "needn't", "couldn't"], "togri": 0, "izoh": "Taqiq — mustn't."}, {"savol": "___ we need to bring our passports?", "variantlar": ["Do", "Are", "Have", "Be"], "togri": 0, "izoh": "Savol: Do we need to...?"}, {"savol": "You ___ to work tomorrow — it's a public holiday.", "variantlar": ["don't have", "mustn't", "can't", "won't"], "togri": 0, "izoh": "Dam olish kuni: majburiy emas — don't have to."}]},{"raqam": 50, "sarlavha": "Be supposed to, be allowed to, be able to", "daraja": "B1", "tayyor": true, "qoida": "be supposed to + fe'l — kutilgan, reja yoki qoida.\nbe allowed to + fe'l — ruxsat berilgan.\nbe able to + fe'l — qila olish (qobiliyat).", "ogatish": "Uchalasi ham 'can' o'rnida ishlatiladi, lekin ma'nosi boshqa. 'Supposed' — kutilgan qoida, 'allowed' — ruxsat, 'able' — imkoniyat.", "misollar": [{"ingliz": "We are supposed to meet at 8.", "uzbek": "Biz soat 8 da uchrashishimiz kerak (reja)."}, {"ingliz": "Students are not allowed to use phones.", "uzbek": "Talabalarga telefondan foydalanish ruxsat etilmagan."}, {"ingliz": "I'm able to play the piano.", "uzbek": "Men pianino chala olaman."}, {"ingliz": "You are not supposed to bring food here.", "uzbek": "Bu yerga ovqat olib kirish mumkin emas (qoida)."}], "xato": "'You are supposed wear' — noto'g'ri: 'supposed to wear'. Ruxsat uchun 'allowed to' ishlating: 'Students are allowed to...'.", "mashqlar": [{"savol": "We are ___ to meet at the station at 8.", "variantlar": ["supposed", "allowed", "able", "used"], "togri": 0, "izoh": "Reja — be supposed to."}, {"savol": "Children are ___ to enter the lab without permission.", "variantlar": ["not allowed", "not able", "not used", "not likely"], "togri": 0, "izoh": "Ruxsat yo'q — not allowed to."}, {"savol": "I'm ___ to play the piano — I learned it as a child.", "variantlar": ["able", "allowed", "supposed", "used"], "togri": 0, "izoh": "Qobiliyat — be able to."}, {"savol": "You are ___ to bring food here — it's against the rules.", "variantlar": ["not supposed", "not able", "not used", "not likely"], "togri": 0, "izoh": "Qoida — not supposed to."}]},{"raqam": 51, "sarlavha": "Each, every, all, both, either, neither", "daraja": "B1", "tayyor": true, "qoida": "each + sanalgan ot (har biri alohida).\nevery + sanalgan ot (har bir).\nall + ko'plik yoki sanalmaydigan ot (hammasi).\nboth — ikkalasi (ko'plik fe'l). Either / neither — ikkidan biri / hech biri (birlik fe'l).", "ogatish": "Fe'l shaklini tekshiring: each va every bilan birlik fe'l (has), both va all bilan ko'plik (have). Neither bilan birlik fe'l.", "misollar": [{"ingliz": "Each student has a book.", "uzbek": "Har bir talabada kitob bor."}, {"ingliz": "Every day counts.", "uzbek": "Har bir kun muhim."}, {"ingliz": "All the students passed.", "uzbek": "Barcha talabalar o'tdi."}, {"ingliz": "Both answers are correct.", "uzbek": "Ikkala javob ham to'g'ri."}], "xato": "'Each of the students have' — noto'g'ri, 'has' bo'lishi kerak. 'Both' bilan 'is' emas, 'are' ishlatiladi.", "mashqlar": [{"savol": "___ student received a certificate.", "variantlar": ["Each", "Both", "All", "Either"], "togri": 0, "izoh": "Har bir talaba — each + birlik ot."}, {"savol": "___ of the two options is perfect.", "variantlar": ["Neither", "Both", "All", "Every"], "togri": 0, "izoh": "Ikkalasidan hech biri — neither + birlik fe'l (is)."}, {"savol": "___ of my parents are teachers.", "variantlar": ["Both of", "Each of", "Neither of", "Every"], "togri": 0, "izoh": "Ikkalasi — both + ko'plik fe'l (are)."}, {"savol": "___ student has a locker here.", "variantlar": ["Every", "All", "Both", "Either"], "togri": 0, "izoh": "Har bir talaba — every + birlik fe'l (has)."}]},{"raqam": 52, "sarlavha": "Few / a few, little / a little", "daraja": "B1", "tayyor": true, "qoida": "few + sanaladigan ot — juda kam (salbiy ma'no).\na few + sanaladigan ot — bir necha (ijobiy).\nlittle + sanalmaydigan ot — juda kam (salbiy).\na little + sanalmaydigan ot — bir oz (ijobiy).", "ogatish": "Savol: ot sanaladimi? Sanalsa — few / a few. Sanalmasa — little / a little. Gap ijobiy yoki salbiy — 'a' bormi?", "misollar": [{"ingliz": "I have a few friends here.", "uzbek": "Bu yerda bir necha do'stim bor (yetarli)."}, {"ingliz": "I have few friends here.", "uzbek": "Bu yerda juda kam do'stim bor (afsus)."}, {"ingliz": "There is a little milk left.", "uzbek": "Sutdan bir oz qolgan."}, {"ingliz": "There is little time.", "uzbek": "Vaqt juda kam."}], "xato": "'A little people' yoki 'a little apples' — noto'g'ri. Sanaladigan otlar bilan 'a few', sanalmaydigan bilan 'a little'.", "mashqlar": [{"savol": "There are ___ students in the class, so the lesson is quiet.", "variantlar": ["few", "a few", "little", "a little"], "togri": 0, "izoh": "Salbiy ma'no, sanaladigan ot: few."}, {"savol": "Would you like ___ sugar in your tea?", "variantlar": ["a little", "few", "a few", "little"], "togri": 0, "izoh": "Sugar — sanalmaydigan, ijobiy: a little."}, {"savol": "I bought ___ apples; they are for the kids.", "variantlar": ["a few", "little", "few", "a little"], "togri": 0, "izoh": "Apples — sanaladigan, ijobiy: a few."}, {"savol": "We have ___ time before the train leaves.", "variantlar": ["little", "few", "a few", "fewer"], "togri": 0, "izoh": "Time — sanalmaydigan, salbiy: little."}]},{"raqam": 53, "sarlavha": "Unless, as long as, provided that, in case", "daraja": "B1", "tayyor": true, "qoida": "unless = agar ... bo'lmasa (ichida 'not' yo'q).\nas long as / provided that / so long as = faqat ... bo'lsa.\nin case = ... bo'lsa (ehtiyot uchun).", "ogatish": "Unless gapda 'not' ma'nosini beradi, shuning uchun unless dan keyin salbiy shakl yozilmaydi. 'As long as' — shart qo'yadi.", "misollar": [{"ingliz": "I'll be there at 7 unless the traffic is bad.", "uzbek": "Agar tirbandlik bo'lmasa, soat 7 da bo'laman."}, {"ingliz": "You can use my laptop as long as you don't damage it.", "uzbek": "Shikastlamasangiz, noutbukimdan foydalanishingiz mumkin."}, {"ingliz": "Take a jacket in case it gets cold.", "uzbek": "Sovuq bo'lib qolsa, kurtka oling."}, {"ingliz": "The concert will happen provided that the weather is fine.", "uzbek": "Ob-havo yaxshi bo'lsa, konsert bo'ladi."}], "xato": "'You won't pass unless you don't study' — noto'g'ri. Unless ichida 'not' bor: 'unless you study'.", "mashqlar": [{"savol": "I'll be there at 7, ___ the traffic is bad.", "variantlar": ["unless", "in case", "as long as", "provided"], "togri": 0, "izoh": "Agar tirbandlik bo'lmasa — unless."}, {"savol": "You can use my laptop ___ you return it.", "variantlar": ["as long as", "unless", "in case", "although"], "togri": 0, "izoh": "Faqat shart bo'lsa — as long as."}, {"savol": "Take a jacket ___ it gets cold later.", "variantlar": ["in case", "unless", "as long as", "provided"], "togri": 0, "izoh": "Ehtiyot uchun — in case."}, {"savol": "The concert will happen ___ the weather is fine.", "variantlar": ["provided that", "unless", "in case", "although"], "togri": 0, "izoh": "Shart: provided that."}]},{"raqam": 54, "sarlavha": "O'zlik olmoshlari: myself, yourself, themselves", "daraja": "B1", "tayyor": true, "qoida": "Gapning egasi va ob'ekti bir xil bo'lsa: I hurt myself.\nBy + o'zlik olmoshi = yolg'iz: I did it by myself.\nUrg'u uchun: I made it myself.", "ogatish": "Ingliz tilida gap ichida 'me', 'him' ... bilan qaytarish ko'pincha xato bo'ladi. O'zbekcha 'o'zim', 'o'zi' ma'nosiga mos keladi.", "misollar": [{"ingliz": "She taught herself to swim.", "uzbek": "U o'zi suzishni o'rgandi."}, {"ingliz": "Help yourself to some cake.", "uzbek": "Keling, o'zingizga tort oling."}, {"ingliz": "They enjoyed themselves at the party.", "uzbek": "Ular ziyofatda yaxshi vaqt o'tkazdilar."}, {"ingliz": "I did the whole project myself.", "uzbek": "Butun loyihani o'zim qildim."}], "xato": "'I hurt me' — noto'g'ri. Ega va ob'ekt bir xil bo'lsa 'myself' ishlatiladi: 'I hurt myself'.", "mashqlar": [{"savol": "She taught ___ to swim.", "variantlar": ["herself", "hers", "her", "she"], "togri": 0, "izoh": "Ega va ob'ekt bir xil — herself."}, {"savol": "I did the whole project ___.", "variantlar": ["myself", "me", "mine", "my"], "togri": 0, "izoh": "Urg'u uchun — myself."}, {"savol": "Please help ___ to some food.", "variantlar": ["yourself", "you", "your", "yours"], "togri": 0, "izoh": "Keling, o'zingizga — yourself."}, {"savol": "We cut ___ while cooking.", "variantlar": ["ourselves", "us", "our", "ours"], "togri": 0, "izoh": "Biz o'zimizni kestik — ourselves."}]},{"raqam": 55, "sarlavha": "Artikllar kengaytmasi: the yoki (yo'q)", "daraja": "B1", "tayyor": true, "qoida": "Umumiy ma'noda ko'plik yoki sanalmaydigan ot — artikl yo'q: Dogs are loyal. Water is essential.\nAniq, ma'lum narsa — the: The water in this lake is cold.\nYagona narsalar — the: the sun, the internet.\nEng ... — the: the best student.", "ogatish": "Savol: gap umumiy haqidami yoki aniq bir narsa haqida? Umumiy bo'lsa artikl kerak emas. Aniq bo'lsa the qo'yiladi.", "misollar": [{"ingliz": "Life is short.", "uzbek": "Hayot qisqa (umuman)."}, {"ingliz": "The life in the village is peaceful.", "uzbek": "Qishloqdagi hayot tinch (aniq joy)."}, {"ingliz": "I go to work by bus.", "uzbek": "Ishga avtobusda boraman (maqsad: ish)."}, {"ingliz": "She is the best student in our class.", "uzbek": "U sinfimizdagi eng yaxshi talaba."}], "xato": "'The life is beautiful' umumiy ma'noda noto'g'ri. To'g'risi: 'Life is beautiful.'", "mashqlar": [{"savol": "___ children need love and care.", "variantlar": ["(yo'q)", "The", "A", "An"], "togri": 0, "izoh": "Umumiy ma'no — artikl yo'q."}, {"savol": "___ sun rises in the east.", "variantlar": ["The", "(yo'q)", "A", "An"], "togri": 0, "izoh": "Yagona narsa — the sun."}, {"savol": "I always go to ___ by bus.", "variantlar": ["(yo'q)", "the", "a", "an"], "togri": 0, "izoh": "Maqsad: go to work — artikl yo'q."}, {"savol": "___ water in the lake is very clean.", "variantlar": ["The", "(yo'q)", "A", "An"], "togri": 0, "izoh": "Aniq ko'l — the water in the lake."}]},{"raqam": 56, "sarlavha": "Aniqlovchi va qo'shimcha gaplar: who, which, that", "daraja": "B1", "tayyor": true, "qoida": "Aniqlovchi (vergulsiz): The man who lives next door — 'that' ham mumkin.\nQo'shimcha (vergul bilan): My brother, who lives in London — faqat who/which/whose/where, 'that' emas.", "ogatish": "Vergul bor-yo'qligiga qarang. Vergul bo'lsa — gap qo'shimcha ma'lumot beradi, 'that' ishlatilmaydi.", "misollar": [{"ingliz": "My brother, who lives in London, is a doctor.", "uzbek": "Londonda yashaydigan akam shifokor (qo'shimcha)."}, {"ingliz": "The man who lives next door is a doctor.", "uzbek": "Qo'shnimizda yashaydigan odam shifokor (aniqlovchi)."}, {"ingliz": "The book that I bought is great.", "uzbek": "Men sotib olgan kitob ajoyib."}, {"ingliz": "Tashkent, which is very old, attracts many tourists.", "uzbek": "Juda qadimiy Toshkent ko'p sayyohlarni jalb qiladi."}], "xato": "'My brother, that lives in London' — noto'g'ri. Vergul bilan 'that' o'rniga 'who' yoki 'which' ishlating.", "mashqlar": [{"savol": "My sister, ___ lives in Paris, is a pilot.", "variantlar": ["who", "that", "what", "where"], "togri": 0, "izoh": "Vergul bilan — who (that emas)."}, {"savol": "The shop ___ sells fresh bread is near the station.", "variantlar": ["that", "who", "whose", "—"], "togri": 0, "izoh": "Aniqlovchi — 'that' yoki 'which' (vergulsiz). Shop uchun that."}, {"savol": "Tashkent, ___ is the capital of Uzbekistan, is very old.", "variantlar": ["which", "that", "who", "whom"], "togri": 0, "izoh": "Vergul bilan, joy uchun — which."}, {"savol": "The woman ___ car was stolen called the police.", "variantlar": ["whose", "who", "which", "where"], "togri": 0, "izoh": "Egalik — whose car."}]},{"raqam": 57, "sarlavha": "Savol shakllari: ega savoli va ob'ekt savoli", "daraja": "B1", "tayyor": true, "qoida": "Ega (subject) savoli — Who / What fe'l bilan to'g'ridan: Who called you? (did yo'q).\nOb'ekt savoli — yordamchi fe'l kerak: Who did you call? What did she say?", "ogatish": "Savolda 'who' yoki 'what' gapning egasimi? Ega bo'lsa — yordamchi fe'l (do/did) qo'shilmaydi.", "misollar": [{"ingliz": "Who wrote this letter?", "uzbek": "Bu xatni kim yozgan? (ega)"}, {"ingliz": "Who did you invite?", "uzbek": "Kimni taklif qildingiz? (ob'ekt)"}, {"ingliz": "What happened last night?", "uzbek": "Kecha kechqurun nima bo'ldi? (ega)"}, {"ingliz": "What did she say?", "uzbek": "U nima dedi? (ob'ekt)"}], "xato": "'Who did call you?' — noto'g'ri. Ega savolida 'did' kerak emas: 'Who called you?'", "mashqlar": [{"savol": "___ broke the window?", "variantlar": ["Who", "Whose", "Who did", "What"], "togri": 0, "izoh": "Ega savoli — Who broke...? (did yo'q)."}, {"savol": "___ did you meet at the party?", "variantlar": ["Who", "Who did", "What", "Where"], "togri": 0, "izoh": "Ob'ekt — Who did you meet? (ortiqcha did yo'q)."}, {"savol": "___ happened at the meeting?", "variantlar": ["What", "What did", "Who", "Which"], "togri": 0, "izoh": "Ega — What happened? (did yo'q)."}, {"savol": "___ is the new teacher?", "variantlar": ["Who", "Whom", "Whose", "Who did"], "togri": 0, "izoh": "Ega — Who is the new teacher?"}]},{"raqam": 58, "sarlavha": "Ko'chirma savol va buyruq", "daraja": "B1", "tayyor": true, "qoida": "Yes/No savoli: asked + if / whether + gap (so'z tartibi oddiy).\nWh- savol: asked + so'roq so'zi + gap.\nBuyruq: told / asked + kimga + to + fe'l. Inkor: not to.", "ogatish": "Ko'chirma gapda savol tartibi o'zgaradi: yordamchi fe'l olib tashlanadi, ega fe'ldan oldin keladi. Zamon ham bir pog'ona orqaga o'tadi.", "misollar": [{"ingliz": "She asked where I lived.", "uzbek": "U qayerda yashashimni so'radi."}, {"ingliz": "He asked if I was ready.", "uzbek": "U tayyor ekanimni so'radi."}, {"ingliz": "The teacher told us to open our books.", "uzbek": "O'qituvchi kitoblarni ochishimizni aytdi."}, {"ingliz": "My mum told me not to be late.", "uzbek": "Onam kechikmaslikni aytdi."}], "xato": "'She asked where do I live' — noto'g'ri. To'g'risi: 'She asked where I lived' (ega + fe'l, zamon o'zgaradi).", "mashqlar": [{"savol": "He asked me ___ I had finished.", "variantlar": ["if", "that", "what", "to"], "togri": 0, "izoh": "Yes/No savoli — if."}, {"savol": "The guide told us ___ quiet in the museum.", "variantlar": ["to be", "be", "being", "is"], "togri": 0, "izoh": "Buyruq — told us to be."}, {"savol": "They asked ___ the train had left.", "variantlar": ["whether", "that", "what", "how"], "togri": 0, "izoh": "Yes/No savoli — whether."}, {"savol": "I asked her ___ she lived.", "variantlar": ["where", "that", "if", "to"], "togri": 0, "izoh": "Joy haqida so'roq — where."}]},{"raqam": 59, "sarlavha": "Kelasi davomli va kelasi tugallangan zamon", "daraja": "B2", "tayyor": true, "qoida": "Future Continuous: will be + -ing — kelasi vaqtda davom etayotgan ish. 'This time tomorrow, I'll be flying.'\nFuture Perfect: will have + V3 — kelasi vaqtgacha tugallangan ish. 'By June, I will have finished.'", "ogatish": "Vaqt iborasiga qarang: 'at this time tomorrow' — continuous. 'By / by the time' — perfect.", "misollar": [{"ingliz": "This time tomorrow, I'll be flying to Istanbul.", "uzbek": "Ertaga shu vaqtda Istanbulga uchib ketayotgan bo'laman."}, {"ingliz": "By June, I will have finished the course.", "uzbek": "Iyungacha kursni tugatgan bo'laman."}, {"ingliz": "Don't call at 8 — I'll be having dinner.", "uzbek": "Soat 8 da qo'ng'iroq qilmang — ovqat yeyayotgan bo'laman."}, {"ingliz": "By the time you arrive, we will have eaten.", "uzbek": "Siz kelguningizcha biz ovqatlanib bo'lgan bo'lamiz."}], "xato": "'By June I will finish' — ko'pincha noto'g'ri, chunki 'by' bilan 'will have + V3' kerak.", "mashqlar": [{"savol": "This time next week, we ___ on the beach.", "variantlar": ["will be lying", "will have lain", "will lie", "lie"], "togri": 0, "izoh": "Shu vaqtda davom etayotgan ish — will be + -ing."}, {"savol": "By next year, she ___ her degree.", "variantlar": ["will have finished", "will be finishing", "finishes", "will finish"], "togri": 0, "izoh": "Kelasi yilgacha tugallangan — will have + V3."}, {"savol": "At 9 a.m. tomorrow, he ___ the exam.", "variantlar": ["will be taking", "will have taken", "takes", "will take"], "togri": 0, "izoh": "Ertalab soat 9 da davom etadi — will be taking."}, {"savol": "By the time we get there, the film ___ .", "variantlar": ["will have started", "will be starting", "starts", "will start"], "togri": 0, "izoh": "Yetib borguncha tugallangan — will have started."}]},{"raqam": 60, "sarlavha": "Modal perfect: should have, could have, might have", "daraja": "B2", "tayyor": true, "qoida": "should have + V3 — afsus bilan, ... qilishim kerak edi (lekin qilmadim).\ncould have + V3 — ... qilishim mumkin edi (lekin qilmadim).\nmight / may have + V3 — ... bo'lgan bo'lishi mumkin (taxmin o'tmish haqida).\nmust have + V3 — ... bo'lgan bo'lishi kerak (ishonchli taxmin).", "ogatish": "O'tmishdagi voqea bo'yicha afsus yoki taxmin bo'lsa, have + V3 ishlating. Fe'l 'should' bilan bo'lsa — afsus.", "misollar": [{"ingliz": "You should have called me.", "uzbek": "Menga qo'ng'iroq qilishing kerak edi (qilmading)."}, {"ingliz": "I could have won the race.", "uzbek": "Poygada g'olib bo'lishim mumkin edi."}, {"ingliz": "She might have forgotten the keys.", "uzbek": "U kalitni unutgan bo'lishi mumkin."}, {"ingliz": "He must have left early; his desk is empty.", "uzbek": "U erta ketgan bo'lishi kerak; stoli bo'sh."}], "xato": "'You should have to call' — noto'g'ri. To'g'risi: 'should have called'. 'Must have' ishonchli taxmin, 'might have' ehtimol.", "mashqlar": [{"savol": "I'm so tired. I ___ to bed earlier last night.", "variantlar": ["should have gone", "should go", "should have went", "should be going"], "togri": 0, "izoh": "Afsus, o'tmish — should have + V3 (gone)."}, {"savol": "The door is open. Someone ___ it without locking.", "variantlar": ["must have left", "must leave", "should leave", "had leave"], "togri": 0, "izoh": "Ishonchli taxmin o'tmish haqida — must have left."}, {"savol": "I'm not sure where Anna is. She ___ the wrong bus.", "variantlar": ["might have taken", "might take", "took", "must take"], "togri": 0, "izoh": "Ehtimol o'tmishda — might have taken."}, {"savol": "We ___ earlier, but we were late.", "variantlar": ["could have arrived", "could arrive", "arrived", "could arriving"], "togri": 0, "izoh": "Imkoniyat o'tmishda, bajarilmagan — could have arrived."}]},{"raqam": 61, "sarlavha": "Majhul nisbat: modallar bilan va Present Perfect Passive", "daraja": "B2", "tayyor": true, "qoida": "Modal + be + V3: The report must be finished by Friday.\nPresent Perfect Passive: has/have been + V3: The results have been announced.\nPast Simple Passive: was/were + V3.", "ogatish": "Majhul nisbatda ish qilgan odam muhim bo'lmasa, 'by' ishlatilmaydi. 'Be' modaldan keyin va V3 bilan keladi.", "misollar": [{"ingliz": "The report must be finished by Friday.", "uzbek": "Hisobot juma kunigacha tugatilishi kerak."}, {"ingliz": "The results have been announced.", "uzbek": "Natijalar e'lon qilindi."}, {"ingliz": "The bridge is being repaired now.", "uzbek": "Ko'prik hozir ta'mirlanmoqda."}, {"ingliz": "The letter should be sent today.", "uzbek": "Xat bugun jo'natilishi kerak."}], "xato": "'The report must finish' emas — 'must be finished'. Modaldan keyin 'be' va V3 kerak.", "mashqlar": [{"savol": "The package ___ delivered tomorrow.", "variantlar": ["will be", "will", "is will be", "has be"], "togri": 0, "izoh": "Kelasi zamon majhul — will be + V3."}, {"savol": "The new road ___ built since 2019.", "variantlar": ["has been", "was", "is", "have been"], "togri": 0, "izoh": "Since bilan Present Perfect Passive — has been."}, {"savol": "All documents must ___ signed by the manager.", "variantlar": ["be", "been", "being", "is"], "togri": 0, "izoh": "Modaldan keyin be + V3."}, {"savol": "The city ___ renovated; it looks new now.", "variantlar": ["has been", "was been", "is been", "had being"], "togri": 0, "izoh": "Natija hozir — has been + V3."}]},{"raqam": 62, "sarlavha": "Gerund (-ing) — ega va predlogdan keyin", "daraja": "B2", "tayyor": true, "qoida": "-ing shakl gapda ot vazifasida: Swimming is good for health (ega).\nPredlogdan keyin faqat -ing: I'm interested in learning English. Thanks for helping me.", "ogatish": "Predlogdan keyin to + fe'l ishlatilmaydi. 'Interested in' + -ing, 'good at' + -ing.", "misollar": [{"ingliz": "Swimming is good for your health.", "uzbek": "Suzish sog'liq uchun foydali."}, {"ingliz": "I'm interested in learning English.", "uzbek": "Men ingliz tilini o'rganishga qiziqaman."}, {"ingliz": "Thanks for helping me.", "uzbek": "Yordam berganingiz uchun rahmat."}, {"ingliz": "She is good at solving problems.", "uzbek": "U muammolarni yechishda yaxshi."}], "xato": "'I'm interested in to learn' — noto'g'ri. Predlogdan keyin -ing: 'in learning'.", "mashqlar": [{"savol": "___ early is a good habit.", "variantlar": ["Getting up", "To get up", "Get up", "Got up"], "togri": 0, "izoh": "Gapning egasi — gerund: getting up."}, {"savol": "She is good at ___ new languages.", "variantlar": ["learning", "to learn", "learn", "learned"], "togri": 0, "izoh": "Predlogdan keyin -ing: at learning."}, {"savol": "Thank you for ___ me.", "variantlar": ["helping", "to help", "help", "helped"], "togri": 0, "izoh": "For dan keyin -ing: for helping."}, {"savol": "They are excited about ___ abroad.", "variantlar": ["travelling", "to travel", "travel", "travelled"], "togri": 0, "izoh": "About dan keyin -ing: about travelling."}]},{"raqam": 63, "sarlavha": "Solishtirish: the more ... the more; as ... as", "daraja": "B2", "tayyor": true, "qoida": "the + comparative, the + comparative: The more you practise, the better you get.\nas + sifat/ravish + as: She is as tall as her brother.\nnot as ... as: It isn't as expensive as I thought.", "ogatish": "Ikki o'zgarish bir-biriga bog'liq bo'lsa — the ... the. Teng bo'lsa — as ... as.", "misollar": [{"ingliz": "The more you practise, the better you get.", "uzbek": "Qancha ko'p mashq qilsangiz, shuncha yaxshi bo'lasiz."}, {"ingliz": "The sooner, the better.", "uzbek": "Qanchalik tez bo'lsa, shunchalik yaxshi."}, {"ingliz": "She is as tall as her brother.", "uzbek": "U akasi kabi baland."}, {"ingliz": "It isn't as expensive as I thought.", "uzbek": "U men o'ylagancha qimmat emas."}], "xato": "'The more you practise, the more better' — noto'g'ri. Ikkinchi qismda ham comparative: 'the better'.", "mashqlar": [{"savol": "The more you read, ___ you understand.", "variantlar": ["the more", "more", "the most", "as"], "togri": 0, "izoh": "the + comparative, the + comparative."}, {"savol": "My house is ___ big ___ yours.", "variantlar": ["as / as", "so / that", "more / than", "such / as"], "togri": 0, "izoh": "Teng: as big as."}, {"savol": "The hotter it gets, ___ I feel.", "variantlar": ["the worse", "worse", "the worst", "more worse"], "togri": 0, "izoh": "the + comparative: the worse."}, {"savol": "This book is not ___ interesting ___ the first one.", "variantlar": ["as / as", "so / as", "more / as", "that / as"], "togri": 0, "izoh": "Salbiy teng: not as ... as."}]},{"raqam": 64, "sarlavha": "Participle iboralar: -ing va -ed", "daraja": "C1", "tayyor": true, "qoida": "-ing ibora (aktiv ma'no): Walking home, I met an old friend. (Uyga qaytayotib...)\n-ed ibora (majhul ma'no): Written in 1990, the book is famous. (1990-yilda yozilgan...)\nBu iboralar gapni qisqa va rasmiy qiladi.", "ogatish": "Ibora va asosiy gapning egasi bir xil bo'lishi kerak. 'Walking home, I met...' — men uyga qaytyapman, va men uchradim.", "misollar": [{"ingliz": "Walking home, I met an old friend.", "uzbek": "Uyga qaytayotib, eski do'stimni uchratdim."}, {"ingliz": "Written in 1990, the book is still popular.", "uzbek": "1990-yilda yozilgan kitob hali ham mashhur."}, {"ingliz": "Having finished the work, she went home.", "uzbek": "Ishni tugatib, u uyga ketdi."}, {"ingliz": "Tired after the trip, we went to bed early.", "uzbek": "Sayohatdan charchab, erta yotdik."}], "xato": "'Walking home, the rain started' — ega nomuvofiq (yomg'ir yuradimi?). Ibora egasi asosiy gap egasi bilan bir xil bo'lishi kerak.", "mashqlar": [{"savol": "___ the report, I sent it to the manager.", "variantlar": ["Having written", "Written", "To write", "Writing it"], "togri": 0, "izoh": "Bajarilgan ish — having + V3, ega 'I'."}, {"savol": "___ in a hurry, he forgot his keys.", "variantlar": ["Being", "Been", "Be", "To be"], "togri": 0, "izoh": "Ibora: being in a hurry — egasi 'he'."}, {"savol": "___ by the teacher, the students passed the test.", "variantlar": ["Prepared", "Preparing", "Prepare", "To prepare"], "togri": 0, "izoh": "Majhul ma'no — tayyorlangan: prepared."}, {"savol": "___ the bus, I realised I had lost my wallet.", "variantlar": ["Missing", "Missed", "Miss", "To miss"], "togri": 0, "izoh": "Aktiv: sog'indim (bus) — missing."}]},{"raqam": 65, "sarlavha": "Bo'lish gaplar (cleft sentences): It was ... that, What I need is", "daraja": "C1", "tayyor": true, "qoida": "It + be + urg'u qilinayotgan qism + that/who: It was Ali who called me. (Meni chaqirgan aynan Ali edi.)\nWhat + gap + be + qism: What I need is a holiday. (Menga kerak narsa — dam olish.)", "ogatish": "Urg'u berish uchun gapning bir qismini 'It is ... that' yoki 'What ... is' bilan ajratib ko'rsatiladi. Rasmiy va nutqda juda ko'p ishlatiladi.", "misollar": [{"ingliz": "It was Ali who called me.", "uzbek": "Meni aynan Ali chaqirdi."}, {"ingliz": "It was in Samarkand that we first met.", "uzbek": "Biz birinchi marta aynan Samarqandda uchrashdik."}, {"ingliz": "What I need is a holiday.", "uzbek": "Menga kerak narsa — dam olish."}, {"ingliz": "What surprised me was how quickly she learned.", "uzbek": "Meni hayratga solgan narsa — u qanchalik tez o'rganganligi edi."}], "xato": "'It was Ali that called' emas, odam uchun 'who' ham to'g'ri. Joy uchun 'where' yoki 'that' ishlatilishi mumkin.", "mashqlar": [{"savol": "It was my sister ___ helped me move.", "variantlar": ["who", "which", "what", "when"], "togri": 0, "izoh": "Odam — it was ... who."}, {"savol": "___ I want most is some peace and quiet.", "variantlar": ["What", "Which", "That", "Who"], "togri": 0, "izoh": "What I want most is ... (urg'u)."}, {"savol": "It was in 2020 ___ the company was founded.", "variantlar": ["that", "what", "who", "which"], "togri": 0, "izoh": "Vaqt uchun 'that' ishlatiladi."}, {"savol": "___ we really need is more time.", "variantlar": ["What", "Who", "Which", "Where"], "togri": 0, "izoh": "What we need is ... (urg'u)."}]},{"raqam": 66, "sarlavha": "Subjunctive: suggest / recommend / insist that + fe'l", "daraja": "C1", "tayyor": true, "qoida": "suggest, recommend, insist, demand, require + that + ega + fe'l (to'siz, shakl o'zgarmaydi): I suggest that he be careful.\nBritaniyada 'should' bilan ham ishlatiladi: I suggest that he should be careful.", "ogatish": "That dan keyin fe'l oddiy shakl (base form) bo'ladi: he go emas, he goes ham emas — he go. 'Is/are' o'rniga 'be'.", "misollar": [{"ingliz": "I suggest that he be careful.", "uzbek": "Men unga ehtiyot bo'lishni maslahat beraman."}, {"ingliz": "The doctor recommended that she rest for a week.", "uzbek": "Shifokor unga bir hafta dam olishni tavsiya qildi."}, {"ingliz": "They insisted that we stay for dinner.", "uzbek": "Ular kechki ovqatga qolishimizni talab qilishdi."}, {"ingliz": "It is essential that everyone arrive on time.", "uzbek": "Har kim vaqtida kelishi muhim."}], "xato": "'I suggest that he is careful' yoki 'he goes' — noto'g'ri. Shu fe'llardan keyin oddiy shakl: 'that he be'.", "mashqlar": [{"savol": "The teacher suggested that everyone ___ the book by Friday.", "variantlar": ["read", "reads", "reading", "will read"], "togri": 0, "izoh": "Suggest that + base form: read."}, {"savol": "They insisted that the meeting ___ postponed.", "variantlar": ["be", "is", "will be", "was"], "togri": 0, "izoh": "Insist that + be."}, {"savol": "I recommend that you ___ a doctor as soon as possible.", "variantlar": ["see", "sees", "will see", "seeing"], "togri": 0, "izoh": "Recommend that + base form: see."}, {"savol": "It is vital that he ___ the rules.", "variantlar": ["follow", "follows", "followed", "will follow"], "togri": 0, "izoh": "Vital/essential that + base form: follow."}]},{"raqam": 67, "sarlavha": "Ta'kidlash: do / does / did bilan", "daraja": "B2", "tayyor": true, "qoida": "Ta'kidlash uchun gapda do/does/did ishlatiladi: I do like this song. (Haqiqatan ham yoqadi.)\nBuyruq yoki iltimos bilan ham: Do come in!\nGapni ko'nikarli qiladi.", "ogatish": "Ta'kid faqat ijobiy gapda 'do' bilan beriladi. Fe'l o'zgarmaydi. Yozma nutqda kam, og'zaki nutqda ko'p.", "misollar": [{"ingliz": "I do like your new car.", "uzbek": "Yangi mashinangiz haqiqatan ham yoqadi."}, {"ingliz": "She does work hard, you know.", "uzbek": "U haqiqatan ko'p ishlaydi, bilasizmi."}, {"ingliz": "Do come in! We're waiting for you.", "uzbek": "Marhamat, kiring! Sizni kutyapmiz."}, {"ingliz": "He did finish the report on time.", "uzbek": "U hisobotni haqiqatan vaqtida tugatdi."}], "xato": "'I do likes' — noto'g'ri. 'Do' dan keyin fe'l oddiy shaklda: 'I do like'.", "mashqlar": [{"savol": "I ___ believe you, but it's hard to accept.", "variantlar": ["do", "am", "did", "will"], "togri": 0, "izoh": "Ta'kid — do believe."}, {"savol": "She ___ look tired today.", "variantlar": ["does", "is", "did", "has"], "togri": 0, "izoh": "Ta'kid — does look (ijobiy gap, hozirgi zamon)."}, {"savol": "He ___ apologise, but he didn't mean it.", "variantlar": ["did", "does", "do", "is"], "togri": 0, "izoh": "O'tgan zamon ta'kidi — did apologise."}, {"savol": "___ sit down; make yourself comfortable.", "variantlar": ["Do", "Does", "Did", "Are"], "togri": 0, "izoh": "Iltimos ta'kidi — Do sit down."}]},{"raqam": 68, "sarlavha": "Ravish o'rni: frequency, manner, certainty", "daraja": "B2", "tayyor": true, "qoida": "Chastota ravishlari (always, usually) — odatda fe'l oldida: I always check my email.\nTo be bilan — fe'ldan keyin: She is always late.\nTarz ravishi (quickly, carefully) — fe'ldan keyin: She speaks English fluently.\nIshonch (probably, definitely) — odatda fe'l oldida.", "ogatish": "Qoida: chastota va ishonch ravishlari fe'l oldida, 'to be' dan keyin. Tarz ravishi oxirida yoki fe'ldan keyin.", "misollar": [{"ingliz": "I always check my email.", "uzbek": "Men har doim pochtamni tekshiraman."}, {"ingliz": "She is always late on Mondays.", "uzbek": "U dushanbalarda har doim kechikadi."}, {"ingliz": "She speaks English fluently.", "uzbek": "U ingliz tilida ravon gaplashadi."}, {"ingliz": "He will probably call you tonight.", "uzbek": "U bugun kechqurun sizga qo'ng'iroq qiladi, ehtimol."}], "xato": "'I check always my email' — noto'g'ri. Chastota ravishi fe'l oldida: 'always check'.", "mashqlar": [{"savol": "We ___ go to the gym on Saturdays.", "variantlar": ["usually", "usual", "usual to", "are usually"], "togri": 0, "izoh": "Chastota — usually fe'l oldida."}, {"savol": "She ___ is ready on time.", "variantlar": ["is always", "always is", "is", "is alway"], "togri": 0, "izoh": "To be bilan: is always."}, {"savol": "He speaks Russian ___.", "variantlar": ["fluently", "fluent", "fluency", "more fluent"], "togri": 0, "izoh": "Tarz — fluently."}, {"savol": "They will ___ win the match.", "variantlar": ["definitely", "definite", "definitely be", "defined"], "togri": 0, "izoh": "Ishonch — definitely fe'l oldida."}]},{"raqam": 69, "sarlavha": "Inversiya kengaytmasi: Hardly / No sooner / Rarely / Only after", "daraja": "C1", "tayyor": true, "qoida": "Hardly ... when / No sooner ... than: Hardly had I arrived when it started to rain.\nRarely / Seldom + yordamchi fe'l + ega: Rarely do we see such talent.\nOnly after / Only then + inversiya: Only after the meeting did I understand.", "ogatish": "Bu so'zlar gap boshida kelganda, yordamchi fe'l egadan oldin keladi. Bu rasmiy va adabiy uslub uchun xos.", "misollar": [{"ingliz": "Hardly had I arrived when it started to rain.", "uzbek": "Men yetib kelishim bilanoq yomg'ir yog'a boshladi."}, {"ingliz": "No sooner had she left than the phone rang.", "uzbek": "U chiqib ketishi bilanoq telefon jiringladi."}, {"ingliz": "Rarely do we see such talent.", "uzbek": "Biz bunday iste'dodni kamdan-kam uchratamiz."}, {"ingliz": "Only after the meeting did I understand the plan.", "uzbek": "Faqat yig'ilishdan keyin rejani tushundim."}], "xato": "'Hardly I had arrived' — noto'g'ri. Inversiyada yordamchi fe'l egadan oldin: 'Hardly had I arrived'.", "mashqlar": [{"savol": "Hardly ___ the room when the lights went out.", "variantlar": ["had I entered", "I had entered", "I entered", "entered I"], "togri": 0, "izoh": "Hardly + had + ega + V3."}, {"savol": "Rarely ___ such a beautiful view.", "variantlar": ["have I seen", "I have seen", "I see", "did I see"], "togri": 0, "izoh": "Rarely + have + ega + V3."}, {"savol": "No sooner ___ home than he fell asleep.", "variantlar": ["had he got", "he had got", "he got", "got he"], "togri": 0, "izoh": "No sooner + had + ega + V3."}, {"savol": "Only after years of practice ___ she win.", "variantlar": ["did", "she did", "she would", "would she"], "togri": 0, "izoh": "Only after ... did + ega + fe'l (o'tmish)."}]},{"raqam": 70, "sarlavha": "Ehtiyotkor bayonot: seem to, tend to, is likely to", "daraja": "C1", "tayyor": true, "qoida": "Bayon uchun ehtiyotkor ifodalar: seem to / appear to + fe'l (ko'rinadi); tend to + fe'l (odat sifatida); be likely to / unlikely to (ehtimol).\nIt is likely that ... / It seems that ... — rasmiy yozuvda.", "ogatish": "Ingliz tilida bu yumshoq ifodalar ko'p ishlatiladi. Haddan tashqari qat'iy bo'lmaslik uchun ularni qo'llang.", "misollar": [{"ingliz": "She seems to know everything.", "uzbek": "U hamma narsani biladigandek ko'rinadi."}, {"ingliz": "People tend to forget names quickly.", "uzbek": "Odamlar ismlarni tez unutishga moyil."}, {"ingliz": "It is likely to rain this afternoon.", "uzbek": "Bugun tushda yomg'ir yog'ishi ehtimoli bor."}, {"ingliz": "The results appear to support our theory.", "uzbek": "Natijalar nazariyamizni qo'llab-quvvatlaganga o'xshaydi."}], "xato": "'She seems know' — noto'g'ri. 'Seem to' + fe'l: 'seems to know'. 'Tend to' ham xuddi shunday.", "mashqlar": [{"savol": "This method ___ to give better results.", "variantlar": ["seems", "seem", "is seeming", "seemed to be"], "togri": 0, "izoh": "Seem (uchinchi shaxs) + to + fe'l."}, {"savol": "He ___ to be late when he is nervous.", "variantlar": ["tends", "tend", "is tending", "tended not"], "togri": 0, "izoh": "Odat — tends to."}, {"savol": "It is ___ that the project will be delayed.", "variantlar": ["likely", "likeliness", "like", "probable of"], "togri": 0, "izoh": "It is likely that ... — ehtimol."}, {"savol": "The new policy appears ___ successful.", "variantlar": ["to be", "be", "being", "is to"], "togri": 0, "izoh": "Appear to be — ko'rinadi."}]}];

/* ================= GRAMMATIKA QUIZ BAZASI =================
   FILL:  [gap, to'g'ri javob, [noto'g'ri variantlar], izoh]
   TENSE: [gap, to'g'ri zamon]                                  */
const FILL_BANK = {
A1:[
["I ___ a student.","am",["is","are","be"],"I (men) bilan 'am' ishlatiladi."],
["She ___ my sister.","is",["am","are","be"],"She/He/It bilan 'is' ishlatiladi."],
["They ___ from Uzbekistan.","are",["is","am","be"],"We/You/They bilan 'are' ishlatiladi."],
["He ___ football every day.","plays",["play","playing","to play"],"He/She/It bilan Present Simple'da fe'lga -s qo'shiladi."],
["We ___ English every day.","study",["studies","studying","to study"],"We bilan fe'l oddiy shaklda keladi (-s yo'q)."],
["It is ___ umbrella.","an",["a","some","many"],"Unli tovush (u) bilan boshlangan so'z oldida 'an' ishlatiladi."],
["There ___ two books on the table.","are",["is","am","be"],"Ko'plik (two books) bilan 'There are' ishlatiladi."],
["My birthday is ___ May.","in",["on","at","to"],"Oylar oldidan 'in' ishlatiladi: in May."],
["Where ___ you live?","do",["does","are","is"],"You bilan savolda yordamchi fe'l 'do' bo'ladi."],
["___ is your name?","What",["Where","Who","When"],"Ism haqida so'raganda 'What' ishlatiladi."]
],
A2:[
["She ___ TV when I called.","was watching",["is watching","watches","will watch"],"O'tmishda davom etayotgan harakat: Past Continuous (was/were + -ing)."],
["I ___ to Samarkand last year.","went",["go","have gone","am going"],"'Last year' aniq o'tgan vaqt: Past Simple (go → went)."],
["He ___ his homework yet.","hasn't finished",["doesn't finish","isn't finishing","didn't finished"],"'Yet' bilan Present Perfect ishlatiladi: hasn't + 3-shakl."],
["If it rains tomorrow, we ___ at home.","will stay",["stayed","would stay","staying"],"Real kelajak sharti: If + Present, will + fe'l."],
["This bag is ___ than that one.","cheaper",["cheap","cheapest","more cheap"],"Qisqa sifat + -er + than: cheaper than."],
["You ___ smoke here. It is forbidden.","mustn't",["can","should","may"],"Taqiq ma'nosi: mustn't (mumkin emas)."],
["How ___ water do you drink a day?","much",["many","long","often"],"Sanalmaydigan ot (water) bilan 'much' ishlatiladi."],
["She is interested ___ music.","in",["on","at","for"],"'Interested in' — mustahkam birikma."],
["We ___ to the cinema tomorrow evening.","are going",["went","have gone","were going"],"Kelasi reja: am/is/are going to yoki Present Continuous."],
["There isn't ___ milk in the fridge.","any",["some","a","many"],"Inkor gapda sanalmaydigan ot bilan 'any' ishlatiladi."]
],
B1:[
["I ___ here since 2020.","have lived",["lived","live","am living"],"'Since' bilan Present Perfect ishlatiladi."],
["If I ___ rich, I would travel the world.","were",["am","will be","would be"],"Xayoliy shart (2-tur): If + Past (were), would + fe'l."],
["This house ___ in 1990.","was built",["built","is built","has built"],"Majhul nisbat, o'tgan zamon: was/were + 3-shakl."],
["I enjoy ___ to music.","listening",["to listen","listen","listened"],"'Enjoy' dan keyin fe'l + -ing keladi."],
["She decided ___ a new job.","to find",["finding","find","found"],"'Decide' dan keyin to + fe'l keladi."],
["You look ill. You ___ see a doctor.","should",["shouldn't","can't","won't"],"Tavsiya: should + fe'l."],
["The meeting was cancelled ___ the bad weather.","because of",["because","so","although"],"Ot (the bad weather) oldidan 'because of' ishlatiladi."],
["I have never ___ sushi.","eaten",["ate","eat","eating"],"Have never + 3-shakl (eat → ate → eaten)."],
["By the time we arrived, the film ___.","had started",["started","has started","was starting"],"Boshqa o'tgan harakatdan oldin tugagan: Past Perfect (had + 3-shakl)."],
["He is the ___ student in our class.","tallest",["taller","most tall","tall"],"Eng yuqori daraja: the + sifat + -est."]
],
B2:[
["If she had studied harder, she ___ the exam.","would have passed",["would pass","will pass","had passed"],"O'tmishdagi xayoliy shart (3-tur): If + Past Perfect, would have + 3-shakl."],
["I wish I ___ more free time.","had",["have","would have","has"],"Hozirgi afsus: wish + Past Simple."],
["The report ___ by the time you arrive tomorrow.","will have been completed",["will complete","is completed","would complete"],"Kelajakdagi ma'lum vaqtgacha tugash + majhul: will have been + 3-shakl."],
["Not only ___ late, but he also forgot the documents.","was he",["he was","did he","he is"],"'Not only' gap boshida kelsa, inversiya bo'ladi: was he."],
["She suggested ___ a taxi.","taking",["to take","take","took"],"'Suggest' dan keyin fe'l + -ing keladi."],
["He denied ___ the window.","breaking",["to break","break","broke"],"'Deny' dan keyin fe'l + -ing keladi."],
["I'd rather you ___ smoke in here.","didn't",["hadn't","haven't","aren't"],"'I'd rather you' dan keyin Past Simple ishlatiladi."],
["The manager, ___ office is on the third floor, is very kind.","whose",["who","which","whom"],"Egalik ma'nosi (uning ofisi): whose."],
["Hardly ___ arrived when it started to rain.","had we",["we had","did we","have we"],"'Hardly' gap boshida kelsa, inversiya: had we + 3-shakl."],
["She would rather ___ at home than go out.","stay",["to stay","staying","stayed"],"'Would rather' dan keyin to'siz infinitiv keladi."]
],
C1:[
["Had I known about the delay, I ___ earlier.","would have left",["would leave","had left","left"],"Inversiyali 3-tur shart: Had + subyekt + 3-shakl, would have + 3-shakl."],
["The proposal, ___ was widely criticised, was eventually withdrawn.","which",["what","who","whose"],"Vergul bilan ajratilgan qo'shimcha izoh gapda 'which' ishlatiladi."],
["Little ___ she know that the meeting had been cancelled.","did",["does","had","was"],"'Little' gap boshida kelsa, inversiya: did she know."],
["I'm not used to ___ up so early.","getting",["get","got","to get"],"'Be used to' dan keyin fe'l + -ing keladi."],
["The company is reluctant ___ any responsibility.","to accept",["accepting","accept","of accepting"],"'Reluctant' dan keyin to + fe'l keladi."],
["___ the heavy rain, the match went ahead.","Despite",["Although","Because","However"],"'Despite' dan keyin ot birikmasi keladi (the heavy rain)."],
["She is said ___ the richest woman in the country.","to be",["being","to being","be"],"'Is said' dan keyin to + fe'l keladi."],
["No sooner had he sat down ___ the phone rang.","than",["when","then","that"],"'No sooner ... than' — mustahkam birikma."]
]
};

const TENSE_BANK = {
A1:[
["I eat breakfast at 7 o'clock every day.","Present Simple"],
["She is reading a book now.","Present Continuous"],
["We watched a film yesterday.","Past Simple"],
["He plays tennis on Sundays.","Present Simple"],
["They are playing in the garden.","Present Continuous"],
["I will call you tomorrow.","Future Simple"]
],
A2:[
["At ten o'clock last night I was sleeping.","Past Continuous"],
["She has already finished her work.","Present Perfect"],
["We are going to visit my aunt next week.","Future (going to)"],
["They will arrive at 6 o'clock.","Future Simple"],
["He usually walks to work.","Present Simple"],
["I lived in Tashkent for two years.","Past Simple"]
],
B1:[
["I have been to London three times.","Present Perfect"],
["We had already left.","Past Perfect"],
["While I was cooking, she was setting the table.","Past Continuous"],
["He didn't come to the party.","Past Simple"],
["They have just arrived.","Present Perfect"],
["What are you doing right now?","Present Continuous"]
],
B2:[
["This time next week, I will be lying on a beach.","Future Continuous"],
["She has been learning English for three years.","Present Perfect Continuous"],
["They had been waiting for two hours.","Past Perfect Continuous"],
["By next June, I will have graduated.","Future Perfect"],
["I had never seen such a beautiful place before.","Past Perfect"],
["Look! It is snowing.","Present Continuous"]
],
C1:[
["By this time next year, they will have been living here for a decade.","Future Perfect Continuous"],
["I had been waiting for an hour before she finally showed up.","Past Perfect Continuous"],
["She will have finished the report by Friday.","Future Perfect"],
["He has been working on this project since January.","Present Perfect Continuous"]
]
};

const TENSE_BASIC=['Present Simple','Present Continuous','Past Simple','Past Continuous','Present Perfect','Future Simple'];
const TENSE_POOL = {
A1:['Present Simple','Present Continuous','Past Simple','Future Simple'],
A2:[...TENSE_BASIC,'Future (going to)'],
B1:[...TENSE_BASIC,'Past Perfect'],
B2:[...TENSE_BASIC,'Past Perfect','Present Perfect Continuous','Past Perfect Continuous','Future Continuous','Future Perfect'],
C1:[...TENSE_BASIC,'Past Perfect','Present Perfect Continuous','Past Perfect Continuous','Future Continuous','Future Perfect','Future Perfect Continuous']
};
const TENSE_IZOH = {
'Present Simple':"Doimiy yoki takrorlanuvchi harakat (every day, usually, on Sundays).",
'Present Continuous':"Hozir sodir bo'layotgan harakat: am/is/are + fe'l-ing.",
'Past Simple':"O'tgan zamonda tugallangan harakat (yesterday, last year, fe'l-ed).",
'Past Continuous':"O'tmishda ma'lum paytda davom etayotgan harakat: was/were + fe'l-ing.",
'Present Perfect':"Hozirga aloqador natija yoki tajriba: have/has + 3-shakl.",
'Future Simple':"Kelajakdagi harakat yoki qaror: will + fe'l.",
'Future (going to)':"Oldindan rejalashtirilgan kelajak: am/is/are going to + fe'l.",
'Past Perfect':"O'tmishdagi boshqa harakatdan oldin tugagan harakat: had + 3-shakl.",
'Present Perfect Continuous':"O'tmishda boshlanib hozirgacha davom etayotgan harakat: have/has been + fe'l-ing.",
'Past Perfect Continuous':"O'tmishdagi paytgacha davom etgan harakat: had been + fe'l-ing.",
'Future Continuous':"Kelajakda ma'lum paytda davom etayotgan harakat: will be + fe'l-ing.",
'Future Perfect':"Kelajakdagi ma'lum paytgacha tugaydigan harakat: will have + 3-shakl.",
'Future Perfect Continuous':"Kelajakdagi paytgacha davom etgan bo'ladigan harakat: will have been + fe'l-ing."
};




/* ================= HOLAT ================= */
let joriySozlikDaraja='A1';
let sozlikKorsatilgan=60;
const SOZLIK_QADAM=60;
let grammatikaOchiq=-1;
let grammatikaMashqJavoblandi={};
let testDaraja='A1';
let testSavollari=[];
let testIndeksi=0;
let testBall=0;
let testJavoblandi=false;
let kartochaDaraja='A1';
let kartochaRoyxat=[];
let kartochaIndeksi=0;
let kartochaBildim=0;
let kartochaAylangan=false;
let kartochaSessiyaSoni=0;

/* ================= SAQLASH TIZIMI (localStorage) + SRS + STREAK ================= */
const SAQLASH_KALITI='uzlearn_progress_v1';
const SRS_OYLIQ_KUN=[0,1,3,7,14,30]; // level 0..5 -> keyingi ko'rinishgacha necha kun
const DARAJA_TARTIBI=['A1','A2','B1','B2','C1'];
/* Grammatika: A1 dan C1 gacha tartib (raqam ID si o'zgarmaydi — taraqqiyot va bog'lanishlar shunga tayanadi) */
GRAMMATIKA_20.sort((a,b)=>DARAJA_TARTIBI.indexOf(a.daraja)-DARAJA_TARTIBI.indexOf(b.daraja)||a.raqam-b.raqam);
function grammatikaBul(raqam){ return GRAMMATIKA_20.find(g=>g.raqam===raqam); }
function grammatikaTartib(g){ return GRAMMATIKA_20.indexOf(g)+1; }
const OCHISH_CHEGARASI=70; // test natijasi shu foizdan yuqori bo'lsa, keyingi daraja ochiladi

function bugunSana(){
  const d=new Date();
  return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
}
function progressYuklash(){
  try{
    const xom=localStorage.getItem(SAQLASH_KALITI);
    if(xom){
      const p=JSON.parse(xom);
      if(typeof p.xp!=='number') p.xp=0;
      if(!Array.isArray(p.ochilgan)) p.ochilgan=['A1'];
      if(!p.zaif||typeof p.zaif!=='object') p.zaif={};
      if(!p.zaifGram||typeof p.zaifGram!=='object') p.zaifGram={};
      return p;
    }
  }catch(e){}
  return {streak:{joriy:0,eng_uzun:0,oxirgi_kun:null},sozlar:{},jami_takrorlash:0,xp:0,ochilgan:['A1'],zaif:{},zaifGram:{}};
}
function progressSaqlash(p){
  try{ localStorage.setItem(SAQLASH_KALITI, JSON.stringify(p)); }catch(e){}
}
let PROGRESS = progressYuklash();

function xpQoshish(son){
  PROGRESS.xp=(PROGRESS.xp||0)+son;
  progressSaqlash(PROGRESS);
  xpKorsatkichniYangilash();
}
/* Kunlik faollik: har kuni nechta savol, to'g'ri javob va XP */
function kunlikQayd(xp,savol,togri){
  if(!PROGRESS.kunlik||typeof PROGRESS.kunlik!=='object') PROGRESS.kunlik={};
  const k=bugunSana(), r=PROGRESS.kunlik[k]||{xp:0,savol:0,togri:0};
  r.xp+=xp||0; r.savol+=savol||0; r.togri+=togri||0;
  PROGRESS.kunlik[k]=r;
  progressSaqlash(PROGRESS);
}
function xpKorsatkichniYangilash(){
  const el=document.getElementById('xpYonPanel');
  if(el) el.textContent=`⭐ ${PROGRESS.xp} XP`;
  const n=document.getElementById('xpNav'); if(n) n.textContent=`⭐ ${PROGRESS.xp} XP`;
}
function darajaOchiqmi(d){ return PROGRESS.ochilgan.includes(d); }
function darajaniOchish(d){
  if(d && !PROGRESS.ochilgan.includes(d)){
    PROGRESS.ochilgan.push(d);
    progressSaqlash(PROGRESS);
    return true;
  }
  return false;
}
function keyingiDaraja(d){
  const idx=DARAJA_TARTIBI.indexOf(d);
  return idx>=0 && idx<DARAJA_TARTIBI.length-1 ? DARAJA_TARTIBI[idx+1] : null;
}

function streakYangilash(){
  const bugun = bugunSana();
  const s = PROGRESS.streak;
  if(s.oxirgi_kun===bugun) return; // bugun allaqachon hisoblangan
  const kecha = new Date(Date.now()-86400000);
  const kechaSana = `${kecha.getFullYear()}-${String(kecha.getMonth()+1).padStart(2,'0')}-${String(kecha.getDate()).padStart(2,'0')}`;
  if(s.oxirgi_kun===kechaSana){ s.joriy+=1; }
  else{ s.joriy=1; }
  if(s.joriy>s.eng_uzun) s.eng_uzun=s.joriy;
  s.oxirgi_kun=bugun;
  progressSaqlash(PROGRESS);
}

function sozKaliti(daraja,en){ return daraja+'::'+en; }
function sozHolati(daraja,en){
  const k=sozKaliti(daraja,en);
  return PROGRESS.sozlar[k] || {level:0, keyingi:0};
}
function sozYangilash(daraja,en,togri){
  const k=sozKaliti(daraja,en);
  let h = PROGRESS.sozlar[k] || {level:0, keyingi:0};
  if(togri){ h.level = Math.min(h.level+1, 5); }
  else{ h.level = 0; }
  const kunlar = SRS_OYLIQ_KUN[h.level];
  h.keyingi = Date.now() + kunlar*86400000;
  PROGRESS.sozlar[k]=h;
  PROGRESS.jami_takrorlash = (PROGRESS.jami_takrorlash||0)+1;
  progressSaqlash(PROGRESS);
}
function sozlarDueRoyxati(daraja){
  const pool = SOZLAR_DB[daraja];
  const hozir = Date.now();
  const due=[]; const yangi=[];
  pool.forEach(([en,uz])=>{
    const k=sozKaliti(daraja,en);
    const h = PROGRESS.sozlar[k];
    if(!h) yangi.push([en,uz]);
    else if(h.keyingi<=hozir) due.push([en,uz]);
  });
  return {due:aralashtir(due), yangi:aralashtir(yangi)};
}
let joriyMavzu=null;

function aralashtir(arr){
  const a=[...arr];
  for(let i=a.length-1;i>0;i--){
    const j=Math.floor(Math.random()*(i+1));
    [a[i],a[j]]=[a[j],a[i]];
  }
  return a;
}

/* ── BO'LIMLAR: 8 ta modul → 5 ta bo'lim (ichida tab) ── */
const BOLIMLAR={
  sozlik:{tugma:'g-sozlik',tab:[['sozlik',"📖 Lug'at"],['kartochkalar','🃏 Kartochka'],['morfologiya',"🧩 So'z yasalishi"],['_',"🔗 Bog'liq so'zlar"],['sinonim','🔁 Sinonim'],['omonim','🔀 Omonim'],['antonim','↔️ Antonim']]},
  grammatika:{tugma:'g-grammatika',tab:null},
  matnlar:{tugma:'g-matnlar',tab:[['matnlar',"📖 Matnlar"],['yozish',"✍️ Yozish"]]},
  oyinlar:{tugma:'g-oyinlar',tab:[['oyinlar',"🎮 O'yinlar"],['test','🎯 Test']]},
  taraqqiyot:{tugma:'g-taraqqiyot',tab:null}
};
const MOD_BOLIM={morfologiya:'sozlik',matnlar:'matnlar',yozish:'matnlar',sozlik:'sozlik',kartochkalar:'sozlik',sinonim:'sozlik',omonim:'sozlik',antonim:'sozlik',grammatika:'grammatika',oyinlar:'oyinlar',test:'oyinlar',taraqqiyot:'taraqqiyot'};
function bolimBelgila(mod){
  const b=MOD_BOLIM[mod]; if(!b) return;
  document.querySelectorAll('.modul-tugma').forEach(x=>x.classList.remove('faol'));
  const t=document.getElementById(BOLIMLAR[b].tugma); if(t) t.classList.add('faol');
  const joy=document.getElementById('ichki-tab-joy'); if(!joy) return;
  const tb=BOLIMLAR[b].tab;
  joy.innerHTML = tb ? '<div class="ichki-tab">'+tb.map(([m,n])=>m==='_' ? '<span class="ichki-ajratgich">'+n+'</span>' : '<button class="'+(m===mod?'faol':'')+'" onclick="modulAlmashtir(\''+m+'\')">'+n+'</button>').join('')+'</div>' : '';
}
function modulAlmashtir(mod){
  bolimBelgila(mod);
  try{ if(window.scrollTo) window.scrollTo(0,0); }catch(e){}
  if(mod==='sozlik') sozlikKo_rsatish();
  else if(mod==='grammatika') grammatikaKo_rsatish();
  else if(mod==='test') testYangiBoshlash();
  else if(mod==='kartochkalar') kartochaYangiBoshlash();
  else if(mod==='morfologiya'){ MORF_SAVOLLAR=[]; morfologiyaKo_rsatish(); }
  else if(mod==='sinonim') sinonimKo_rsatish();
  else if(mod==='omonim') omonimKo_rsatish();
  else if(mod==='antonim') antonimKo_rsatish();
  else if(mod==='taraqqiyot') taraqqiyotKo_rsatish();
  else if(mod==='oyinlar') oyinlarKo_rsatish();
  else if(mod==='matnlar'){ joriyMatnTab='matnlar'; matnlarKo_rsatish(); }
  else if(mod==='yozish'){ joriyMatnTab='yozish'; matnlarKo_rsatish(); }
}

/* ── TARAQQIYOT (PROGRESS) ── */
function taraqqiyotKo_rsatish(){
  const s = PROGRESS.streak;
  let mustahkam=0, jarayonda=0, jamiKorilgan=0;
  Object.values(PROGRESS.sozlar).forEach(h=>{
    jamiKorilgan++;
    if(h.level>=5) mustahkam++; else jarayonda++;
  });
  document.getElementById('kontent-joy').innerHTML=`
    <div class="sahifa-sarlavha"><h2>Taraqqiyot</h2><p>Sizning o'rganish statistikangiz — bu brauzeringizda saqlanadi</p></div>
    <div class="stat-grid">
      <div class="stat-karta olov"><div class="stat-raqam">🔥 ${s.joriy}</div><div class="stat-belgi">Joriy seriya (kun)</div></div>
      <div class="stat-karta"><div class="stat-raqam">⭐ ${PROGRESS.xp||0}</div><div class="stat-belgi">Jami XP</div></div>
      <div class="stat-karta"><div class="stat-raqam">${s.eng_uzun}</div><div class="stat-belgi">Eng uzun seriya</div></div>
      <div class="stat-karta"><div class="stat-raqam">${mustahkam}</div><div class="stat-belgi">Mustahkam o'rganilgan so'z</div></div>
      <div class="stat-karta"><div class="stat-raqam">${jarayonda}</div><div class="stat-belgi">Jarayondagi so'z</div></div>
      <div class="stat-karta"><div class="stat-raqam">${jamiKorilgan}</div><div class="stat-belgi">Ko'rib chiqilgan so'zlar</div></div>
    </div>
    ${(()=>{const zs=Object.keys(PROGRESS.zaif||{}).length,zg=Object.keys(PROGRESS.zaifGram||{}).length;return (zs||zg)?`<div class="srs-banner"><div><strong>♻️ Takrorlash kerak</strong><div style="font-size:12.5px;color:var(--kulrang);margin-top:4px;">${zs} ta so'z · ${zg} ta grammatika mavzusi</div></div><button class="test-keyingi" style="margin:0;" onclick="testRejim='xato';modulAlmashtir('test')">Boshlash</button></div>`:'';})()}
    <div class="sahifa-sarlavha"><h2 style="font-size:17px;">Daraja qulfi (Skill Tree)</h2><p>Testda ${OCHISH_CHEGARASI}%+ natija bilan keyingi daraja ochiladi</p></div>
    <div class="qator" style="margin-bottom:24px;">
      ${DARAJA_TARTIBI.map(d=>`<span class="belgi" style="${darajaOchiqmi(d)?'':'opacity:.4;'}">${darajaOchiqmi(d)?'🔓':'🔒'} ${d}</span>`).join('')}
    </div>
    <div class="sahifa-sarlavha"><h2 style="font-size:17px;">Daraja bo'yicha taraqqiyot</h2></div>
    <div class="daraja-progress-royxat">
      ${Object.keys(DARAJA_NOMLARI).map(d=>{
        const jami = SOZLAR_DB[d].length;
        const mustahkamD = SOZLAR_DB[d].filter(([en])=>{const h=PROGRESS.sozlar[sozKaliti(d,en)];return h&&h.level>=5;}).length;
        const foiz = Math.round(mustahkamD/jami*100);
        return `<div class="daraja-progress-qator">
          <div class="daraja-progress-bosh"><span>${DARAJA_NOMLARI[d]}</span><span class="daraja-progress-son">${mustahkamD}/${jami} (${foiz}%)</span></div>
          <div class="daraja-progress-chiziq"><div class="daraja-progress-tolgan" style="width:${foiz}%"></div></div>
        </div>`;
      }).join('')}
    </div>
    <div class="sahifa-sarlavha"><h2 style="font-size:17px;">Kunlik faollik</h2><p>Har bir kun, birinchi faol kundan boshlab tartib bilan</p></div>
    ${taraqqiyotKunlikHTML()}
    <div class="sahifa-sarlavha"><h2 style="font-size:17px;">To'liq o'rganilgan so'zlar</h2><p>Har bir so'z 5 marta ketma-ket to'g'ri javob berilganda shu yerga tushadi</p></div>
    ${taraqqiyotSozlarHTML()}
    <div class="sahifa-sarlavha"><h2 style="font-size:17px;">To'liq o'rganilgan grammatika</h2><p>Mavzudagi barcha mashqlarga to'g'ri javob berilganda</p></div>
    ${taraqqiyotGramHTML()}
    <div style="margin-top:24px;text-align:right;">
      <button class="reset-tugma" onclick="progressTozalash()">🗑 Statistikani tozalash</button>
    </div>`;
}
function taraqqiyotKunlikHTML(){
  const kun=PROGRESS.kunlik||{};
  const kunlar=Object.keys(kun).sort();
  if(!kunlar.length) return `<div class="srs-banner"><div style="font-size:13px;color:var(--kulrang);">Hali faollik yo'q. Birinchi test yoki mashqni boshlang.</div></div>`;
  return `<div class="daraja-progress-royxat">${kunlar.map((k,i)=>{
    const r=kun[k], foiz=r.savol?Math.round(r.togri/r.savol*100):0;
    return `<div class="daraja-progress-qator">
      <div class="daraja-progress-bosh"><span>${i+1}-kun · ${k}</span><span class="daraja-progress-son">⭐ ${r.xp} XP</span></div>
      <div style="font-size:12.5px;color:var(--kulrang);margin-top:4px;">${r.savol} ta savol · ${r.togri} ta to'g'ri${r.savol?` (${foiz}%)`:''}</div>
    </div>`;}).join('')}</div>`;
}
function taraqqiyotSozlarHTML(){
  const guruhlar=DARAJA_TARTIBI.map(d=>{
    const royxat=SOZLAR_DB[d].filter(([en])=>{const h=PROGRESS.sozlar[sozKaliti(d,en)];return h&&h.level>=5;});
    return {d,royxat};
  }).filter(g=>g.royxat.length);
  const jami=guruhlar.reduce((s,g)=>s+g.royxat.length,0);
  if(!jami) return `<div class="srs-banner"><div style="font-size:13px;color:var(--kulrang);">Hali to'liq o'rganilgan so'z yo'q.</div></div>`;
  return `<div style="font-size:13px;color:var(--kulrang);margin-bottom:10px;">Jami: <strong>${jami}</strong> ta so'z</div>`+
    guruhlar.map(g=>`<details class="taraqqiyot-details" style="margin-bottom:8px;">
      <summary>${DARAJA_NOMLARI[g.d]} · ${g.royxat.length} ta</summary>
      <div class="qator" style="gap:6px;margin-top:10px;">${g.royxat.map(([en,uz])=>`<span class="belgi">${en} — ${uz}</span>`).join('')}</div>
    </details>`).join('');
}
function taraqqiyotGramHTML(){
  const yechilgan=PROGRESS.gramYechilgan||{};
  const tayyorlar=GRAMMATIKA_20.filter(g=>g.tayyor && g.mashqlar.length && g.mashqlar.every((_,qi)=>yechilgan[g.raqam+'_'+qi]));
  if(!tayyorlar.length) return `<div class="srs-banner"><div style="font-size:13px;color:var(--kulrang);">Hali to'liq yakunlangan grammatika mavzusi yo'q.</div></div>`;
  return `<div style="font-size:13px;color:var(--kulrang);margin-bottom:10px;">${tayyorlar.length} / ${GRAMMATIKA_20.length} mavzu</div>
    <div class="qator" style="gap:6px;">${tayyorlar.map(g=>`<span class="belgi">✅ ${g.raqam}. ${g.sarlavha}</span>`).join('')}</div>`;
}
function progressTozalash(){
  if(!confirm("Rostdan ham barcha taraqqiyotni o'chirmoqchimisiz? Bu qaytarib bo'lmaydi.")) return;
  PROGRESS={streak:{joriy:0,eng_uzun:0,oxirgi_kun:null},sozlar:{},jami_takrorlash:0,xp:0,ochilgan:['A1'],zaif:{},zaifGram:{}};
  progressSaqlash(PROGRESS);
  taraqqiyotKo_rsatish();
}

