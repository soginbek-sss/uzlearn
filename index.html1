<!DOCTYPE html>
<html lang="uz">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
<title>UzLearn — Ingliz Tili Akademiyasi</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet"/>
<style>
:root{--asosiy:#0a1628;--asosiy2:#0f2044;--ko-k:#1a56db;--ko-k2:#2563eb;--osmon:#60a5fa;--oq:#f0f6ff;--kulrang:#4b6fa8;--chegara:#1a3460;--karta:#0d1f3c;--yashil:#10b981;--qizil:#ef4444;--sariq:#f59e0b;--radius:14px;box-sizing:border-box;}
*{box-sizing:border-box;margin:0;padding:0;}
body{background:var(--asosiy);color:var(--oq);font-family:'Inter',sans-serif;min-height:100vh;overflow-x:hidden;}
button{cursor:pointer;font-family:'Inter',sans-serif;border:none;outline:none;}
.nav{display:flex;align-items:center;justify-content:space-between;padding:16px 28px;border-bottom:1px solid var(--chegara);background:#070f1eee;backdrop-filter:blur(14px);position:sticky;top:0;z-index:100;}
.nav-brand{display:flex;align-items:center;gap:10px;}
.nav-logo{width:40px;height:40px;border-radius:11px;background:linear-gradient(135deg,var(--ko-k),#0d47a1);display:flex;align-items:center;justify-content:center;font-size:20px;box-shadow:0 0 20px #1a56db44;}
.nav-nomi{font-family:'Space Grotesk',sans-serif;font-size:20px;font-weight:700;}
.nav-tagline{font-size:11px;color:var(--kulrang);margin-top:1px;}
.nav-bayroq{font-size:22px;display:flex;align-items:center;gap:6px;}
.nav-bayroq span{font-size:13px;color:var(--kulrang);}
.asosiy-joy{display:flex;flex:1;min-height:calc(100vh - 73px);}
.yon-panel{width:245px;flex-shrink:0;border-right:1px solid var(--chegara);padding:22px 14px;background:#070f1e;display:flex;flex-direction:column;gap:4px;}
.yon-sarlavha{font-size:10px;letter-spacing:2.5px;color:var(--kulrang);font-weight:600;margin:8px 0 10px 10px;}
.modul-tugma{display:flex;align-items:center;gap:11px;padding:11px 13px;border-radius:10px;border:1px solid transparent;background:none;color:#8aadd4;font-size:13.5px;font-weight:500;transition:all .18s;width:100%;text-align:left;}
.modul-tugma:hover{background:var(--karta);color:var(--oq);border-color:var(--chegara);}
.modul-tugma.faol{background:linear-gradient(135deg,#1a3d8a,#0d2a6e);border-color:var(--ko-k);color:var(--oq);box-shadow:0 0 18px #1a56db2a;}
.modul-icon{font-size:17px;width:24px;text-align:center;}
.modul-nomi{font-size:13.5px;font-weight:600;}
.modul-tavsif{font-size:10.5px;color:var(--kulrang);margin-top:1px;}
.yon-ajratgich{height:1px;background:var(--chegara);margin:10px 0;}
.kichik-modul{opacity:.75;}
.kichik-modul .modul-icon{font-size:14px;}
.kichik-modul .modul-nomi{font-size:12px;}
.kontent{flex:1;padding:30px 34px;overflow-y:auto;max-height:calc(100vh - 73px);}
.sahifa-sarlavha{margin-bottom:22px;}
.sahifa-sarlavha h2{font-family:'Space Grotesk',sans-serif;font-size:24px;font-weight:700;}
.sahifa-sarlavha p{color:var(--kulrang);margin-top:6px;font-size:13.5px;line-height:1.6;}
.qator{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:14px;}
.belgi{display:inline-flex;align-items:center;gap:5px;padding:4px 11px;border-radius:20px;font-size:11px;font-weight:600;background:#0d2a5a;border:1px solid var(--chegara);color:var(--osmon);}
.jonli-belgi{background:#052e1d;border:1px solid var(--yashil);color:var(--yashil);font-size:11px;padding:3px 10px;border-radius:20px;font-weight:600;display:inline-flex;align-items:center;gap:5px;}
.jonli-dot{width:7px;height:7px;border-radius:50%;background:var(--yashil);animation:yilt 2s infinite;display:inline-block;}
@keyframes yilt{0%,100%{opacity:1}50%{opacity:.3}}
.daraja-filter{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:18px;}
.daraja-tugma{padding:7px 15px;border-radius:20px;border:1px solid var(--chegara);background:var(--asosiy2);color:var(--kulrang);font-size:12.5px;font-weight:600;transition:all .18s;}
.daraja-tugma.tanlangan{background:linear-gradient(135deg,#1a3d8a,#0d2a6e);border-color:var(--ko-k);color:var(--oq);box-shadow:0 0 14px #1a56db33;}
.chat-qobiq{display:flex;flex-direction:column;height:calc(100vh - 310px);min-height:380px;}
.chat-xabarlar{flex:1;overflow-y:auto;display:flex;flex-direction:column;gap:13px;padding-right:4px;padding-bottom:8px;}
.xabar{display:flex;align-items:flex-start;gap:9px;}
.xabar.foydalanuvchi{flex-direction:row-reverse;}
.xabar-avatar{width:34px;height:34px;border-radius:50%;background:linear-gradient(135deg,var(--ko-k),#0d47a1);display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0;box-shadow:0 0 12px #1a56db33;}
.xabar-matn{max-width:72%;padding:12px 16px;font-size:13.5px;line-height:1.8;border:1px solid var(--chegara);background:var(--karta);border-radius:4px 14px 14px 14px;}
.xabar.foydalanuvchi .xabar-matn{background:linear-gradient(135deg,var(--ko-k2),#1e40af);border-color:#3b82f6;border-radius:14px 4px 14px 14px;}
.yozish-qatori{display:flex;gap:10px;margin-top:14px;}
.matn-kiritish{flex:1;background:var(--karta);border:1px solid var(--chegara);border-radius:12px;padding:12px 16px;color:var(--oq);font-size:14px;font-family:'Inter',sans-serif;resize:none;outline:none;transition:border-color .2s;line-height:1.5;}
.matn-kiritish:focus{border-color:var(--ko-k);}
.yuborish-tugma{padding:12px 22px;background:linear-gradient(135deg,var(--ko-k),#1e40af);border-radius:12px;color:#fff;font-weight:600;font-size:14px;transition:opacity .2s;white-space:nowrap;}
.yuborish-tugma:disabled{opacity:.4;}
.yozmoqda{display:flex;gap:5px;align-items:center;padding:4px 0;}
.nuqta{width:7px;height:7px;border-radius:50%;background:var(--osmon);animation:sakra .9s infinite;}
.nuqta:nth-child(2){animation-delay:.15s;}
.nuqta:nth-child(3){animation-delay:.3s;}
@keyframes sakra{0%,100%{transform:translateY(0)}50%{transform:translateY(-6px)}}
.sozlik-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:12px;}
.sozlik-karta{background:var(--karta);border:1px solid var(--chegara);border-radius:var(--radius);padding:15px 15px 42px 15px;transition:all .22s;position:relative;overflow:hidden;}
.sozlik-karta:hover{border-color:var(--ko-k);transform:translateY(-3px);box-shadow:0 10px 28px #1a56db1a;}
.sozlik-karta .inglizcha{font-size:16.5px;font-weight:700;color:var(--oq);}
.sozlik-karta .uzbekcha{font-size:13px;color:var(--osmon);margin-top:5px;}
.sozlik-karta .daraja-belgi{position:absolute;top:9px;right:11px;font-size:9.5px;color:#fff;font-weight:700;background:var(--ko-k);padding:2px 7px;border-radius:8px;}
.sozlik-eshit{position:absolute;bottom:10px;right:11px;width:28px;height:28px;border-radius:50%;background:#0d2a5a;border:1px solid var(--chegara);color:var(--osmon);font-size:13px;display:flex;align-items:center;justify-content:center;transition:all .2s;}
.sozlik-eshit:hover{background:var(--ko-k);border-color:var(--ko-k);}
.sozlik-son{font-size:12.5px;color:var(--kulrang);margin-bottom:14px;}
.grammatika-royxat{display:flex;flex-direction:column;gap:12px;}
.grammatika-element{background:var(--karta);border:1px solid var(--chegara);border-radius:var(--radius);overflow:hidden;}
.grammatika-bosh{padding:15px 20px;cursor:pointer;display:flex;justify-content:space-between;align-items:center;font-weight:600;font-size:14px;transition:background .2s;gap:10px;}
.grammatika-bosh:hover{background:#122040;}
.unit-raqam{background:#0d2a5a;color:var(--osmon);font-size:11px;font-weight:700;padding:3px 9px;border-radius:8px;flex-shrink:0;}
.grammatika-tana{padding:0 20px;max-height:0;overflow:hidden;transition:max-height .4s ease,padding .25s;}
.grammatika-tana.ochiq{max-height:none;overflow:visible;padding:16px 20px;}
.qoida-blok{background:#071220;border-left:3px solid var(--ko-k);border-radius:0 8px 8px 0;padding:12px 16px;margin-bottom:12px;font-size:13.5px;line-height:1.8;color:#c8d8f8;}
.misol-qator{margin-bottom:9px;padding:10px 14px;background:#060e1a;border-radius:8px;}
.misol-ingliz{font-size:14px;color:var(--oq);font-weight:500;}
.misol-uzbek{font-size:13px;color:var(--osmon);margin-top:4px;}
.xato-ogohlantirish{background:#2a1505;border-left:3px solid var(--sariq);border-radius:0 8px 8px 0;padding:10px 14px;margin-top:10px;font-size:12.5px;color:#e8c98a;line-height:1.7;}
.test-karta{background:var(--karta);border:1px solid var(--chegara);border-radius:var(--radius);padding:26px;max-width:620px;}
.test-savol{font-size:17px;font-weight:600;margin-bottom:22px;line-height:1.55;}
.test-variantlar{display:flex;flex-direction:column;gap:10px;}
.test-variant{padding:13px 17px;border-radius:10px;border:1px solid var(--chegara);background:var(--asosiy2);color:var(--oq);font-size:13.5px;text-align:left;transition:all .2s;}
.test-variant:hover:not(:disabled){border-color:var(--ko-k);background:#122040;}
.test-variant.togri{border-color:var(--yashil);background:#052e1d;color:var(--yashil);}
.test-variant.noto-gri{border-color:var(--qizil);background:#2a0a0a;color:var(--qizil);}
.test-fikr{margin-top:16px;padding:13px 17px;border-radius:10px;font-size:13.5px;font-weight:500;}
.test-fikr.yaxshi{background:#052e1d;border:1px solid var(--yashil);color:var(--yashil);}
.test-fikr.yomon{background:#2a0a0a;border:1px solid var(--qizil);color:var(--qizil);}
.test-keyingi{margin-top:14px;padding:11px 26px;background:linear-gradient(135deg,var(--ko-k),#1e40af);border-radius:10px;color:#fff;font-weight:600;font-size:14px;}
.test-progress{display:flex;align-items:center;gap:12px;margin-bottom:20px;}
.progress-chiziq{flex:1;height:7px;background:var(--chegara);border-radius:10px;overflow:hidden;}
.progress-toʻlgan{height:100%;background:linear-gradient(90deg,var(--ko-k),var(--osmon));border-radius:10px;transition:width .4s;}
.test-ball{font-size:13px;color:var(--osmon);font-weight:600;}
.kartochka-qobiq{display:flex;flex-direction:column;align-items:center;gap:20px;}
.kartochka-ust{width:100%;max-width:480px;height:210px;perspective:1200px;cursor:pointer;}
.kartochka-ichki{width:100%;height:100%;position:relative;transition:transform .55s cubic-bezier(.4,2,.55,.44);transform-style:preserve-3d;}
.kartochka-ust.aylangan .kartochka-ichki{transform:rotateY(180deg);}
.kartochka-yuz{position:absolute;inset:0;border-radius:18px;border:1px solid var(--chegara);display:flex;flex-direction:column;align-items:center;justify-content:center;backface-visibility:hidden;padding:22px;}
.old-yuz{background:linear-gradient(160deg,#0d1f3c,#071220);}
.orqa-yuz{background:linear-gradient(160deg,#0a2a52,#071a38);transform:rotateY(180deg);}
.kartochka-soz{font-family:'Space Grotesk',sans-serif;font-size:30px;font-weight:700;}
.kartochka-maslahat{font-size:12px;color:var(--kulrang);margin-top:8px;}
.kartochka-tarjima{font-size:26px;color:var(--osmon);font-weight:600;}
.kartochka-tugmalar{display:flex;gap:12px;}
.k-tugma{padding:11px 26px;border-radius:10px;font-size:14px;font-weight:600;transition:all .2s;}
.k-tugma.bildim{background:#052e1d;border:1px solid var(--yashil);color:var(--yashil);}
.k-tugma.bildim:hover{background:#073d26;}
.k-tugma.otkazish{background:#0d1f3c;border:1px solid var(--chegara);color:var(--kulrang);}
.k-tugma.otkazish:hover{border-color:var(--ko-k);color:var(--oq);}
.k-tugma.aralashtir{background:#2a1a05;border:1px solid var(--sariq);color:var(--sariq);}
.kartochka-hisoblagich{font-size:13px;color:var(--kulrang);}
.stsenariy-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(155px,1fr));gap:11px;margin-bottom:26px;}
.stsenariy-karta{background:var(--karta);border:1px solid var(--chegara);border-radius:12px;padding:16px;cursor:pointer;text-align:center;transition:all .2s;}
.stsenariy-karta:hover,.stsenariy-karta.faol{border-color:var(--ko-k);background:#0d2a5a;}
.stsenariy-icon{font-size:28px;margin-bottom:7px;}
.stsenariy-nomi{font-size:13px;font-weight:600;}
.stsenariy-uz{font-size:11px;color:var(--kulrang);margin-top:3px;}
.chip{padding:9px 15px;border-radius:10px;border:1px solid var(--chegara);background:var(--asosiy2);color:var(--oq);font-size:14px;font-weight:500;transition:all .15s;}
.chip:hover:not(:disabled){border-color:var(--ko-k);background:#122040;}
.javob-joy{min-height:58px;border:1px dashed var(--chegara);border-radius:12px;padding:10px;display:flex;flex-wrap:wrap;gap:8px;margin-bottom:14px;align-items:center;}
.chip-qator{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:16px;}
.katta-ovoz{width:84px;height:84px;border-radius:50%;background:linear-gradient(135deg,var(--ko-k),#1e40af);color:#fff;font-size:34px;box-shadow:0 0 24px #1a56db55;}
.kichik-banner{background:#0d1f3c;border:1px solid var(--chegara);border-radius:10px;padding:10px 14px;font-size:12px;color:var(--kulrang);margin-bottom:18px;display:flex;align-items:center;gap:8px;}
.manba-eslatma{font-size:11.5px;color:var(--kulrang);margin-top:18px;padding:10px 14px;background:#071220;border-radius:8px;line-height:1.6;}
.stat-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:14px;margin-bottom:26px;}
.stat-karta{background:var(--karta);border:1px solid var(--chegara);border-radius:var(--radius);padding:20px;text-align:center;}
.stat-raqam{font-family:'Space Grotesk',sans-serif;font-size:32px;font-weight:700;color:var(--osmon);}
.stat-belgi{font-size:12px;color:var(--kulrang);margin-top:4px;}
.stat-karta.olov{background:linear-gradient(160deg,#3a1a05,#1a0d02);border-color:var(--sariq);}
.stat-karta.olov .stat-raqam{color:var(--sariq);}
.daraja-progress-royxat{display:flex;flex-direction:column;gap:10px;}
.daraja-progress-qator{background:var(--karta);border:1px solid var(--chegara);border-radius:12px;padding:14px 18px;}
.daraja-progress-bosh{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;font-size:13px;font-weight:600;}
.daraja-progress-son{font-size:12px;color:var(--kulrang);font-weight:500;}
.daraja-progress-chiziq{height:8px;background:var(--chegara);border-radius:10px;overflow:hidden;}
.daraja-progress-tolgan{height:100%;background:linear-gradient(90deg,var(--ko-k),var(--yashil));border-radius:10px;transition:width .4s;}
.srs-banner{display:flex;align-items:center;justify-content:space-between;background:linear-gradient(135deg,#0d2a5a,#0a1f42);border:1px solid var(--ko-k);border-radius:12px;padding:14px 20px;margin-bottom:20px;flex-wrap:wrap;gap:10px;}
.srs-banner-matn{font-size:13px;color:var(--osmon);font-weight:600;}
.srs-banner-son{font-size:22px;font-weight:800;color:#fff;}
.reset-tugma{background:none;border:1px solid var(--chegara);color:var(--kulrang);padding:8px 16px;border-radius:8px;font-size:12px;transition:all .2s;}
.reset-tugma:hover{border-color:var(--qizil);color:var(--qizil);}
.srs-daraja-belgi{font-size:9px;font-weight:700;padding:2px 8px;border-radius:8px;margin-left:8px;}
.srs-yangi{background:#0d2a5a;color:var(--osmon);}
.srs-takror{background:#2a1a05;color:var(--sariq);}
.srs-mustahkam{background:#052e1d;color:var(--yashil);}
.daraja-tugma.qulflangan{opacity:.4;cursor:not-allowed;position:relative;}
.daraja-tugma.qulflangan:hover{border-color:var(--chegara);}
.jon-qatori{display:flex;gap:6px;align-items:center;margin-bottom:16px;}
.jon{font-size:20px;transition:all .3s;}
.jon.ochirilgan{opacity:.25;filter:grayscale(1);transform:scale(.8);}
.xp-belgi{display:inline-flex;align-items:center;gap:4px;background:linear-gradient(135deg,#3a2a05,#1a0d02);border:1px solid var(--sariq);color:var(--sariq);font-size:12px;font-weight:700;padding:4px 12px;border-radius:20px;}
.xp-uchish{position:fixed;color:var(--sariq);font-weight:800;font-size:18px;pointer-events:none;z-index:999;animation:xpUch 1s ease-out forwards;}
@keyframes xpUch{0%{opacity:1;transform:translateY(0);}100%{opacity:0;transform:translateY(-50px);}}
.daraja-ochildi-modal{position:fixed;inset:0;background:#000000cc;display:flex;align-items:center;justify-content:center;z-index:1000;}
.daraja-ochildi-karta{background:linear-gradient(160deg,#0d2a5a,#071220);border:2px solid var(--sariq);border-radius:20px;padding:40px;text-align:center;max-width:380px;}
.jon-tugadi-karta{text-align:center;padding:50px 30px;}
::-webkit-scrollbar{width:5px;}
::-webkit-scrollbar-track{background:transparent;}
::-webkit-scrollbar-thumb{background:#1a3460;border-radius:4px;}
.nav-xp{display:none;}
@media (max-width:768px){
  .nav{padding:10px 14px;}
  .nav-tagline{display:none;}
  .nav-nomi{font-size:18px;}
  .nav-logo{width:34px;height:34px;font-size:17px;}
  .nav-xp{display:inline-flex;}
  .nav-bayroq{font-size:18px;gap:8px;}
  .asosiy-joy{flex-direction:column;min-height:0;}
  .yon-panel{position:fixed;bottom:0;left:0;right:0;width:100%;z-index:90;flex-direction:row;gap:2px;padding:6px 6px calc(6px + env(safe-area-inset-bottom,0px));border-right:none;border-top:1px solid var(--chegara);overflow:hidden;background:#070f1ef5;backdrop-filter:blur(12px);}
  .yon-panel > div{display:none;}
  .modul-tugma{flex-direction:column;gap:2px;width:auto;min-width:0;flex:1 1 0;padding:7px 4px;text-align:center;justify-content:center;}
  .modul-tugma .modul-tavsif{display:none;}
  .modul-icon{font-size:20px;width:auto;}
  .modul-nomi{font-size:10.5px;white-space:nowrap;}
  .kichik-modul{opacity:1;}
  .kichik-modul .modul-icon{font-size:20px;}
  .kichik-modul .modul-nomi{font-size:10.5px;}
  .kontent{padding:18px 14px 96px;max-height:none;overflow:visible;}
  .sahifa-sarlavha h2{font-size:20px;}
  .sozlik-grid{grid-template-columns:repeat(auto-fill,minmax(145px,1fr));gap:10px;}
  .stat-grid{grid-template-columns:repeat(auto-fit,minmax(130px,1fr));}
  .stsenariy-grid{grid-template-columns:repeat(auto-fill,minmax(140px,1fr));}
  .test-karta{padding:18px;}
  .test-savol{font-size:16px;}
  .xabar-matn{max-width:88%;}
  .chat-qobiq{height:calc(100vh - 360px) !important;min-height:300px;}
  .kartochka-ust{height:180px;}
  .kartochka-soz{font-size:24px;}
  .kartochka-tugmalar{flex-wrap:wrap;justify-content:center;}
  .grammatika-bosh{padding:13px 14px;font-size:13.5px;flex-wrap:wrap;}
  .grammatika-tana.ochiq{padding:14px;}
  .daraja-tugma{padding:6px 12px;font-size:12px;}
}
.test-teg{display:inline-block;font-size:12px;color:var(--osmon);background:#0b1a33;border:1px solid var(--chegara);border-radius:8px;padding:6px 10px;margin-bottom:12px;line-height:1.5;}
.qoida-eslatma{margin-top:12px;background:#071220;border:1px solid var(--chegara);border-left:3px solid var(--ko-k);border-radius:8px;padding:10px 14px;font-size:13px;line-height:1.75;color:#c8d8f8;}
.qoida-eslatma summary{cursor:pointer;font-weight:600;color:var(--osmon);min-height:28px;}
.test-variant.tanlangan-katak{border-color:var(--sariq);background:#2a2208;}
.test-variant.noto-gri{border-color:var(--qizil);background:#2a0a0a;color:var(--qizil);}
.rejim-guruh{margin-bottom:12px;}
.taraqqiyot-details{background:var(--karta);border:1px solid var(--chegara);border-radius:12px;padding:12px 14px;}
.taraqqiyot-details summary{cursor:pointer;font-weight:700;font-size:14px;min-height:32px;}
.rejim-sarlavha{font-size:12px;color:var(--kulrang);font-weight:700;letter-spacing:.02em;margin:0 0 6px;}
.rejim-qator{flex-wrap:wrap;gap:6px;}
.rejim-qator .daraja-tugma{flex:0 0 auto;white-space:nowrap;}
.ichki-tab{display:flex;flex-wrap:wrap;gap:6px;padding:4px;background:#071220;border:1px solid var(--chegara);border-radius:14px;margin-bottom:18px;max-width:100%;}
.ichki-tab .ichki-ajratgich{flex:0 0 100%;font-size:11px;font-weight:700;color:var(--kulrang);letter-spacing:.04em;padding:6px 10px 0;}
.ichki-tab button{flex:0 0 auto;min-height:44px;padding:8px 12px;border:0;border-radius:10px;background:none;color:#8aadd4;font-family:inherit;font-size:13px;font-weight:600;cursor:pointer;transition:all .18s;white-space:nowrap;}
.ichki-tab button:hover{color:var(--oq);background:var(--karta);}
.ichki-tab button.faol{background:linear-gradient(135deg,#1a3d8a,#0d2a6e);color:var(--oq);box-shadow:0 0 14px #1a56db2a;}
.ovoz-tugma{background:var(--karta);border:1px solid var(--chegara);border-radius:12px;width:44px;font-size:18px;flex-shrink:0;}
.ovoz-tugma:hover{border-color:var(--ko-k);}
</style>
</head>
<body>
<nav class="nav">
  <div class="nav-brand">
    <div class="nav-logo">📚</div>
    <div><div class="nav-nomi">UzLearn</div><div class="nav-tagline">Ingliz Tili Akademiyasi</div></div>
  </div>
  <span class="xp-belgi nav-xp" id="xpNav">⭐ 0 XP</span>
  <div class="nav-bayroq">🇺🇿 <span>↔</span> 🇬🇧</div>
</nav>
<div class="asosiy-joy">
<aside class="yon-panel">
  <div class="yon-sarlavha">BO'LIMLAR</div>
  <button class="modul-tugma faol" id="g-sozlik" onclick="modulAlmashtir('sozlik')">
    <span class="modul-icon">📖</span>
    <div><div class="modul-nomi">So'zlik</div><div class="modul-tavsif" id="sozSoni">So'zlar va kartochkalar</div></div>
  </button>
  <div style="padding:0 10px 6px;"><span class="xp-belgi" id="xpYonPanel">⭐ 0 XP</span></div>
  <button class="modul-tugma" id="g-grammatika" onclick="modulAlmashtir('grammatika')">
    <span class="modul-icon">✏️</span>
    <div><div class="modul-nomi">Grammatika</div><div class="modul-tavsif">40 mavzu + mashqlar</div></div>
  </button>
  <button class="modul-tugma" id="g-matnlar" onclick="modulAlmashtir('matnlar')">
    <span class="modul-icon">📰</span>
    <div><div class="modul-nomi">Matnlar</div><div class="modul-tavsif">O'qish va yozish</div></div>
  </button>
  <button class="modul-tugma" id="g-oyinlar" onclick="modulAlmashtir('oyinlar')">
    <span class="modul-icon">🎮</span>
    <div><div class="modul-nomi">O'yin</div><div class="modul-tavsif">O'yinlar va testlar</div></div>
  </button>
  <button class="modul-tugma" id="g-taraqqiyot" onclick="modulAlmashtir('taraqqiyot')">
    <span class="modul-icon">📊</span>
    <div><div class="modul-nomi">Taraqqiyot</div><div class="modul-tavsif" id="streakYonPanel">Kunlik natija</div></div>
  </button>
</aside>
<main class="kontent"><div id="ichki-tab-joy"></div><div id="kontent-joy"></div></main>
</div>

